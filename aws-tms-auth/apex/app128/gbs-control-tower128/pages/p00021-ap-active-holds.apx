        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: AP Holds
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 1000
            }

            displayColumn AMOUNT_PAID (
                sequence: 14
            )

            displayColumn CURRENCY_CODE (
                sequence: 12
            )

            displayColumn GL_DATE (
                sequence: 11
            )

            displayColumn HOLD_AGE_DAYS (
                sequence: 20
            )

            displayColumn HOLD_CODE (
                sequence: 17
            )

            displayColumn HOLD_DATE (
                sequence: 19
            )

            displayColumn HOLD_REASON (
                sequence: 18
            )

            displayColumn INVOICE_AMOUNT (
                sequence: 13
            )

            displayColumn INVOICE_DATE (
                sequence: 10
            )

            displayColumn INVOICE_ID (
                sequence: 5
            )

            displayColumn INVOICE_NUM (
                sequence: 6
            )

            displayColumn LEDGER_ID (
                sequence: 1
            )

            displayColumn LEDGER_NAME (
                sequence: 2
            )

