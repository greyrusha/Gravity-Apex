    region breadcrumb (
        name: AP Active Holds - Current
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filters (
        name: Filters
        title: Current State
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="t-Alert t-Alert--info t-Alert--horizontal">
                  <div class="t-Alert-wrap">
                    <div class="t-Alert-icon">
                      <span class="t-Icon fa fa-info-circle" aria-hidden="true"></span>
                    </div>
                    <div class="t-Alert-content">
                      This report shows current active holds on unpaid, non-cancelled AP
                      invoices. It is not a historical period-end snapshot.
                    </div>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P21_DB_LINK (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @filters
            slot: regionBody
        }
        default {
            type: static
            staticValue: ADG
        }
    )

    button back-to-dashboard (
        buttonName: BACK_TO_DASHBOARD
        label: Close
        layout {
            sequence: 20
            region: @filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-arrow-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh-gl (
        buttonName: REFRESH_HOLDS
        label: Refresh
        layout {
            sequence: 20
            region: @filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @refresh-gl
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ap-holds
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction return-to-dashboard (
        name: Return to Dashboard
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @back-to-dashboard
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.close();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

