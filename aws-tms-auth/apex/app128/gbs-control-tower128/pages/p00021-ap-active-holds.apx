page 21 (
    name: AP Active Holds - Current
    alias: AP-ACTIVE-HOLDS
    title: AP Active Holds - Current
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @tms-application-access
    }

    region ap-holds (
        name: AP Active Holds
        title: AP Holds
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT h.ledger_id,
                       h.ledger_name,
                       h.org_id,
                       h.operating_unit,
                       h.invoice_id,
                       h.invoice_num,
                       h.supplier_number,
                       h.supplier_name,
                       h.supplier_site,
                       h.invoice_date,
                       h.gl_date,
                       h.currency_code,
                       h.invoice_amount,
                       h.amount_paid,
                       h.outstanding_amount,
                       h.payment_status_flag,
                       h.hold_code,
                       h.hold_reason,
                       h.hold_date,
                       h.hold_age_days,
                       h.refresh_timestamp
                FROM TABLE(xxme_ap_holds_pkg.get_holds(:P21_DB_LINK)) h
                ```
            pageItemsToSubmit: P21_DB_LINK
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
            displayPosition: topAndBottomRight
            maxRowsToDisplay: 1000
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound:
                ```
                <div class="t-Alert t-Alert--success t-Alert--horizontal">
                  <div class="t-Alert-wrap">
                    <div class="t-Alert-icon">
                      <span class="t-Icon fa fa-check-circle" aria-hidden="true"></span>
                    </div>
                    <div class="t-Alert-content">
                      <div class="t-Alert-header">
                        <h2 class="t-Alert-title">No active AP holds found</h2>
                      </div>
                      <div class="t-Alert-body">
                        No active holds were found on unpaid, non-cancelled invoices within
                        the approved ledger scope.
                      </div>
                    </div>
                  </div>
                </div>
                ```
        }
        advanced {
            savedReportMappingIdentifier: 16480636946961733
        }

        column AMOUNT_PAID (
            type: plainText
            heading {
                heading: Amount Paid
                alignment: end
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: N
            }
        )

        column CURRENCY_CODE (
            type: plainText
            heading {
                heading: Currency Code
            }
            layout {
