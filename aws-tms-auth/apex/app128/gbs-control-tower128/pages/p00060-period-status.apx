            heading {
                heading: TEREX US
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    pageItem P60_DB_LINK (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @period-status-filters
            slot: regionBody
        }
        default {
            type: static
            staticValue: ADG
        }
    )

    pageItem P60_HIDE_NO_PERIOD (
        type: checkbox
        label {
            label: Hide orgs with no inventory period
            alignment: left
        }
        layout {
            sequence: 40
            region: @inventory-org-drilldown
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            cssClasses: js-ignoreChange
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P60_INV_LEDGER_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @period-status-filters
            slot: regionBody
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
    )

    pageItem P60_MONTH_OFFSET (
        type: selectList
        label {
            label: Month
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select upper(to_char(
                           add_months(trunc(sysdate, 'MM'), month_offset),
                           'MON-YYYY',
                           'NLS_DATE_LANGUAGE=English'
                       )) d,
                       month_offset r
                  from (
                      select level - 4 month_offset
                        from dual
                      connect by level <= 7
                  )
                 order by month_offset
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @period-status-filters
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        advanced {
            cssClasses: js-ignoreChange
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: 0
        }
    )

    button back-to-dashboard (
        buttonName: BACK_TO_DASHBOARD
        label: Close
        layout {
            sequence: 30
            region: @period-status-filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-arrow-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh-period-status (
        buttonName: REFRESH_STATUS
        label: Refresh Period Status
        layout {
            sequence: 20
            region: @period-status-filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction change-period-month (
        name: Change Month
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P60_MONTH_OFFSET
        }

        action hide-inventory-details (
            name: Hide Inventory Details
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.item("P60_INV_LEDGER_ID").setValue("", null, true);
                    $("#R1286062000000008").hide();
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-status-matrix (
            name: Refresh Status Matrix
            action: refresh
            affectedElements {
                selectionType: region
                region: @period-status-report
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction close (
        name: Close
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @back-to-dashboard
        }

        action close-window (
            action: executeJsCode
            settings {
                jsCode: window.close();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction filter-inventory-organizations (
        name: Filter Inventory Organizations
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P60_HIDE_NO_PERIOD
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @inventory-org-drilldown
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-period-status (
        name: Refresh Period Status
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh-period-status
        }

        action refresh-status-report (
            name: Refresh Status Report
            action: refresh
            affectedElements {
                selectionType: region
                region: @period-status-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction show-inventory-organizations (
        name: Show Inventory Organizations
        execution {
            sequence: 40
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .xxme-inventory-drill
        }

        action load-inventory-details (
            name: Load Inventory Details
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var button = this.triggeringElement;
                    var ledgerId = button.getAttribute("data-ledger-id");
                    var ledgerName = button.getAttribute("data-ledger-name");
                    var monthName = $("#P60_MONTH_OFFSET option:selected").text();
                    apex.item("P60_INV_LEDGER_ID").setValue(ledgerId, null, true);
                    $("#R1286062000000008_heading").text("Inventory Organizations - " + ledgerName + " - " + monthName);
                    $("#R1286062000000008").show();
                    document.getElementById("R1286062000000008").scrollIntoView({behavior:"smooth", block:"start"});
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-inventory-details (
            name: Refresh Inventory Details
            action: refresh
            affectedElements {
                selectionType: region
                region: @inventory-org-drilldown
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

