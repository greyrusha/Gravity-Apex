page 62 (
    name: Inventory Pending Transaction Details
    alias: INVENTORY-PENDING-TRANSACTION-DETAILS
    title: Inventory Pending Transaction Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1200
        height: 750
        chained: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @tms-application-access
    }

    region breadcrumb (
        name: Breadcrumb
        title: Pending Transaction Details
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: dialogHeader
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region inventory-detail-context (
        name: Selected Inventory Organization
        title: Selected Inventory Organization
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="t-Alert t-Alert--info t-Alert--horizontal" role="note">
                  <div class="t-Alert-wrap">
                    <div class="t-Alert-icon"><span class="t-Icon fa fa-info-circle" aria-hidden="true"></span></div>
                    <div class="t-Alert-content">
                      Required pending transactions captured for inventory organization &P62_ORG_NAME!HTML. in &P62_PERIOD_NAME!HTML..
                      Reopen this detail window to refresh the operational results.
                    </div>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region inventory-pending-detail-report (
        name: Required Pending Transaction Details
        title: Required Pending Transaction Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c001 period_name,
                       d001 schedule_close_date,
                       c002 organization_name,
                       c003 transaction_type,
                       d002 transaction_date,
                       c004 resolution,
                       c005 transaction_ref,
                       c006 transaction_ref_id,
                       c007 transaction_type_name,
                       c008 item
                  from apex_collections
                 where collection_name = 'P62DTL_' || :P62_SNAPSHOT_ID
                 order by seq_id
                ```
            pageItemsToSubmit: P62_SNAPSHOT_ID
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No required pending transactions remain for this inventory organization.
        }

        column ITEM (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Item
                alignment: center
            }
            layout {
                sequence: 100
            }
            sorting {
                sortable: false
            }
        )

        column ORGANIZATION_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Inventory Organization
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column PERIOD_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Inventory Period
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column RESOLUTION (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Resolution
                alignment: center
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column SCHEDULE_CLOSE_DATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Scheduled Close Date
                alignment: center
            }
            layout {
                sequence: 20
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            sorting {
                sortable: false
            }
        )

        column TRANSACTION_DATE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Transaction Date
                alignment: center
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI
            }
            sorting {
                sortable: false
            }
        )

        column TRANSACTION_REF (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Reference Type
                alignment: center
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column TRANSACTION_REF_ID (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Transaction Reference
                alignment: center
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column TRANSACTION_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Pending Transaction Category
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column TRANSACTION_TYPE_NAME (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Transaction Type
                alignment: center
            }
            layout {
                sequence: 90
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P62_LEDGER_ID (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    pageItem P62_MONTH_OFFSET (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P62_ORG_ID (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P62_ORG_NAME (
        type: hidden
        layout {
            sequence: 25
            slot: contentBody
        }
    )

    pageItem P62_PERIOD_NAME (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P62_SNAPSHOT_ID (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    button back-to-period-status (
        buttonName: BACK_TO_PERIOD_STATUS
        label: Back to Period Status
        layout {
            sequence: 10
            region: @inventory-detail-context
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-arrow-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction back-to-period-status (
        name: Back to Period Status
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @back-to-period-status
        }

        action restore-period-status-state (
            name: Restore Period Status State
            action: executeJsCode
            settings {
                jsCode: apex.navigation.dialog.close(true);
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process capture-pending-transaction-snapshot (
        name: Capture Pending Transaction Snapshot
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_period varchar2(15) := upper(trim(apex_util.get_session_state('P62_PERIOD_NAME')));
                  l_org_text varchar2(30) := trim(apex_util.get_session_state('P62_ORG_ID'));
                  l_offset_text varchar2(10) := trim(apex_util.get_session_state('P62_MONTH_OFFSET'));
                  l_ledger_text varchar2(30) := trim(apex_util.get_session_state('P62_LEDGER_ID'));
                  l_org number;
                  l_offset number;
                  l_ledger number;
                  l_snapshot_id varchar2(32);
                  l_collection_name varchar2(255);
                begin
                  if l_period is null or not regexp_like(l_period, '^(JAN|FEB|MAR|APR|MAY|JUN|JUL|AUG|SEP|OCT|NOV|DEC)-[0-9]{4}$', 'c') then
                    raise_application_error(-20182, 'Select a valid inventory period from Period Status.');
                  end if;
                  if l_org_text is null or not regexp_like(l_org_text, '^[0-9]{1,18}$', 'c') then
                    raise_application_error(-20183, 'Select a valid inventory organization from Period Status.');
                  end if;
                  if l_offset_text is null or not regexp_like(l_offset_text, '^-?[0-9]+$', 'c') then
                    raise_application_error(-20184, 'The selected month is invalid.');
                  end if;
                  if l_ledger_text is null or not regexp_like(l_ledger_text, '^[0-9]{1,18}$', 'c') then
                    raise_application_error(-20185, 'The selected ledger is invalid.');
                  end if;
                  l_org := to_number(l_org_text);
                  l_offset := to_number(l_offset_text);
                  l_ledger := to_number(l_ledger_text);
                  if l_ledger not in (1003, 5001, 10001) then
                    raise_application_error(-20185, 'The selected ledger is outside the Page 60 scope.');
                  end if;
                  if l_offset not in (-3, -2, -1, 0, 1, 2, 3)
                     or l_period <> upper(to_char(add_months(trunc(sysdate, 'MM'), l_offset), 'MON-YYYY', 'NLS_DATE_LANGUAGE=English')) then
                    raise_application_error(-20184, 'The selected month does not match Period Status.');
                  end if;
                  declare n number; begin
                    select /*+ DRIVING_SITE(ood) */ count(*) into n from apps.org_organization_definitions@ADG ood
                    where ood.organization_id=l_org and ood.set_of_books_id=l_ledger and nvl(ood.disable_date,sysdate)>=sysdate;
                    if n<>1 then raise_application_error(-20185, 'The selected organization does not belong to the selected ledger.'); end if;
                  end;
                  l_snapshot_id := rawtohex(sys_guid());
                  l_collection_name := 'P62DTL_' || l_snapshot_id;
                  apex_collection.create_collection(p_collection_name=>l_collection_name);
                  for r in (
                    select period_name, schedule_close_date, organization_name,
                           transaction_type, transaction_date, resolution, transaction_ref,
                           transaction_ref_id, transaction_type_name, item
                      from table(xxinv128_period_pending_pkg.get_required_details(l_period, l_org))
                  ) loop
                    apex_collection.add_member(
                      p_collection_name=>l_collection_name,
                      p_c001=>r.period_name,
                      p_d001=>r.schedule_close_date,
                      p_c002=>r.organization_name,
                      p_c003=>r.transaction_type,
                      p_d002=>r.transaction_date,
                      p_c004=>r.resolution,
                      p_c005=>r.transaction_ref,
                      p_c006=>r.transaction_ref_id,
                      p_c007=>r.transaction_type_name,
                      p_c008=>r.item);
                  end loop;
                  apex_util.set_session_state(
                    p_name=>'P62_SNAPSHOT_ID',
                    p_value=>l_snapshot_id,
                    p_commit=>false);
                exception
                  when others then
                    if l_collection_name is not null and apex_collection.collection_exists(l_collection_name) then
                      apex_collection.delete_collection(l_collection_name);
                    end if;
                    apex_util.set_session_state(p_name=>'P62_SNAPSHOT_ID', p_value=>null, p_commit=>false);
                    raise;
                end;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 1286062000000052
        }
    )

)

