page 99 (
    name: Knowledge History and Source Requests
    alias: KNOWLEDGE-HISTORY-SOURCE-REQUESTS
    title: Knowledge History and Source Requests
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @tms-application-access
    }
    config {
        buildOption: @feature-ai
    }

    region km-audit-timeline (
        name: Audit Timeline
        title: Audit Timeline
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.event_type, r.version_no, e.from_state, e.to_state, e.event_by, e.event_on
                  from xxme_ai_km_events e
                  left join xxme_ai_km_revisions r on r.revision_id=e.revision_id
                 where e.item_id=:P99_ITEM_ID
                 order by e.event_on desc, e.event_id desc
                ```
            pageItemsToSubmit: P99_ITEM_ID
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: showAll
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
        }

        column EVENT_BY (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: By
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column EVENT_ON (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: On
                alignment: center
            }
            layout {
                sequence: 60
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column EVENT_TYPE (
            reportColumnQueryId: 1
