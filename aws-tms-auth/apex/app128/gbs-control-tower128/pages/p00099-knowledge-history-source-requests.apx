    pageItem P99_ITEM_LOCK_VERSION (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @km-history-actions
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: select lock_version from xxme_ai_km_items where item_id=:P99_ITEM_ID
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P99_REQUEST_ID (
        type: selectList
        label {
            label: Source Request
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Request '||q.request_id||' - '||q.request_state||' - '||s.source_name d, q.request_id r
                  from xxme_ai_km_source_requests q join xxme_ai_km_items i on i.item_id=q.item_id join xxme_ai_km_sources s on s.source_id=i.source_id
                 where q.item_id=:P99_ITEM_ID order by q.request_id desc
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P99_ITEM_ID
            itemsToSubmit: P99_ITEM_ID
        }
        layout {
            sequence: 40
            region: @km-history-actions
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: 1672985690212569356
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P99_REVISION_ID (
        type: selectList
        label {
            label: Historical Revision
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Version '||version_no||' - '||title d, revision_id r
                  from xxme_ai_km_revisions where item_id=:P99_ITEM_ID order by version_no desc
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P99_ITEM_ID
            itemsToSubmit: P99_ITEM_ID
        }
        layout {
            sequence: 30
            region: @km-history-actions
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: 1672985690212569356
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    button apply-km-oracle-request (
        buttonName: APPLY_ORACLE_REQUEST
        label: Apply and Synchronize Oracle Rule
        layout {
            sequence: 30
            region: @km-history-actions
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
            icon: fa-database
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Apply this approved change to the authoritative Oracle rule source and synchronize the candidate?
            style: warning
        }
    )

    button approve-km-source-request (
        buttonName: APPROVE_SOURCE_REQUEST
        label: Approve Source Request
        layout {
            sequence: 20
            region: @km-history-actions
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-thumbs-up
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
