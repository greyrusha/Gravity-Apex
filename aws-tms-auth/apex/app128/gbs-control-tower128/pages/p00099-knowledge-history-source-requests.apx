    button retire-km-direct-item (
        buttonName: RETIRE_DIRECT_ITEM
        label: Retire Direct Knowledge
        layout {
            sequence: 40
            region: @km-history-actions
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
            icon: fa-archive
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Retire this directly managed knowledge item and deactivate its retrieval representation?
            style: danger
        }
    )

    process apply-oracle-rule-request (
        name: Apply Oracle Rule Request
        type: executeCode
        source {
