    region recon-invoice-detail (
        name: Reconciliation Invoice Detail
        title: AP Snapshot Invoices for Liability Account
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select invoice_num, invoice_date, supplier_name, supplier_number, min_due_date, max_due_date,
                       invoice_amount, acct_invoice_amount, open_accounted_amount, invoice_id
                  from xx_ap_trial_balance_snap
                 where :P24_REPORT_READY = 'Y'
                   and db_link = :P24_DB_LINK and as_of_date = to_date(:P24_AS_OF_DATE,'YYYY-MM-DD')
                   and ledger_id = to_number(:P24_LEDGER_ID) and company_segment = :P24_COMPANY
                   and gl_liab_ccid = to_number(:P24_SELECTED_CCID)
                ```
            pageItemsToSubmit: [
                P24_REPORT_READY
                P24_DB_LINK
                P24_AS_OF_DATE
                P24_LEDGER_ID
                P24_COMPANY
                P24_SELECTED_CCID
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: recon-invoice-detail
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No AP snapshot invoices were found for this liability account.
        }
        advanced {
            savedReportMappingIdentifier: 897156623912685650
        }

