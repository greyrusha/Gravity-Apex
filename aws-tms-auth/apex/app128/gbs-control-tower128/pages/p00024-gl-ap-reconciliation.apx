        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: AP Snapshot Invoice Detail
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCT_INVOICE_AMOUNT (
                sequence: 8
            )

            displayColumn INVOICE_AMOUNT (
                sequence: 7
            )

            displayColumn INVOICE_DATE (
                sequence: 2
            )

            displayColumn INVOICE_NUM (
                sequence: 1
            )

            displayColumn MAX_DUE_DATE (
                sequence: 6
            )

            displayColumn MIN_DUE_DATE (
                sequence: 5
            )

            displayColumn OPEN_ACCOUNTED_AMOUNT (
                sequence: 9
            )

            displayColumn SUPPLIER_NAME (
