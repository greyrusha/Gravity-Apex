    button close-page (
        buttonName: CLOSE_PAGE
        label: Back to Exceptions
        layout {
            sequence: 30
            region: @filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-arrow-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction close-page (
        name: Close Page
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @close-page
        }

        action close-window (
            name: Return to Source Page
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    const returnUrl = apex.item("P42_RETURN_URL").getValue();
                    if (returnUrl) {
                        apex.navigation.redirect(returnUrl);
                    } else {
                        window.close();
                    }
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action generate-return-url (
            name: Generate Return URL
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P42_RETURN_URL :=
                        case :P42_SOURCE_PAGE
                            when '41' then apex_page.get_url(
                                p_page        => 41,
                                p_clear_cache => '41'
                            )
                            when '20' then apex_page.get_url(p_page => 20)
                            when '30' then apex_page.get_url(p_page => 30)
                            else null
                        end;
                    ```
                itemsToSubmit: P42_SOURCE_PAGE
                itemsToReturn: P42_RETURN_URL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process resolve-organization-name (
        name: Resolve Organization Name
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_db_link VARCHAR2(30);
                    l_sql     VARCHAR2(1000);
                BEGIN
                    :P42_ORG_NAME := NULL;
                
                    IF :P42_ORG_ID IS NOT NULL
                       AND :P42_DB_LINK IS NOT NULL
                       AND :P42_APPLICATION_ID IS NOT NULL
                    THEN
                        l_db_link := xxme_db_source_pkg.normalize_db_link(:P42_DB_LINK);
                
                        IF TO_NUMBER(:P42_APPLICATION_ID) IN (200, 222) THEN
                            l_sql :=
                                'SELECT MAX(TRIM(name)) ' ||
                                'FROM apps.hr_operating_units@' || l_db_link ||
                                ' WHERE organization_id = :1';
                        ELSIF TO_NUMBER(:P42_APPLICATION_ID) = 707 THEN
                            l_sql :=
                                'SELECT MAX(TRIM(organization_name)) ' ||
                                'FROM apps.org_organization_definitions@' || l_db_link ||
                                ' WHERE organization_id = :1';
                        END IF;
                
                        IF l_sql IS NOT NULL THEN
                            EXECUTE IMMEDIATE l_sql
                                INTO :P42_ORG_NAME
                                USING TO_NUMBER(:P42_ORG_ID);
                        END IF;
                    END IF;
                
                    IF :P42_ORG_ID IS NOT NULL AND :P42_ORG_NAME IS NULL THEN
                        :P42_ORG_NAME := 'Unknown organization';
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 120042000000000010
        }
    )

)

