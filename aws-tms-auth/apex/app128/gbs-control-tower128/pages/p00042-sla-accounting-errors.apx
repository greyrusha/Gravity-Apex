page 42 (
    name: SLA Accounting Errors
    alias: SLA-ACCOUNTING-ERRORS
    title: SLA Accounting Errors
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @tms-application-access
    }

    region breadcrumb (
        name: Breadcrumb
        title: SLA Accounting Errors
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filters (
        name: Filters
        title: Filters
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region instructions (
        name: Instructions
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="t-Alert t-Alert--horizontal t-Alert--defaultIcons t-Alert--info">
                  <div class="t-Alert-wrap">
                    <div class="t-Alert-icon">
                      <span class="t-Icon"></span>
                    </div>
                    <div class="t-Alert-content">
                      <div class="t-Alert-header">
                        <h2 class="t-Alert-title">Select an exception before opening this page</h2>
                      </div>
                      <div class="t-Alert-body">
                        Open Page 42 from an exception row on Payables, Receivables, or Cost
                        Management. The selected period, database source, ledger, organization,
                        entity, and exception type will be applied automatically.
                      </div>
                    </div>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                NVL(:P42_RUN_SLA, 'N') <> 'Y'
                OR NVL(:P42_RUN_PERIOD, '#') <> NVL(:P42_PERIOD_NAME, '#')
                ```
        }
    )

    region interactive-report-ai-notice (
        name: Interactive Report AI Notice
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="t-Alert t-Alert--info t-Alert--horizontal" role="note">
                  <div class="t-Alert-wrap">
                    <div class="t-Alert-icon">
                      <span class="t-Icon fa fa-info-circle" aria-hidden="true"></span>
