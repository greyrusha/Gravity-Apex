        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P42_SOURCE_PAGE IS NOT NULL
        }
    )

    region sla-accounting-errors (
        name: SLA Accounting Errors
        title: SLA Accounting Errors
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT accounting_error_id,
                       application_id,
                       sla_source,
                       ledger_id,
                       ledger_name,
                       organization_id,
                       entity_code,
                       source_transaction_id,
                       transaction_number,
                       event_id,
                       event_type_code,
                       event_status_code,
                       process_status_code,
                       transaction_date,
                       ae_header_id,
                       ae_line_num,
                       accounting_date,
                       accounting_entry_status_code,
                       gl_transfer_status_code,
                       message_number,
                       error_source_code,
                       error_message,
                       error_creation_date,
                       error_age_days,
                       exception_type,
                       severity,
                       refresh_timestamp
                FROM TABLE(
                    xxme_sla_error_drill_pkg.get_errors(
                        :P42_RUN_PERIOD,
                        TO_NUMBER(:P42_APPLICATION_ID),
                        TO_NUMBER(:P42_LEDGER_ID),
                        TO_NUMBER(:P42_ORG_ID),
                        :P42_ENTITY_CODE,
                        :P42_DB_LINK
                    )
                ) e
                WHERE (:P42_EXCEPTION_TYPE IS NULL OR UPPER(e.exception_type) = UPPER(:P42_EXCEPTION_TYPE))
                ORDER BY sla_source,
                         ledger_id,
                         transaction_date,
                         event_id,
                         accounting_error_id
                ```
            pageItemsToSubmit: [
                P42_PERIOD_NAME
                P42_RUN_PERIOD
                P42_RUN_SLA
                P42_APPLICATION_ID
                P42_LEDGER_ID
                P42_ORG_ID
                P42_ENTITY_CODE
                P42_EXCEPTION_TYPE
                P42_DB_LINK
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P42_RUN_SLA = 'Y'
                AND :P42_RUN_PERIOD = :P42_PERIOD_NAME
                ```
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound:
                ```
                <div class="t-Alert t-Alert--success t-Alert--horizontal">
                  <div class="t-Alert-wrap">
                    <div class="t-Alert-icon">
                      <span class="t-Icon fa fa-check-circle" aria-hidden="true"></span>
                    </div>
                    <div class="t-Alert-content">
                      <div class="t-Alert-header">
                        <h2 class="t-Alert-title">No active SLA accounting errors found</h2>
                      </div>
                      <div class="t-Alert-body">
                        No active processing/accounting errors were found for Payables,
                        Receivables, or Cost Management for the selected period and approved
                        ledger scope.
                      </div>
                    </div>
                  </div>
                </div>
                ```
        }
        advanced {
            savedReportMappingIdentifier: 20646141499248710
        }

