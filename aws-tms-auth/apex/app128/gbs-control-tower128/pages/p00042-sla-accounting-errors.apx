                        Ledger <strong>&P42_LEDGER_ID!HTML.</strong> &middot;
                        Organization <strong>&P42_ORG_NAME!HTML. (&P42_ORG_ID!HTML.)</strong> &middot;
                        Entity <strong>&P42_ENTITY_CODE!HTML.</strong> &middot;
