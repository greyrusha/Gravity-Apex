page 32 (
    name: AR Open Balance Snapshot
    alias: AR-OPEN-BALANCE-SNAPSHOT
    title: AR Open Balance Snapshot
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            /* Page 32 AR open-balance snapshot workflow. */
            var p32Controller = (function ($) {
              'use strict';
              var busy=false, spinner=null, timerId=null, startedAt=null, known=null;
              function byId(id){return $('#'+id);}
              function reportElement(){return byId('ar-open-balance-ir');}
              function reportRegion(){try{return apex.region('ar-open-balance-ir');}catch(ignore){return null;}}
              function filters$(){return $('#P32_DB_LINK,#P32_PERIOD_NAME,#P32_LEDGER_ID,#P32_COMPANY_SEGMENT');}
              function actionButtons(show){byId('use-existing-snapshot').toggle(show);byId('reload-snapshot').toggle(show);}
              function runButton(show){byId('run-ar-snapshot').toggle(show);}
              function analysisButton(show){byId('aging-analysis').toggle(show);byId('gl-ar-reconciliation').toggle(show);byId('ar-ai-analyst').toggle(show);}
              function setBusy(on){busy=on;filters$().prop('disabled',on);byId('run-ar-snapshot').prop('disabled',on);byId('use-existing-snapshot').prop('disabled',on);byId('reload-snapshot').prop('disabled',on);}
              function stopActivity(){if(timerId){clearInterval(timerId);timerId=null;}if(spinner){spinner.remove();spinner=null;}}
              function seconds(){return ((performance.now()-startedAt)/1000).toFixed(1)+' s';}
              function startActivity(){stopActivity();startedAt=performance.now();byId('p32-status-timing').text('Elapsed: 0.0 s');timerId=setInterval(function(){byId('p32-status-timing').text('Elapsed: '+seconds());},250);try{spinner=apex.util.showSpinner(byId('snapshot-status'));}catch(ignore){spinner=null;}}
              function showStatus(kind,title,body,timing){byId('snapshot-status').show();var p=byId('p32-status-panel');p.removeAttr('hidden').removeClass('p32-status--info p32-status--warning p32-status--success p32-status--error').addClass('p32-status--'+kind);byId('p32-status-title').text(title);byId('p32-status-body').text(body||'');byId('p32-status-timing').text(timing||'');}
              function hideReport(){apex.item('P32_REPORT_READY').setValue('N',null,true);analysisButton(false);reportElement().hide();}
              function setRunContext(m){apex.item('P32_RUN_DB_LINK').setValue(m.db_link,null,true);apex.item('P32_RUN_PERIOD_NAME').setValue(m.period_name,null,true);apex.item('P32_RUN_LEDGER_ID').setValue(m.ledger_id,null,true);apex.item('P32_RUN_COMPANY').setValue(m.company,null,true);apex.item('P32_RUN_AGING_BUCKET_ID').setValue(m.aging_bucket_id,null,true);apex.item('P32_REPORT_READY').setValue('Y',null,true);}
              function showReport(m){if(Number(m.row_count)<1){actionButtons(false);runButton(false);hideReport();return;}setRunContext(m);actionButtons(false);runButton(false);var e=reportElement(),r;if(!e.length){throw new Error('The AR Open Balance report region is unavailable.');}e.show();r=reportRegion();if(r&&typeof r.refresh==='function'){r.refresh();}else{e.trigger('apexrefresh');}analysisButton(true);}
              function metadataText(m){return 'Generated '+m.loaded_on+' by '+m.loaded_by+' ('+m.row_count+' rows). As of '+m.as_of_date+'.';}
              function renderExisting(m,changed){known=m;hideReport();actionButtons(true);runButton(false);showStatus(changed?'warning':'info',changed?'Snapshot changed':'Existing snapshot found',(changed?'Another user generated a newer snapshot. Review it before choosing again. ':'')+metadataText(m));}
              function params(){var r={db_link:$.trim(apex.item('P32_DB_LINK').getValue()).toUpperCase(),period_name:$.trim(apex.item('P32_PERIOD_NAME').getValue()).toUpperCase(),ledger_id:$.trim(apex.item('P32_LEDGER_ID').getValue()),company:$.trim(apex.item('P32_COMPANY_SEGMENT').getValue()).toUpperCase(),aging_bucket_id:$.trim(apex.item('P32_AGING_BUCKET_ID').getValue())},m=[];if(!r.db_link)m.push('Database Source');if(!r.period_name)m.push('Period');if(!r.ledger_id)m.push('Ledger');if(!r.company)m.push('Company Code');if(m.length){apex.message.showErrors([{type:'error',location:'page',message:'Select '+m.join(', ')+' before running.',unsafe:false}]);return null;}apex.item('P32_PERIOD_NAME').setValue(r.period_name,null,true);apex.item('P32_COMPANY_SEGMENT').setValue(r.company,null,true);apex.message.clearErrors();return r;}
              function payload(p){return{x01:p.db_link,x02:p.period_name,x03:p.ledger_id,x04:p.company,x07:p.aging_bucket_id};}
              function requestError(message,preserve){stopActivity();setBusy(false);actionButtons(!!preserve&&!!known);runButton(!(preserve&&known));showStatus('error',preserve?'Reload failed':'Request failed',message+(preserve?' The previous snapshot remains available.':''));}
              function beginLoad(p,reload){actionButtons(false);runButton(false);hideReport();setBusy(true);showStatus('warning',reload?'Reloading snapshot':'Generating snapshot',(reload?'The existing snapshot is being replaced. ':'No existing snapshot was found. ')+'Retrieving open Receivables balances from TMS may take up to two minutes.');startActivity();var d=payload(p);d.x05=reload&&known?known.token:'';d.x06=reload?'Y':'N';apex.server.process('P32_LOAD_SNAPSHOT',d,{dataType:'json'}).then(function(result){stopActivity();setBusy(false);if(!result||result.ok!==true){requestError((result&&result.message)||'Unable to generate the snapshot.',reload);return;}if(result.changed===true){renderExisting(result.snapshot,true);return;}known=result.snapshot;if(Number(known.row_count)<1){showStatus('warning','No AR open-balance data found','No rows matched the selected source, period, ledger and company. Verify the combination and try again.','Total: '+seconds());showReport(known);return;}showStatus('success','Snapshot generated',metadataText(known),'Total: '+seconds());try{showReport(known);}catch(e){requestError(e.message,false);}},function(error){requestError((error&&error.message)||'Unable to generate the snapshot.',reload);});}
              function check(){if(busy)return;var p=params();if(!p)return;known=null;actionButtons(false);hideReport();setBusy(true);showStatus('info','Checking snapshot availability','Checking the selected database source, period, ledger and company.');apex.server.process('P32_CHECK_SNAPSHOT',payload(p),{dataType:'json'}).then(function(result){if(!result||result.ok!==true){requestError((result&&result.message)||'Unable to check snapshot availability.',false);return;}if(result.exists===true){setBusy(false);renderExisting(result.snapshot,false);}else{beginLoad(result.snapshot,false);}},function(error){requestError((error&&error.message)||'Unable to check snapshot availability.',false);});}
              function useExisting(){if(busy||!known)return;showStatus('success','Using existing snapshot',metadataText(known));try{showReport(known);}catch(e){requestError(e.message,false);}}
              function recheckAndReload(){var p=params();if(!p)return;setBusy(true);actionButtons(false);hideReport();showStatus('info','Rechecking snapshot','Confirming that the snapshot has not changed.');apex.server.process('P32_CHECK_SNAPSHOT',payload(p),{dataType:'json'}).then(function(result){if(!result||result.ok!==true){requestError((result&&result.message)||'Unable to recheck the snapshot.',true);return;}if(result.exists===true&&known&&result.snapshot.token!==known.token){setBusy(false);renderExisting(result.snapshot,true);return;}beginLoad(result.snapshot,true);},function(error){requestError((error&&error.message)||'Unable to recheck the snapshot.',true);});}
              function requestReload(){if(busy||!known)return;apex.message.confirm('Replace the snapshot '+metadataText(known),function(ok){if(ok)recheckAndReload();});}
              function openAging(){if(busy||apex.item('P32_REPORT_READY').getValue()!=='Y')return;var target='ar_aging_'+Date.now(),child=window.open('',target);if(!child){apex.message.showErrors([{type:'error',location:'page',message:'Allow pop-ups to open Aging Analysis in a new tab.',unsafe:false}]);return;}child.document.write('<title>Opening AR Aging Analysis</title><p style="font-family:sans-serif;padding:1rem">Opening AR Aging Analysis...</p>');apex.server.process('P32_GET_AGING_URL',{pageItems:'#P32_REPORT_READY,#P32_RUN_DB_LINK,#P32_RUN_PERIOD_NAME,#P32_RUN_LEDGER_ID,#P32_RUN_COMPANY,#P32_RUN_AGING_BUCKET_ID'},{dataType:'json'}).then(function(result){if(!result||result.ok!==true||!result.url){child.close();apex.message.showErrors([{type:'error',location:'page',message:(result&&result.message)||'Unable to open Aging Analysis.',unsafe:false}]);return;}child.location.replace(result.url);},function(error){child.close();apex.message.showErrors([{type:'error',location:'page',message:(error&&error.message)||'Unable to open Aging Analysis.',unsafe:false}]);});}
              function openReconciliation(){if(busy||apex.item('P32_REPORT_READY').getValue()!=='Y')return;var target='gl_ar_recon_'+Date.now(),child=window.open('',target);if(!child){apex.message.showErrors([{type:'error',location:'page',message:'Allow pop-ups to open GL/AR Reconciliation in a new tab.',unsafe:false}]);return;}child.document.write('<title>Opening GL/AR Reconciliation</title><p style="font-family:sans-serif;padding:1rem">Opening GL/AR Reconciliation...</p>');apex.server.process('P32_GET_RECON_URL',{pageItems:'#P32_REPORT_READY,#P32_RUN_DB_LINK,#P32_RUN_PERIOD_NAME,#P32_RUN_LEDGER_ID,#P32_RUN_COMPANY,#P32_RUN_AGING_BUCKET_ID'},{dataType:'json'}).then(function(result){if(!result||result.ok!==true||!result.url){child.close();apex.message.showErrors([{type:'error',location:'page',message:(result&&result.message)||'Unable to open GL/AR Reconciliation.',unsafe:false}]);return;}child.location.replace(result.url);},function(error){child.close();apex.message.showErrors([{type:'error',location:'page',message:(error&&error.message)||'Unable to open GL/AR Reconciliation.',unsafe:false}]);});}
              function openAi(){if(busy||apex.item('P32_REPORT_READY').getValue()!=='Y')return;var target='ar_ai_'+Date.now(),child=window.open('',target);if(!child){apex.message.showErrors([{type:'error',location:'page',message:'Allow pop-ups to open the AI Analyst in a new tab.',unsafe:false}]);return;}child.document.write('<title>Opening AI Analyst</title><p style="font-family:sans-serif;padding:1rem">Opening AI Analyst...</p>');apex.server.process('P32_GET_AI_URL',{pageItems:'#P32_REPORT_READY,#P32_RUN_DB_LINK,#P32_RUN_PERIOD_NAME,#P32_RUN_LEDGER_ID,#P32_RUN_COMPANY,#P32_RUN_AGING_BUCKET_ID'},{dataType:'json'}).then(function(result){if(!result||result.ok!==true||!result.url){child.close();apex.message.showErrors([{type:'error',location:'page',message:(result&&result.message)||'Unable to open the AI Analyst.',unsafe:false}]);return;}child.location.replace(result.url);},function(error){child.close();apex.message.showErrors([{type:'error',location:'page',message:(error&&error.message)||'Unable to open the AI Analyst.',unsafe:false}]);});}
              function reset(){if(busy)return;known=null;stopActivity();actionButtons(false);runButton(true);hideReport();byId('p32-status-panel').attr('hidden','hidden');byId('snapshot-status').hide();apex.message.clearErrors();}
              $(function(){actionButtons(false);runButton(true);hideReport();byId('p32-status-panel').attr('hidden','hidden');byId('snapshot-status').hide();filters$().on('change.p32',reset);});
              return{check:check,useExisting:useExisting,requestReload:requestReload,openAging:openAging,openReconciliation:openReconciliation,openAi:openAi,reset:reset};
            })(apex.jQuery);
            ```
    }
    css {
        inline:
            ```css
            #ar-open-balance-ir{display:none;}
            #use-existing-snapshot,#reload-snapshot,#aging-analysis,#gl-ar-reconciliation,#ar-ai-analyst{display:none;}
            #snapshot-status{position:relative;min-height:4rem;}
            .p32-status{border-left:4px solid #6b7280;border-radius:.25rem;padding:.8rem 1rem;background:#f6f7f8;}
            .p32-status--info{border-left-color:#2563eb;background:#eff6ff;}
            .p32-status--warning{border-left-color:#d97706;background:#fffbeb;}
            .p32-status--success{border-left-color:#15803d;background:#f0fdf4;}
            .p32-status--error{border-left-color:#b91c1c;background:#fef2f2;}
            #p32-status-title{font-size:1rem;font-weight:700;margin:0 0 .25rem;}
            #p32-status-body{margin:0;}
            #p32-status-timing{font-variant-numeric:tabular-nums;font-weight:600;margin-top:.35rem;}
            .p32-control-N{display:inline-block;padding:.15rem .45rem;border-radius:1rem;background:#fee2e2;color:#991b1b;font-weight:700;}
            .p32-control-Y{display:inline-block;padding:.15rem .45rem;border-radius:1rem;background:#dcfce7;color:#166534;font-weight:700;}
            ```
    }
    security {
        authorizationScheme: @tms-application-access
    }

    region ar-open-balance-ir (
        name: AR Open Balance
        title: AR Open Balance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select customer_number, customer_name, trx_number, class_code, trx_date, due_date,
                       days_past_due, bucket_heading, currency_code, entered_balance_asof,
                       accounted_balance_asof, account_segments,
                       case control_account_flag when 'Y' then 'Control Account'
                            else 'Outside Control Account' end control_account_status,
                       payment_schedule_id, customer_id, customer_trx_id, receivable_ccid, org_id,
                       bucket_sequence, control_account_flag
                  from xxme_ar_recon_v2_snap
                 where :P32_REPORT_READY = 'Y'
                   and db_link_name = :P32_RUN_DB_LINK
                   and period_name = :P32_RUN_PERIOD_NAME
                   and ledger_id = to_number(:P32_RUN_LEDGER_ID)
                   and company_segment = :P32_RUN_COMPANY
                   and aging_bucket_id = to_number(:P32_RUN_AGING_BUCKET_ID)
                ```
            pageItemsToSubmit: [
                P32_REPORT_READY
                P32_RUN_DB_LINK
                P32_RUN_PERIOD_NAME
                P32_RUN_LEDGER_ID
                P32_RUN_COMPANY
                P32_RUN_AGING_BUCKET_ID
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: ar-open-balance-ir
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: The selected snapshot contains no AR open-balance rows.
        }
        advanced {
            savedReportMappingIdentifier: 932160000000686645
        }

        column ACCOUNTED_BALANCE_ASOF (
            type: plainText
            heading {
                heading: Accounted Open Balance
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column ACCOUNT_SEGMENTS (
            type: plainText
