    region interactive-report-ai-notice (
        name: Interactive Report AI Notice
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="t-Alert t-Alert--info t-Alert--horizontal" role="note">
                  <div class="t-Alert-wrap">
                    <div class="t-Alert-icon">
                      <span class="t-Icon fa fa-info-circle" aria-hidden="true"></span>
                    </div>
                    <div class="t-Alert-content">
                      AI Assistant available: Use it to filter, sort, summarize, and create informational charts from this report. It cannot update data, and AI-generated charts are not drillable. Verify important conclusions against the report rows.
                    </div>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @feature-ai
        }
    )

    region snapshot-parameters (
        name: Snapshot Parameters
        title: Snapshot Parameters
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Select the TMS database source, Receivables period, ledger, and company code, then click <strong>Run AR Snapshot</strong>.</p>
                <p>If a snapshot exists, review its generation details and choose whether to use it or replace it.</p>
                <details><summary>Amount definitions</summary><dl><dt>Entered Open Balance</dt><dd>Remaining open amount in transaction currency; do not total across currencies.</dd><dt>Accounted Open Balance</dt><dd>Remaining open amount in ledger functional currency; use this for ledger-level totals and reconciliation.</dd></dl></details>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: snapshot-parameters
        }
    )

    region snapshot-status (
        name: Snapshot Status
        title: Snapshot Status
        type: staticContent
        source {
            htmlCode:
                ```html
                <div id="p32-status-panel" class="p32-status p32-status--info" role="status" aria-live="polite" hidden>
                  <h3 id="p32-status-title"></h3>
                  <p id="p32-status-body"></p>
                  <div id="p32-status-timing"></div>
                </div>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: snapshot-status
        }
    )

    pageItem P32_AGING_BUCKET_ID (
        type: hidden
