            type: sqlQuery
            sqlQuery: select period_name d,period_name r from xxinv128_org_period_mv where ledger_id=to_number(:P73_LEDGER_ID default null on conversion error) and period_start_date<=trunc(sysdate) group by period_name order by max(period_start_date) desc
            nullDisplayValue: Select period
