    )

    region on-hand-vs-gl (
        name: On-hand vs GL
        type: staticContent
        source {
            htmlCode:
                ```html
                <div id="inv73-stock-view">
                <div class="inv73-stock-toolbar"><h2>On-hand accounts to review</h2><div><label>View org <select id="inv73-stock-org" aria-label="View accounts involving an Inventory Org"><option value="">All captured orgs</option></select></label><label><input type="checkbox" id="inv73-stock-all"> Show all accounts</label></div></div>
                <p id="inv73-stock-view-note" class="inv73-muted">Differences over 1.00, unavailable comparisons, and zero-stock GL residuals remain visible.</p>
                <div id="inv73-stock-message" class="inv73-message" role="status" hidden></div>
                <div class="inv73-stock-scroll"><table class="inv73-stock-table" aria-label="Captured on-hand account valuation and General Ledger comparison"><thead><tr><th>Account</th><th>Org owner(s)</th><th class="inv73-stock-num">On-hand Valuation</th><th class="inv73-stock-num">GL Closing Balance</th><th class="inv73-stock-num">Valuation − GL</th></tr></thead><tbody id="inv73-stock-rows"><tr><td colspan="5">Run reconciliation to capture on-hand account balances.</td></tr></tbody></table></div>
                <div class="inv73-stock-toolbar"><span id="inv73-stock-count" class="inv73-muted">No capture</span><div><button type="button" class="t-Button t-Button--small" id="inv73-stock-prev" disabled>Previous</button><button type="button" class="t-Button t-Button--small" id="inv73-stock-next" disabled>Next</button></div></div>
                <p class="inv73-muted">Expand Account → Inventory Org → Subinventory. GL and difference appear once at account level. View filters do not change the captured scope or the three cards.</p>
                </div>
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--hideHeader
            ]
            cssClasses: inv73-panel
        }
        advanced {
            htmlDomId: inv73-panel-stock
        }
    )

