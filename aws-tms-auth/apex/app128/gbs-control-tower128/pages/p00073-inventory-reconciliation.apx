            .inv73-stock-cards{grid-template-columns:repeat(3,minmax(0,1fr))}.inv73-stock-toolbar{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;margin:12px 0}.inv73-stock-toolbar h2{font-size:18px;margin:0}.inv73-stock-toolbar>div{display:flex;align-items:center;gap:16px;flex-wrap:wrap}.inv73-stock-toolbar label{font-size:12px;display:flex;gap:7px;align-items:center}.inv73-stock-toolbar select{background:var(--ut-component-background-color,#fff);color:var(--ut-body-text-color,#333);padding:6px;border:1px solid var(--ut-component-border-color,#ddd);max-width:280px}.inv73-stock-scroll{overflow:auto;max-height:580px;border:1px solid var(--ut-component-border-color,#ddd)}.inv73-stock-table{width:100%;border-collapse:collapse;font-size:12px;min-width:850px}.inv73-stock-table th,.inv73-stock-table td{padding:12px 10px;text-align:left;vertical-align:top;border-bottom:1px solid var(--ut-component-border-color,#ddd)}.inv73-stock-table th{background:var(--ut-region-header-background-color,#edf2f6);font-weight:600;position:sticky;top:0;z-index:1}.inv73-stock-table th:first-child{width:34%}.inv73-stock-table .inv73-stock-num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}.inv73-stock-expand{display:flex;gap:8px;border:0;background:transparent;color:var(--ut-link-text-color,#51449a);font:inherit;text-align:left;padding:0;cursor:pointer}.inv73-stock-expand:focus-visible{outline:2px solid var(--ut-palette-primary,#51449a);outline-offset:4px}.inv73-stock-caption{display:block;font-size:11px;opacity:.75;margin-top:4px;white-space:normal}.inv73-stock-detail{background:var(--ut-component-background-color,#f5f6fa)}.inv73-stock-detail td:first-child{padding-left:28px}.inv73-stock-sub td:first-child{padding-left:48px}.inv73-stock-unavailable{color:var(--ut-palette-warning,#805613)}@media(max-width:650px){.inv73-stock-cards{grid-template-columns:1fr}}
            
            /* Plain-language report descriptions and status guidance. */
            .inv73-report-guide{margin:8px 0 14px;font-size:12px;max-width:1050px}.inv73-report-guide summary{cursor:pointer;font-weight:600}.inv73-report-guide p{margin:8px 0}.inv73-status.inv73-badge{white-space:normal;line-height:1.45}
