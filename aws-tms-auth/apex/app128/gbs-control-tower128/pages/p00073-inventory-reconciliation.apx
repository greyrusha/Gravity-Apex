            const ledgerNames={'1003':'TEREX US · USD','5001':'TEREX UK 120 · GBP','10001':'TEREX CH · EUR'};
            byId('inv73-capture-title').textContent=captured?(ledgerNames[String(meta.CAPTURED_LEDGER_ID)]||meta.CAPTURED_LEDGER_ID)+' · '+(meta.CAPTURED_OU_NAME||'Operating unit')+' · '+meta.CAPTURED_PERIOD_NAME+' · '+meta.SELECTED_ORG_COUNT+' selected org'+(Number(meta.SELECTED_ORG_COUNT)===1?'':'s'):'No reconciliation capture';
            byId('inv73-capture-status').textContent=!captured?'Not run':incomplete?'Incomplete · Provisional':partial?'Stock comparisons unavailable':'Capture complete';
            byId('inv73-capture-status').className='inv73-badge '+(!captured?'inv73-neutral':incomplete||partial?'inv73-warn':'inv73-good');
            byId('inv73-capture-time').textContent=captured?'Captured '+(meta.CAPTURED_AT||'')+' · APEX session collection'+(meta.CAPTURED_COMPANY_CODES?' · Company '+meta.CAPTURED_COMPANY_CODES:''):'';
            byId('inv73-report-source').textContent=captured?'On-hand source: '+(meta.REPORT_SOURCE_LABEL||(meta.SOURCE_MODE==='LEGACY'?'Previous valuation engine':'EBS Back Dated Inventory report'))+' · '+(meta.REPORT_ROW_COUNT==null?'':meta.REPORT_ROW_COUNT+' available report rows · ')+(meta.SOURCE_MODE==='LEGACY'?'Previous capture; run again to use the EBS report.':meta.REPORT_SOURCE_FRESHNESS||'Load time not recorded in the EBS reporting table.'):'On-hand source: EBS Back Dated Inventory report. Run to capture the selected scope.';
            document.querySelectorAll('[data-inv73-metric]').forEach(el=>{const key=el.dataset.inv73Metric,value=captured?meta[key+'_DISPLAY']:null;el.textContent=value==null?'—':String(value);byId('inv73-workflow').querySelector('[data-inv73-note="'+key+'"]').textContent=!captured?'Run to capture':value==null?'Unavailable · incomplete stock comparison':key==='ONHAND_VALUE'?'Full captured scope · stock only':key==='STOCK_GL_END_BALANCE'?'Same stock accounts · GL counted once':'Full captured scope · ledger currency';});
            const note=byId('inv73-capture-note');note.hidden=!captured||(!incomplete&&!partial);note.textContent=[missing?'No report rows for selected org(s): '+(meta.REPORT_MISSING_ORG_CODES||missing)+'. This is not assumed to mean zero stock. On-hand totals are unavailable; results are incomplete and provisional.':'',Number(meta.INCOMPLETE_ORG_COUNT||0)>0?meta.INCOMPLETE_ORG_COUNT+' selected org(s) have incomplete close data. Results are provisional.':'',partial?unavailableStockCount+' stock comparison(s) unavailable. Review each account reason.':''].filter(Boolean).join(' ');
            const seconds=value=>value==null?null:Number(value).toFixed(2)+'s';
            byId('inv73-step-times').textContent=[meta.CHECK_SECONDS!=null?'Last Check: '+seconds(meta.CHECK_SECONDS):'',meta.RUN_SECONDS!=null?'Captured Run: '+seconds(meta.RUN_SECONDS):''].filter(Boolean).join(' · ');
            const residuals=(data.exceptions||[]).filter(row=>row.EXCEPTION_TYPE==='DORMANT RESIDUAL WIP');
            byId('inv73-residual-details').hidden=!captured||!residuals.length;
            byId('inv73-residual-count').textContent=residuals.length+' excluded residual WIP item(s) · '+money(meta.EXCLUDED_RESIDUAL_WIP);
            byId('inv73-residual-list').innerHTML=residuals.map(row=>'<p><strong>'+esc(row.ORG_CODE)+'</strong> '+esc(row.ORG_NAME)+' · <span class="inv73-account">'+esc(row.ACCOUNT)+'</span> · WIP '+money(row.WIP_VALUE)+'<span class="inv73-orgname">'+esc(row.EXCLUSION_REASON||'Excluded from eligible OU scope')+'</span></p>').join('');
            controls();
            }
            function refreshReports() {opened.clear();showTab(activeTab,false);}
            function decorate() {document.querySelectorAll('.inv73-status').forEach(el=>{const code=el.dataset.inv73Code??el.textContent.trim(),field=el.dataset.inv73Field||'CLOSE_DATA_CHECK',wording=field==='ROW_TYPE'&&code==='ORG'&&el.closest('#inv73-report-transit')?{label:'Org valuation',detail:'This org\'s report value. There is no account total or GL allocation.',tone:'neutral'}:inv73ReportWording.describe(field,code);el.dataset.inv73Code=code;el.textContent=wording.label;el.title=wording.detail;el.setAttribute('aria-label',wording.label+'. '+wording.detail);el.className='inv73-status'+(['ROW_TYPE','ORG_CODE'].includes(field)?'':' inv73-badge inv73-'+wording.tone);});}
            function showTab(tab,focus) {
            activeTab=tabs.includes(tab)?tab:'stock';
            tabs.forEach(key=>{const el=byId('inv73-panel-'+key);if(el){el.hidden=key!==activeTab;el.setAttribute('role','tabpanel');el.setAttribute('aria-labelledby','inv73-tab-'+key);}byId('inv73-tab-'+key).setAttribute('aria-selected',String(key===activeTab));byId('inv73-tab-'+key).tabIndex=key===activeTab?0:-1;});
            if(focus)byId('inv73-tab-'+activeTab).focus();
            $(window).trigger('apexwindowresized');
            if(data.meta.CAPTURED_LEDGER_ID!=null&&!opened.has(activeTab)&&(activeTab==='stock'||data.meta[inv73DiagnosticKind(activeTab,wipView)+'_LOADED']==='Y')){opened.add(activeTab);if(activeTab==='stock')stock.refresh();else apex.region('inv73-report-'+activeTab).refresh();}
            }
            async function getState(resetSelection) {
            const response=await apex.server.process('P73_STATE',{}, {dataType:'json'});
            if(!response||response.ok!==true)throw Error(response&&response.message||'Unable to read the captured page state.');
            const nativeChanged=['P73_CAPTURE_COLL','P73_WIP_COLL','P73_INTRANSIT_COLL'].some((item,index)=>String(apex.item(item).getValue()||'')!==String([response.capture_collection,inv73DiagnosticPointer(response,wipView),response.intransit_collection][index]||'')),captureChanged=primaryPin!==String(response.primary_collection||'');
            primaryPin=String(response.primary_collection||'');
            if(captureChanged)tabs.forEach(tab=>{const region=byId('inv73-report-'+tab);if(region)region.style.visibility='hidden';});
            apex.item('P73_CAPTURE_COLL').setValue(response.capture_collection||'');
            apex.item('P73_WIP_COLL').setValue(inv73DiagnosticPointer(response,wipView));
            apex.item('P73_INTRANSIT_COLL').setValue(response.intransit_collection||'');
            data=response;
            const eligible=eligibleIds(),nextSelectionKey=matchingCheck()?String(data.token):'';
            if(resetSelection)selected=new Set(eligible);
            else if(nextSelectionKey!==selectionCheckKey&&matchingCheck()){selected=data.meta.CAPTURED_ORG_IDS&&data.meta.CAPTURED_ORG_IDS!=='ALL'&&String(data.meta.CAPTURED_LEDGER_ID)===ledger()&&data.meta.CAPTURED_PERIOD_NAME===period()&&String(data.meta.CAPTURED_OU_ID)===ou()?new Set(String(data.meta.CAPTURED_ORG_IDS).split(':').filter(id=>eligible.has(id))):new Set(eligible);}
            else selected=new Set([...selected].filter(id=>eligible.has(id)));
            selectionCheckKey=nextSelectionKey;
            renderReadiness();renderCapture();
            const stockChanged=stock.setSnapshot(primaryPin,response.onhand_orgs||[]);
            if(captureChanged)refreshReports();else if(nativeChanged){tabs.filter(tab=>tab!=='stock').forEach(tab=>opened.delete(tab));showTab(activeTab,false);}else if(stockChanged&&activeTab==='stock')stock.refresh();
            return captureChanged;
            }
            byId('inv73-check').addEventListener('click',async()=>{
            if(busy||!ledger()||!period()||!ou())return;
            setBusy(true,'check');message('Checking the cached org/period and account lookups, with live close-summary availability. Previous successful results remain available.');
            try {const response=await apex.server.process('P73_CHECK',{x01:ledger(),x02:period(),x03:ou()},{dataType:'json',timeout:0});if(!response||!response.ok)throw Error(response&&response.message||'Readiness check failed.');await getState(true);message('Eligible Inventory Orgs are ready for selection. Review account coverage warnings, then run reconciliation.');}
            catch(error){message((error.message||'Readiness check failed.')+' The previous successful check and reconciliation capture remain available.',true);}
            finally{setBusy(false);}
            });
            byId('inv73-refresh-lookup').addEventListener('click',async()=>{
            if(busy)return;
            setBusy(true,'lookup');message('Refreshing org/period and account lookups. The previous successful reconciliation capture remains available.');
            try {const response=await apex.server.process('P73_REFRESH_LOOKUP',{}, {dataType:'json',timeout:0});if(!response||!response.ok)throw Error(response&&response.message||'Org/period and account lookup refresh failed.');selected.clear();await getState(false);message('Org/period and account lookups refreshed. Select ledger, period, and OU, then Check Inventory Orgs before running.');}
            catch(error){message((error.message||'Org/period and account lookup refresh failed.')+' The previous successful check and reconciliation capture remain available.',true);}
            finally{setBusy(false);}
            });
            byId('inv73-run').addEventListener('click',async()=>{
            if(busy||!matchingCheck()||!selected.size||selectionGate().blocked)return;
            const runScope=scope();let published=false,confirmedFailure=false;setBusy(true,'run');message('Capturing EBS Back Dated Inventory and relevant GL balances for '+selected.size+' org(s). Previous results remain visible.');
            try {const response=await apex.server.process('P73_RUN',{x01:data.token,x02:ledger(),x03:period(),x04:runScope,x05:ou()},{dataType:'json',timeout:0});if(!response||response.ok!==true){confirmedFailure=Boolean(response&&response.ok===false);throw Error(response&&response.message||'The Run response could not be confirmed.');}published=true;apex.item('P73_CCID').setValue('');byId('inv73-account-context').hidden=true;const captureChanged=await getState(false);message('OU reconciliation capture completed. Review completeness and GL-scope labels before interpreting differences.');try{if(!captureChanged)refreshReports();}catch(error){message('Reconciliation capture completed, but a report could not refresh. Reload the page to view the successful capture.',true);}}
            catch(error){message(published?'Reconciliation capture completed, but the page could not reload its state. Reload the page to view the successful capture.':confirmedFailure?(error.message||'Reconciliation failed.')+' The previous successful capture remains available.':'Run could not be confirmed; reload to check the latest successful capture. The displayed results remain pinned to their original capture.',true);}
            finally{setBusy(false);}
            });
            $(document).on('click','[data-inv73-diagnostics]',async function(){
            if(busy||data.meta.CAPTURED_LEDGER_ID==null)return;
            const kind=this.dataset.inv73Diagnostics;if(!Object.hasOwn(inv73DiagnosticLabels,kind))return;
            setBusy(true,'diagnostics');message('Loading '+inv73DiagnosticLabels[kind]+' for the captured scope.'+(kind==='ACCOUNTING'?' This can take several minutes.':''));
            let published=false,failed=false;
            try{const response=await apex.server.process('P73_DIAGNOSTICS',{x01:kind}, {dataType:'json',timeout:0});if(!response||response.ok!==true){failed=Boolean(response&&response.ok===false);throw Error(response&&response.message||'Diagnostics response not confirmed.');}published=true;await getState(false);message(inv73DiagnosticLabels[kind]+' loaded. The on-hand capture is unchanged.');}
            catch(error){message(published?'Diagnostics completed; reload to display the successful state.':failed?(error.message||'Diagnostics failed.')+' Previous captures remain available.':'Diagnostics could not be confirmed. Reload to check the latest successful state.',true);}
            finally{setBusy(false);}
            });
            $(document).on('click','[data-inv73-wip-view]',function(){
            const next=this.dataset.inv73WipView;if(busy||!['WIP','WIP_ACTIVITY'].includes(next)||next===wipView)return;
            wipView=next;apex.item('P73_WIP_COLL').setValue(inv73DiagnosticPointer(data,wipView));opened.delete('wip');
            byId('inv73-report-wip').style.visibility='hidden';controls();if(activeTab==='wip')showTab('wip',false);
            });
            $('#P73_LEDGER_ID,#P73_PERIOD_NAME,#P73_OU_ID').on('change',()=>{if(busy)return;selected.clear();data.token='';selectionCheckKey='';message('');renderReadiness();renderCapture();});
            $(document).on('change','.inv73-org-check',function(){if(busy||!matchingCheck())return;selected=inv73PickerSelection.toggle(data.readiness,ou(),selected,this.value,this.checked);picker.announce(this.checked?'Selected the eligible active owner group.':'Removed the eligible active owner group.');renderReadiness();renderCapture();});
            $(document).on('click','[data-inv73-select]',function(){if(busy||!matchingCheck())return;const action=this.dataset.inv73Select;selected=inv73PickerSelection.bulk(data.readiness,ou(),action);picker.announce(action==='ready'?'Selected complete READY groups only. Groups with non-READY or unavailable active owners were left out.':action==='all'?'All eligible orgs selected. Review any blocked groups before Run.':'Selection cleared.');renderReadiness();renderCapture();});
            $(document).on('click','[data-inv73-include]',function(){if(busy||!matchingCheck())return;const group=ownersByAccount().find(g=>g.ccid===this.dataset.inv73Include);if(group)selected=inv73PickerSelection.include(data.readiness,ou(),selected,group.members.keys());renderReadiness();renderCapture();});
            $(document).on('click','[data-inv73-include-intransit]',function(){if(busy||!matchingCheck())return;selected=inv73PickerSelection.include(data.readiness,ou(),selected,inv73AssessOwnerScope(data.owners,selected).intransitMembers);renderReadiness();renderCapture();});
            $(document).on('click','[data-inv73-required-group]',function(){if(busy||!matchingCheck())return;const row=data.readiness.find(item=>orgId(item)===this.dataset.inv73RequiredGroup),eligible=eligibleIds();if(!row||row.OWNERSHIP_BLOCKED==='Y')return;const ids=String(row.OWNERSHIP_GROUP_IDS||'').split(':').filter(Boolean);if(!ids.length||!ids.every(id=>eligible.has(id)))return;ids.forEach(id=>selected.add(id));renderReadiness();renderCapture();});
            $(document).on('click','[data-inv73-deselect-blocked]',function(){if(busy||!matchingCheck())return;const remove=selectionGate().blockedSelectedIds;remove.forEach(id=>selected.delete(id));renderReadiness();renderCapture();message('Deselected '+remove.size+' org(s) from blocked ownership groups. Other selected orgs are unchanged.');});
            $(document).on('click','[data-inv73-tab]',function(){showTab(this.dataset.inv73Tab,false);});
            $(document).on('keydown','[data-inv73-tab]',function(event){if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;event.preventDefault();let index=tabs.indexOf(this.dataset.inv73Tab);index=event.key==='Home'?0:event.key==='End'?tabs.length-1:(index+(event.key==='ArrowRight'?1:tabs.length-1))%tabs.length;showTab(tabs[index],true);});
            tabs.filter(tab=>tab!=='stock').forEach(tab=>$('#inv73-report-'+tab).on('apexafterrefresh',function(){this.style.visibility='';decorate();}));
            showTab('stock',false);controls();
            getState(false).catch(error=>message(error.message,true));
            })();
            
            ```
    }
