            return '<tr><td><strong>'+esc(row.ORG_CODE)+'</strong><span class="inv73-orgname">'+esc(row.ORG_NAME)+'</span></td><td>'+badge(row.READINESS_STATUS,readinessKind(row.READINESS_STATUS))+'</td><td>'+ownershipCell(row)+'</td><td>'+esc(data.meta.CHECKED_PERIOD_NAME)+'<span class="inv73-orgname">'+esc(row.INV_STATUS)+'</span></td><td>'+esc(row.PRIOR_PERIOD_NAME||'Prior period')+'<span class="inv73-orgname">'+esc(row.PRIOR_INV_STATUS||'Unavailable')+'</span></td><td>Current: '+esc(row.CURRENT_SUMMARY)+'<span class="inv73-orgname">Prior: '+esc(row.PRIOR_SUMMARY)+'</span></td><td>'+esc(row.REASON)+(shares?'<span class="inv73-orgname">'+shares+' account coverage check(s)</span>':'')+'</td></tr>';
