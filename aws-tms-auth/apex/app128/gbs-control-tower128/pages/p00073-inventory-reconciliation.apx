            .inv73-owner-codes{max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.inv73-owner-detail{font-size:11px;margin-top:5px;max-width:170px}.inv73-owner-detail summary{cursor:pointer}.inv73-gate p{margin:7px 0;font-size:12px}.inv73-gate{border-left-color:#a31625}.inv73-table{min-width:930px}
            /* Stock-only comparison and local paginated Account > Org > Subinventory tree. */
            .inv73-picker{margin:15px 0;padding:16px;border:1px solid var(--ut-component-border-color,#ddd);border-radius:6px;background:var(--ut-region-background-color,#fff)}.inv73-picker-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.inv73-picker-head h2{font-size:18px;margin:0}.inv73-picker-chips{display:flex;flex-wrap:wrap;gap:7px;margin:12px 0}.inv73-picker-chip{display:inline-flex;align-items:center;gap:10px;max-width:100%;padding:7px 10px;min-height:36px;border:1px solid var(--ut-component-border-color,#ddd);border-radius:5px;background:var(--ut-component-background-color,#f5f6fa);color:var(--ut-body-text-color,#333);font:inherit;font-size:12px;text-align:left;cursor:pointer}.inv73-picker-chip span{font-size:17px;opacity:.7}.inv73-picker-menu{border:1px solid var(--ut-component-border-color,#ddd);border-radius:5px;padding:12px;margin-top:12px}.inv73-picker-search-label{display:block;font-size:12px;margin-bottom:5px}.inv73-picker-search{width:100%;min-height:40px;background:var(--ut-component-background-color,#fff);color:var(--ut-body-text-color,#333)}.inv73-picker-rows{max-height:320px;overflow:auto}.inv73-picker-row{display:flex;align-items:center;gap:12px;padding:11px 6px;min-height:48px;border-bottom:1px solid var(--ut-component-border-color,#ddd);cursor:pointer;font-size:13px}.inv73-picker-row:last-child{border-bottom:0}.inv73-picker-row:hover{background:var(--ut-component-background-color,#f5f6fa)}.inv73-picker-row input{width:18px;height:18px;flex:0 0 auto;margin:0;accent-color:var(--ut-palette-primary,#51449a)}.inv73-picker-row:focus-within{outline:2px solid var(--ut-palette-primary,#51449a);outline-offset:-2px}.inv73-picker-name{flex:1;min-width:0}.inv73-picker-secondary{display:block;font-size:11px;opacity:.8;margin-top:3px}.inv73-picker-blocker{color:var(--ut-palette-warning,#805613);opacity:1}.inv73-picker-empty{padding:15px 4px;font-size:12px}.inv73-picker-message{font-size:12px;min-height:18px;margin-