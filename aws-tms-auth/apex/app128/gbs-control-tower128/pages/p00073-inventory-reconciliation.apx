    region intransit-panel (
        name: Intransit Panel
        type: staticContent
        source {
            htmlCode: <div class="inv73-diagnostics"><strong data-inv73-diagnostics-status>Not loaded</strong><p data-inv73-diagnostics-basis></p><button type="button" class="t-Button" data-inv73-diagnostics>Load this view</button><span class="inv73-meta" data-inv73-diagnostics-time></span><p class="inv73-warning" data-inv73-diagnostics-availability hidden></p></div><details class="inv73-report-guide"><summary>How to read these rows</summary><p><strong>Org valuation</strong> is this Inventory Org's Total Cost from the EBS Back Dated Intransit report. Each row stands on its own; this view has no account-total rows. Transfer and export costs remain separate from Total Cost.</p><p><strong>Data availability</strong> tells you whether report rows and costs are available. No report rows is unavailable, not an assumed zero. The reporting table does not record its load time or completeness.</p><p><strong>GL is not included.</strong> The business report supplies no GL account, so GL cannot be allocated to these org values.</p></details>
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--hideHeader
            ]
            cssClasses: inv73-panel
        }
        advanced {
            htmlDomId: inv73-panel-transit
        }
    )

    region inventory-readiness-and-capture (
        name: Inventory Readiness and Capture
        type: staticContent
        source {
            htmlCode:
                ```html
                <div id="inv73-workflow">
                <div class="inv73-company"><strong>Company:</strong> <span id="inv73-company">Available after Check</span><span class="inv73-muted"> · configured account mapping</span></div>
                <details class="inv73-lookup-details"><summary>Org/period and account lookups</summary><div class="inv73-toolbar"><span id="inv73-lookup-context" class="inv73-meta">Refresh time is unavailable.</span><button type="button" class="t-Button t-Button--small inv73-push" id="inv73-refresh-lookup">Refresh Lookup</button></div></details>
                <div class="inv73-toolbar"><strong>1. Check Inventory Orgs</strong><span class="inv73-muted">One operating unit per run.</span><button type="button" class="t-Button t-Button--hot inv73-push" id="inv73-check">Check Inventory Orgs</button></div>
                <div id="inv73-operation" class="inv73-message" role="status" aria-live="polite" hidden></div>
                <div id="inv73-check-context" class="inv73-meta">Select a ledger, period, and operating unit, then check Inventory Orgs.</div>
                <section id="inv73-picker" class="inv73-picker" aria-label="Inventory Org selection" hidden>
                <div class="inv73-picker-head"><h2>Inventory Orgs</h2><span id="inv73-selection-count" class="inv73-muted" aria-live="polite"></span></div>
                <div id="inv73-picker-chips" class="inv73-picker-chips" aria-label="Selected Inventory Orgs"></div>
                <button type="button" class="t-Button t-Button--small" id="inv73-picker-toggle" aria-expanded="true" aria-controls="inv73-picker-menu">Close org picker</button>
                <div id="inv73-picker-menu" class="inv73-picker-menu">
                <label for="inv73-picker-search" class="inv73-picker-search-label">Search Inventory Orgs</label><input id="inv73-picker-search" type="search" class="apex-item-text inv73-picker-search" placeholder="Search org code or name" autocomplete="off" aria-controls="inv73-picker-rows">
                <div class="inv73-toolbar" id="inv73-selection-tools" hidden><button type="button" class="t-Button t-Button--small" data-inv73-select="all">All eligible</button><button type="button" class="t-Button t-Button--small" data-inv73-select="ready">READY only</button><button type="button" class="t-Button t-Button--small" data-inv73-select="none">Clear</button><span id="inv73-picker-matches" class="inv73-muted"></span></div>
                <div id="inv73-picker-rows" class="inv73-picker-rows"></div>
                </div><div id="inv73-picker-message" class="inv73-picker-message" role="status" aria-live="polite"></div>
                </section>
                <details id="inv73-readiness-details" class="inv73-readiness-details" hidden><summary>Readiness &amp; account details <span id="inv73-readiness-counts"></span></summary>
                <details id="inv73-excluded-details" class="inv73-excluded" hidden><summary><span id="inv73-excluded-count">Excluded organizations</span></summary><div id="inv73-excluded-list"></div></details>
                <div class="inv73-scroll"><table class="inv73-table" aria-label="Eligible Inventory organization readiness within the operating unit"><thead><tr><th>Inventory Org</th><th>Readiness</th><th>Account Ownership</th><th>Current Period</th><th>Prior Period</th><th>Close Summaries</th><th>Reason</th></tr></thead><tbody id="inv73-readiness"><tr><td colspan="7" class="inv73-empty">Check Inventory Orgs to see eligible organizations in this operating unit.</td></tr></tbody></table></div>
                <details class="inv73-shared" aria-label="Relevant valuation account warnings"><summary class="inv73-shared-header"><strong>Account coverage warnings</strong><span id="inv73-shared-count" class="inv73-badge inv73-neutral">Not checked</span></summary><div id="inv73-shared-list" class="inv73-empty">Relevant account warnings appear after Check and org selection.</div><div id="inv73-coverage" class="inv73-coverage"></div><div id="inv73-intransit-coverage" class="inv73-coverage"></div><div class="inv73-shared-foot">Only accounts relevant to selected orgs are shown. Owners outside this OU and excluded orgs remain part of the GL coverage assessment. They cannot be added to this run.</div></details>
                </details>
                <div id="inv73-selection-gate" class="inv73-message inv73-gate" role="alert" hidden></div>
                <div class="inv73-toolbar"><span id="inv73-run-note" class="inv73-muted">A matching readiness check and at least one eligible org are required.</span><button type="button" class="t-Button t-Button--hot inv73-push" id="inv73-run" disabled>Run Reconciliation</button><span id="inv73-timer" class="inv73-timer" aria-live="polite"></span></div>
                <div id="inv73-step-times" class="inv73-meta"></div>
                <div id="inv73-stale" class="inv73-message" role="status" hidden>Filters or org selection changed. These results remain the previous successful capture. Run again to replace them.</div>
                <div class="inv73-context"><strong id="inv73-capture-title">No reconciliation capture</strong><span id="inv73-capture-status" class="inv73-badge inv73-neutral">Not run</span><span id="inv73-capture-time" class="inv73-meta"></span></div>
                <p id="inv73-report-source" class="inv73-muted">On-hand source: EBS Back Dated Inventory report. Run reconciliation to capture the selected scope.</p>
                <div class="inv73-cards inv73-stock-cards">
                <div class="inv73-card"><span class="inv73-card-label">On-hand Valuation</span><span class="inv73-card-value" data-inv73-metric="ONHAND_VALUE">—</span><span class="inv73-card-note" data-inv73-note="ONHAND_VALUE">Run to capture</span></div>
                <div class="inv73-card"><span class="inv73-card-label">GL on the Same Stock Accounts</span><span class="inv73-card-value" data-inv73-metric="STOCK_GL_END_BALANCE">—</span><span class="inv73-card-note" data-inv73-note="STOCK_GL_END_BALANCE">Run to capture</span></div>
                <div class="inv73-card"><span class="inv73-card-label">On-hand Valuation − GL</span><span class="inv73-card-value" data-inv73-metric="ONHAND_VS_GL_DIFF">—</span><span class="inv73-card-note" data-inv73-note="ONHAND_VS_GL_DIFF">Run to capture</span></div>
                </div>
                <div id="inv73-capture-note" class="inv73-message" hidden></div>
                <details id="inv73-residual-details" class="inv73-excluded" hidden><summary><span id="inv73-residual-count">Excluded residual WIP</span></summary><div id="inv73-residual-list"></div></details>
                <div id="inv73-account-context" class="inv73-toolbar" hidden><strong>Organization Detail account:</strong><span id="inv73-account-name" class="inv73-account"></span><button type="button" class="t-Button t-Button--small" id="inv73-clear-account">Clear account filter</button></div>
                <div class="inv73-tabs" role="tablist" aria-label="Reconciliation balance basis"><button type="button" id="inv73-tab-stock" class="inv73-tab" role="tab" aria-selected="true" aria-controls="inv73-panel-stock" data-inv73-tab="stock">On-hand vs GL</button><button type="button" id="inv73-tab-wip" class="inv73-tab" role="tab" aria-selected="false" aria-controls="inv73-panel-wip" data-inv73-tab="wip">WIP</button><button type="button" id="inv73-tab-transit" class="inv73-tab" role="tab" aria-selected="false" aria-controls="inv73-panel-transit" data-inv73-tab="transit">Intransit</button><button type="button" id="inv73-tab-accounting" class="inv73-tab" role="tab" aria-selected="false" aria-controls="inv73-panel-accounting" data-inv73-tab="accounting">Cumulative Accounting</button></div>
                </div>
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--hideHeader
            ]
        }
        advanced {
            htmlDomId: inv73-controls
        }
    )

    region inventory-reconciliation (
