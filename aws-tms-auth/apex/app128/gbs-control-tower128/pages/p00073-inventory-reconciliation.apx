    region work-in-process-panel (
        name: Work in Process Panel
        type: staticContent
        source {
            htmlCode: <div role="group" aria-label="WIP view" class="inv73-wip-views"><button type="button" class="t-Button" data-inv73-wip-view="WIP" aria-pressed="true">Closing valuation</button><button type="button" class="t-Button" data-inv73-wip-view="WIP_ACTIVITY" aria-pressed="false">Monthly activity</button></div><div class="inv73-diagnostics"><strong data-inv73-diagnostics-status>Not loaded</strong><p data-inv73-diagnostics-basis></p><button type="button" class="t-Button" data-inv73-diagnostics>Load this view</button><span class="inv73-meta" data-inv73-diagnostics-time></span><p class="inv73-warning" data-inv73-diagnostics-availability hidden></p></div><details class="inv73-report-guide"><summary>How to read these rows</summary><p><strong>Closing valuation</strong> is the WIP balance through the selected Inventory period end. It requires closed Inventory and the required current close-summary data. <strong>Monthly activity</strong> is movement from the first through the last day of the selected month, following the business report filters; it is not the closing balance.</p><p><strong>Account total</strong> combines the selected Inventory Orgs. <strong>Org breakdown</strong> shows each org's contribution to that same amount. Do not add the total and breakdown together.</p><p><strong>Data availability</strong> describes availability or the monthly activity basis. <strong>GL is not included</strong> in either WIP view; these amounts are not standalone comparisons with GL.</p></details>
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--hideHeader
            ]
            cssClasses: inv73-panel
        }
        advanced {
            htmlDomId: inv73-panel-wip
        }
    )

