            document.querySelectorAll('[data-inv73-select],.inv73-org-check,[data-inv73-include],[data-inv73-include-intransit],[data-inv73-required-group],[data-inv73-deselect-blocked]').forEach(el=>el.disabled=busy || !checked);
            byId('inv73-selection-count').textContent=selected.size+' of '+eligibleRows().length+' eligible orgs selected';
            byId('inv73-run-note').textContent=checked?(gate.blocked?'Complete the required active-owner groups or deselect blocked groups before Run.':selected.size?'One OU only. Dormant references are not required; missing close data remains provisional.':'Select at least one eligible Inventory Org.'):'A matching ledger, period, and OU check is required.';
            const captured=data.meta.CAPTURED_LEDGER_ID != null;
            const stale=captured && (String(data.meta.CAPTURED_LEDGER_ID)!==ledger() || data.meta.CAPTURED_PERIOD_NAME!==period() || String(data.meta.CAPTURED_OU_ID)!==ou() || (checked && normalizeScope(scope())!==normalizeScope(data.meta.CAPTURED_ORG_IDS)));
            byId('inv73-stale').hidden=!stale;
            const banner=byId('inv73-selection-gate');banner.hidden=!checked||!gate.blocked;
            banner.innerHTML=checked&&gate.blocked?'<strong>Run blocked — active Inventory Org owners of shared valuation accounts must reconcile together.</strong>'+gate.problems.map(group=>'<p>'+esc([...new Set(group.selectedCodes)].join(', '))+' requires '+(group.invalid?'a fresh ownership check':group.permanentBlock?esc(group.blockerCodes||group.missing.map(row=>row.code+(row.reason?' ('+row.reason+')':'')).join(', ')):esc(group.missing.map(row=>row.code).join(', ')))+'. '+(group.permanentBlock?'This active-owner group includes an org outside the eligible OU scope. Deselect the whole group to run other orgs.':'Select the required group explicitly or deselect its selected members.')+'</p>').join('')+(gate.blockedSelectedIds.size?'<button type="button" class="t-Button t-Button--small" data-inv73-deselect-blocked '+(busy?'disabled':'')+'>Deselect blocked groups · '+gate.blockedSelectedIds.size+' selected org(s)</button>':''):'';
            }
            function ownershipCell(row){
            const dormant=row.OWNERSHIP_DORMANT_CODES?'<span class="inv73-orgname">Dormant: '+esc(row.OWNERSHIP_DORMANT_CODES)+' · not required</span>':'';
