page 10 (
    name: General Ledger
    alias: GENERAL-LEDGER
    title: General Ledger
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @tms-application-access
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filters (
        name: Filters
        title: Filters
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region gl-readiness (
        name: GL Readiness
        title: GL Readiness
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ledger_id,
                       ledger_name,
                       period_name,
                       period_status_description,
                       unposted_due_headers,
                       error_status_headers,
                       unbalanced_due_batches,
                       interface_row_count,
                       earliest_unposted_due_date,
                       latest_unposted_due_date,
                       refresh_timestamp
                FROM   TABLE(
                           xxme_gl_summary_pkg.get_summary(:P10_PERIOD_NAME, :P10_DB_LINK)
                       )
                ORDER BY ledger_id
                ```
            pageItemsToSubmit: [
                P10_PERIOD_NAME
                P10_DB_LINK
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound:
                ```
                <div class="t-Alert t-Alert--success t-Alert--horizontal">
                  <div class="t-Alert-wrap">
                    <div class="t-Alert-icon">
                      <span class="t-Icon fa fa-check-circle" aria-hidden="true"></span>
                    </div>
                    <div class="t-Alert-content">
                      <div class="t-Alert-header">
                        <h2 class="t-Alert-title">No GL readiness issues found</h2>
                      </div>
                      <div class="t-Alert-body">
                        No General Ledger readiness issues were found for the selected period and ledger scope.
                      </div>
                    </div>
                  </div>
                </div>
                ```
        }
        advanced {
            savedReportMappingIdentifier: 15243277752408605
        }

        column EARLIEST_UNPOSTED_DUE_DATE (
            type: plainText
            heading {
                heading: Oldest Unposted Journal Date
            }
            layout {
                sequence: 130
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: M
            }
        )

        column ERROR_STATUS_HEADERS (
            type: plainText
            heading {
                heading: Journals in Error/Other Status
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column INTERFACE_ROW_COUNT (
            type: plainText
            heading {
                heading: Interface Transactions
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column LATEST_UNPOSTED_DUE_DATE (
            type: plainText
            heading {
                heading: Newest Unposted Journal Date
            }
            layout {
                sequence: 140
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: N
            }
        )

        column LEDGER_ID (
            type: hidden
            heading {
                heading: Ledger Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column LEDGER_NAME (
            type: plainText
            heading {
                heading: Ledger Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column PERIOD_NAME (
            type: plainText
            heading {
                heading: Period Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column PERIOD_STATUS_DESCRIPTION (
            type: plainText
            heading {
                heading: Period Status
            }
            layout {
                sequence: 50
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column REFRESH_TIMESTAMP (
            type: hidden
            heading {
                heading: Refresh Timestamp
            }
            layout {
                sequence: 170
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: Q
            }
        )

        column UNBALANCED_DUE_BATCHES (
            type: plainText
            heading {
                heading: Batches Out of Balance
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column UNPOSTED_DUE_HEADERS (
            type: plainText
            heading {
                heading: Unposted Journals
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: GL Readiness
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EARLIEST_UNPOSTED_DUE_DATE (
                sequence: 9
            )

            displayColumn ERROR_STATUS_HEADERS (
                sequence: 6
            )

            displayColumn INTERFACE_ROW_COUNT (
                sequence: 8
            )

            displayColumn LATEST_UNPOSTED_DUE_DATE (
                sequence: 10
            )

            displayColumn LEDGER_ID (
                sequence: 1
            )

            displayColumn LEDGER_NAME (
                sequence: 2
            )

            displayColumn PERIOD_NAME (
                sequence: 3
            )

            displayColumn PERIOD_STATUS_DESCRIPTION (
                sequence: 4
            )

            displayColumn REFRESH_TIMESTAMP (
                sequence: 11
            )

            displayColumn UNBALANCED_DUE_BATCHES (
                sequence: 7
            )

            displayColumn UNPOSTED_DUE_HEADERS (
                sequence: 5
            )

        )

    )

    pageItem P10_DB_LINK (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @filters
            slot: regionBody
        }
        default {
            type: static
            staticValue: ADG
        }
    )

    pageItem P10_GL_UNPOSTED_URL (
        type: hidden
        layout {
            sequence: 40
            slot: body
        }
    )

    pageItem P10_PERIOD_NAME (
        type: selectList
        label {
            label: Accounting Period
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @tms-close-periods
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filters
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select upper(to_char(trunc(sysdate - 7, 'MM'), 'MON-YYYY', 'NLS_DATE_LANGUAGE=English'))
                from dual
                ```
        }
    )

    button back-to-dashboard (
        buttonName: BACK_TO_DASHBOARD
        label: Close
        layout {
            sequence: 30
            region: @filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-arrow-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh-gl (
        buttonName: REFRESH_GL
        label: Refresh
        layout {
            sequence: 20
            region: @filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button view-unposted-journals (
        buttonName: VIEW_UNPOSTED_JOURNALS
        label: View Unposted Journals
        layout {
            sequence: 10
            region: @filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-book-open
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction close (
        name: Close
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @back-to-dashboard
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.close();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction open-unposted-journals (
        name: Open Unposted Journals
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @view-unposted-journals
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :P10_GL_UNPOSTED_URL := apex_page.get_url(
                        p_page        => 11,
                        p_clear_cache => '11',
                        p_items       => 'P11_PERIOD_NAME,P11_DB_LINK',
                        p_values      => :P10_PERIOD_NAME || ',' || :P10_DB_LINK
                    );
                    ```
                itemsToSubmit: [
                    P10_PERIOD_NAME
                    P10_DB_LINK
                ]
                itemsToReturn: P10_GL_UNPOSTED_URL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.navigation.openInNewWindow(
                        $v("P10_GL_UNPOSTED_URL"),
                        "tms_gl_unposted"
                    );
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-gl-report (
        name: Refresh GL Report
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh-gl
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @gl-readiness
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

