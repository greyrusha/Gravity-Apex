page 11 (
    name: GL Unposted Journals
    alias: GL-UNPOSTED-JOURNALS
    title: GL Unposted Journals
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            .xxme-status {
                display: inline-block;
                min-width: 105px;
                padding: 4px 10px;
                border-radius: 12px;
                color: #fff;
                font-size: 0.75rem;
                font-weight: 700;
                line-height: 1.2;
                text-align: center;
                white-space: nowrap;
                letter-spacing: 0.02em;
            }
            
            .xxme-status-RED {
                background-color: #c62828;
            }
            
            .xxme-status-AMBER {
                background-color: #d98200;
            }
            
            .xxme-status-GREEN {
                background-color: #2e7d32;
            }
            
            .xxme-status-INFORMATIONAL {
                background-color: #287c96;
            }
            ```
    }
    security {
        authorizationScheme: @tms-application-access
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filters (
        name: Filters
        title: Filters
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region interactive-report-ai-notice (
        name: Interactive Report AI Notice
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="t-Alert t-Alert--info t-Alert--horizontal" role="note">
                  <div class="t-Alert-wrap">
                    <div class="t-Alert-icon">
                      <span class="t-Icon fa fa-info-circle" aria-hidden="true"></span>
                    </div>
                    <div class="t-Alert-content">
                      AI Assistant available: Use it to filter, sort, summarize, and create informational charts from this report. It cannot update data, and AI-generated charts are not drillable. Verify important conclusions against the report rows.
                    </div>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @feature-ai
        }
    )

    region unposted-journals (
        name: Unposted Journals
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ledger_id,
                       ledger_name,
                       period_name,
                       je_header_id,
                       je_batch_id,
                       batch_name,
                       journal_name,
                       journal_source,
                       journal_category,
                       effective_date,
                       currency_code,
                       journal_entered_dr,
                       journal_entered_cr,
                       ledger_currency_code,
                       journal_accounted_dr,
                       journal_accounted_cr,
                       ABS(NVL(journal_accounted_dr, 0)
                         - NVL(journal_accounted_cr, 0)) AS accounted_difference,
                       balance_type,
                       journal_description,
                       batch_description,
                       batch_balance_status,
                       severity,
                       refresh_timestamp
                FROM   TABLE(
                           xxme_gl_unposted_pkg.get_journals(:P11_PERIOD_NAME, :P11_DB_LINK)
                       )
                ORDER BY ledger_id,
                         effective_date,
                         batch_name,
                         journal_name
                ```
            pageItemsToSubmit: [
                P11_PERIOD_NAME
                P11_DB_LINK
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound:
                ```
                <div class="t-Alert t-Alert--success t-Alert--horizontal">
                  <div class="t-Alert-wrap">
                    <div class="t-Alert-content">
                      <div class="t-Alert-title">No unposted journals found</div>
                      <div class="t-Alert-body">
                        No unposted GL journals were found for the selected period and approved ledger scope.
                      </div>
                    </div>
                  </div>
                </div>
                ```
        }
        advanced {
            savedReportMappingIdentifier: 17490962108304104
        }

