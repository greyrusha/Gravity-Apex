    pageItem P11_DB_LINK (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @filters
            slot: regionBody
        }
        default {
            type: static
            staticValue: ADG
        }
    )

    pageItem P11_PERIOD_NAME (
        type: selectList
        label {
            label: Accounting Period
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @tms-close-periods
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filters
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select upper(to_char(trunc(sysdate - 7, 'MM'), 'MON-YYYY', 'NLS_DATE_LANGUAGE=English'))
                from dual
                ```
        }
    )

    button back-to-dashboard (
        buttonName: BACK_TO_DASHBOARD
        label: Close
        layout {
            sequence: 20
            region: @filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-arrow-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh-gl (
        buttonName: REFRESH_GL
        label: Refresh
        layout {
            sequence: 20
            region: @filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction close (
        name: Close
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @back-to-dashboard
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.close();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @refresh-gl
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @unposted-journals
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

