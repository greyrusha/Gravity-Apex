    button prepare-km-candidate (
        buttonName: PREPARE_CANDIDATE
        label: Prepare Candidate
        layout {
            sequence: 10
            region: @km-candidate-readiness
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-cogs
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button publish-km-revision (
        buttonName: PUBLISH_REVISION
        label: Publish Revision
        layout {
            sequence: 30
            region: @km-candidate-readiness
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Publish this tested revision and atomically replace the active retrieval representation?
            style: warning
        }
    )

    button run-km-test (
        buttonName: RUN_TEST
        label: Run and Save Test
        layout {
            sequence: 20
            region: @km-run-representative-test
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-play
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process prepare-knowledge-candidate (
        name: Prepare Knowledge Candidate
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare l_count number;
                begin
                  raise_application_error(-20200,'AI administration is disabled pending App 400 role integration.');
                  select count(*) into l_count from xxme_ai_km_revisions where revision_id=:P98_REVISION_ID and item_id=:P98_ITEM_ID;
                  if l_count<>1 then raise_application_error(-20205,'The selected revision does not belong to this knowledge item.'); end if;
                  xxme_ai_km_pkg.prepare_revision(:P98_REVISION_ID);
                  commit;
                  apex_application.g_print_success_message:='Candidate validated, chunked, and embedded.';
                end;
                ```
        }
        execution {
            sequence: 10
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 1014353499250103268
        }
        serverSideCondition {
            whenButtonPressed: @prepare-km-candidate
        }
    )

    process publish-tested-knowledge-revision (
        name: Publish Tested Knowledge Revision
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare l_count number;
                begin
                  raise_application_error(-20204,'AI administration is disabled pending App 400 role integration.');
                  select count(*) into l_count from xxme_ai_km_revisions where revision_id=:P98_REVISION_ID and item_id=:P98_ITEM_ID;
                  if l_count<>1 then raise_application_error(-20205,'The selected revision does not belong to this knowledge item.'); end if;
                  xxme_ai_km_pkg.publish_revision(:P98_REVISION_ID);
                  commit;
                  apex_application.g_print_success_message:='Knowledge revision published and activated.';
                end;
                ```
        }
        execution {
            sequence: 30
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 1014353499250103270
        }
        serverSideCondition {
            whenButtonPressed: @publish-km-revision
        }
    )

    process run-persisted-knowledge-test (
        name: Run Persisted Knowledge Test
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare l_test_id number; l_count number;
                begin
                  raise_application_error(-20201,'AI administration is disabled pending App 400 role integration.');
                  select count(*) into l_count from xxme_ai_km_revisions where revision_id=:P98_REVISION_ID and item_id=:P98_ITEM_ID;
                  if l_count<>1 then raise_application_error(-20205,'The selected revision does not belong to this knowledge item.'); end if;
                  if :P98_QUESTION is null or :P98_EXPECTED_TEXT is null then raise_application_error(-20202,'Question and expected outcome are required.'); end if;
                  if to_number(:P98_TOP_K default null on conversion error) not between 1 and 12 then raise_application_error(-20203,'Top Results must be from 1 through 12.'); end if;
                  xxme_ai_km_pkg.run_revision_test(
                    p_revision_id=>:P98_REVISION_ID, p_question=>:P98_QUESTION,
                    p_expected_text=>:P98_EXPECTED_TEXT, p_is_required=>:P98_IS_REQUIRED,
                    p_top_k=>to_number(:P98_TOP_K), p_test_id=>l_test_id);
                  commit;
                  apex_application.g_print_success_message:='Test '||l_test_id||' completed and saved.';
                end;
                ```
        }
        execution {
            sequence: 20
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 1014353499250103269
        }
        serverSideCondition {
            whenButtonPressed: @run-km-test
        }
    )

)

