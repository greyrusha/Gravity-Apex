    region km-run-representative-test (
        name: Run Representative Test
        title: Run Representative Test
        type: staticContent
        source {
            htmlCode: <p>Ask a representative question and record the expected human-readable outcome. Required tests gate publication.</p>
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P98_EXPECTED_TEXT (
        type: textarea
        label {
            label: Expected Human-readable Outcome
            alignment: left
        }
        layout {
            sequence: 20
            region: @km-run-representative-test
            slot: regionBody
            alignment: left
        }
        appearance {
            template: 1672985690212569356
            templateOptions: #DEFAULT#
            width: 80
            height: 4
        }
        validation {
            valueRequired: true
            maxLength: 1000
        }
    )

