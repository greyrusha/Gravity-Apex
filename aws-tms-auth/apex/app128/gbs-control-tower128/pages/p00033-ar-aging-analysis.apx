    region customer-aging-summary (
        name: Customer Aging Summary
        title: Customer Aging Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select customer_id,max(customer_number) customer_number,max(customer_name) customer_name,
                 sum(case when bucket_sequence=1 then accounted_balance_asof else 0 end) bucket_1_amount,
                 sum(case when bucket_sequence=2 then accounted_balance_asof else 0 end) bucket_2_amount,
                 sum(case when bucket_sequence=3 then accounted_balance_asof else 0 end) bucket_3_amount,
                 sum(case when bucket_sequence=4 then accounted_balance_asof else 0 end) bucket_4_amount,
                 sum(case when bucket_sequence=5 then accounted_balance_asof else 0 end) bucket_5_amount,
                 sum(case when bucket_sequence=6 then accounted_balance_asof else 0 end) bucket_6_amount,
                 sum(case when bucket_sequence=7 then accounted_balance_asof else 0 end) bucket_7_amount,
                 sum(accounted_balance_asof) total_amount,
                 sum(case when control_account_flag='N' then accounted_balance_asof else 0 end) control_exception_amount,
                 count(*) schedule_count
                 from xxme_ar_recon_v2_snap
                 where :P33_SNAPSHOT_READY='Y' and db_link_name=:P33_DB_LINK and ledger_id=to_number(:P33_LEDGER_ID)
                   and company_segment=:P33_COMPANY and period_name=:P33_PERIOD_NAME and aging_bucket_id=to_number(:P33_AGING_BUCKET_ID)
                 group by customer_id
                ```
            pageItemsToSubmit: [
                P33_SNAPSHOT_READY
                P33_DB_LINK
                P33_LEDGER_ID
                P33_COMPANY
                P33_PERIOD_NAME
                P33_AGING_BUCKET_ID
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: customer-aging-summary
        }
        serverSideCondition {
            type: item=value
            item: P33_SNAPSHOT_READY
            value: Y
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No customers are available for the selected snapshot.
        }
        advanced {
            savedReportMappingIdentifier: 933160000000686645
        }

        column BUCKET_1_AMOUNT (
            type: link
            heading {
                heading: &P33_BUCKET_1_LABEL.
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            link {
                target: {
                    type: url
                    url: javascript:p33Controller.drill(#CUSTOMER_ID#,'1','','#CUSTOMER_NAME!JS#','#CUSTOMER_NUMBER!JS#');
                }
                linkText: #BUCKET_1_AMOUNT#
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column BUCKET_2_AMOUNT (
            type: link
            heading {
                heading: &P33_BUCKET_2_LABEL.
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            link {
                target: {
                    type: url
                    url: javascript:p33Controller.drill(#CUSTOMER_ID#,'2','','#CUSTOMER_NAME!JS#','#CUSTOMER_NUMBER!JS#');
