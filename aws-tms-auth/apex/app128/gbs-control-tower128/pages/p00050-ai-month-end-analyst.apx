    region conversation-history (
        name: Conversation History
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select seq_id,
                       case c001
                           when 'user' then nvl(c003, :APP_USER)
                           else 'Month-End Analyst'
                       end as user_name,
                       case c001
                           when 'user' then 'fa-user'
                           else 'fa-comments'
                       end as user_icon,
                       apex_markdown.to_html(
                           p_markdown => clob001
                       ) as comment_text,
                       case
                           when c001 = 'user' then
                               to_char(d001, 'YYYY-MM-DD HH24:MI:SS')
                           when previous_role = 'user' then
                               to_char(d001, 'YYYY-MM-DD HH24:MI:SS')
                               || ' • '
                               || round((d001 - previous_date) * 86400)
                               || ' sec'
                           else
                               to_char(d001, 'YYYY-MM-DD HH24:MI:SS')
                       end as comment_date,
                       null as actions,
                       null as attribute_1,
                       null as attribute_2,
                       null as attribute_3,
                       null as attribute_4,
                       null as comment_modifiers,
                       case c001
                           when 'user' then 'u-color-8'
                           else 'u-color-4'
                       end as icon_modifier,
                       c001 as message_role,
                       c002 as period_name
                  from (
                        select c.*,
                               lag(d001) over (order by seq_id) as previous_date,
                               lag(c001) over (order by seq_id) as previous_role
                          from apex_collections c
                         where collection_name = 'XXME_AI_CHAT_HISTORY'
                       )
                 order by seq_id
                ```
        }
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/comments
            templateOptions: [
                #DEFAULT#
                t-Comments--chat
            ]
        }
        pagination {
            type: showAll
        }

