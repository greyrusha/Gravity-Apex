    process p34-get-ai-url (
        name: P34_GET_AI_URL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare l_count number; l_asof date; l_url varchar2(32767);
                begin
                 if :P34_REPORT_READY<>'Y' or :P34_DB_LINK not in ('ADG') or not regexp_like(:P34_PERIOD_NAME,'^[A-Z0-9 _./-]{1,30}$') or not regexp_like(:P34_LEDGER_ID,'^[0-9]{1,18}$') or not regexp_like(:P34_COMPANY,'^[A-Z0-9_.-]{1,25}$') or not regexp_like(:P34_AGING_BUCKET_ID,'^[0-9]{1,18}$') then raise_application_error(-20339,'Invalid GL/AR reconciliation context.'); end if;
                 if not apex_collection.collection_exists('P34_GL_AR_RECON') then raise_application_error(-20340,'Run GL/AR reconciliation before opening the AI Analyst.'); end if;
                 select count(*) into l_count from apex_collections where collection_name='P34_GL_AR_RECON';
                 if l_count=0 then raise_application_error(-20341,'The GL/AR reconciliation has no rows to analyze.'); end if;
                 select max(as_of_date) into l_asof from xxme_ar_recon_v2_snap where db_link_name=:P34_DB_LINK and ledger_id=to_number(:P34_LEDGER_ID) and company_segment=:P34_COMPANY and period_name=:P34_PERIOD_NAME and aging_bucket_id=to_number(:P34_AGING_BUCKET_ID);
                 l_url:=apex_page.get_url(p_page=>50,p_clear_cache=>'50',p_items=>'P50_DB_LINK,P50_PERIOD_NAME,P50_AR_SCOPE_AS_OF_DATE,P50_AR_LEDGER_ID,P50_AR_COMPANY,P50_AR_AGING_BUCKET_ID,P50_AR_SOURCE_PAGE,P50_AR_RECON_READY',p_values=>:P34_DB_LINK||','||:P34_PERIOD_NAME||','||to_char(l_asof,'YYYY-MM-DD')||','||:P34_LEDGER_ID||','||:P34_COMPANY||','||:P34_AGING_BUCKET_ID||',34,Y');
                 apex_json.open_object;apex_json.write('ok',true);apex_json.write('url',l_url);apex_json.close_object;
                exception when others then apex_json.open_object;apex_json.write('ok',false);apex_json.write('message',case when sqlcode between -20999 and -20000 then substr(sqlerrm,12) else 'Unable to prepare the AI Analyst URL.' end);apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 934160000000686107
        }
        config {
            buildOption: @feature-ai
        }
    )

    process p34-run-recon (
        name: P34_RUN_RECON
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare l_count number:=0;l_out number:=0;l_ar number:=0;l_gl number:=0;l_var number:=0;
                begin
                 apex_region.reset(p_page_id=>34,p_static_id=>'gl-ar-recon-report');
                 if apex_collection.collection_exists('P34_GL_AR_RECON') then apex_collection.truncate_collection('P34_GL_AR_RECON');else apex_collection.create_collection('P34_GL_AR_RECON');end if;
                 for r in(select * from table(xxme_ar_recon_v2_pkg.get_gl_reconciliation(:P34_DB_LINK,to_number(:P34_LEDGER_ID),:P34_COMPANY,:P34_PERIOD_NAME,to_number(:P34_AGING_BUCKET_ID))) where abs(nvl(ar_open_accounted_amount,0))>=0.005) loop
                  apex_collection.add_member(p_collection_name=>'P34_GL_AR_RECON',p_c001=>r.account_segments,p_c002=>r.natural_account,p_c003=>to_char(r.ar_loaded_at,'DD-MON-YYYY HH24:MI:SS'),p_c004=>to_char(r.gl_retrieved_at,'DD-MON-YYYY HH24:MI:SS'),p_c005=>to_char(r.variance_amount,'TM9','NLS_NUMERIC_CHARACTERS=''.,'''),p_c006=>to_char(r.ar_not_transferred_amount,'TM9','NLS_NUMERIC_CHARACTERS=''.,'''),p_c007=>to_char(r.gl_period_receivables_activity,'TM9','NLS_NUMERIC_CHARACTERS=''.,'''),p_c008=>to_char(r.gl_period_revaluation_activity,'TM9','NLS_NUMERIC_CHARACTERS=''.,'''),p_c009=>to_char(r.gl_period_non_receivables_activity,'TM9','NLS_NUMERIC_CHARACTERS=''.,'''),p_n001=>r.receivable_ccid,p_n002=>r.ar_open_accounted_amount,p_n003=>r.gl_beginning_balance,p_n004=>r.gl_period_net,p_n005=>r.gl_ending_balance);
                  l_count:=l_count+1;l_ar:=l_ar+nvl(r.ar_open_accounted_amount,0);l_gl:=l_gl+nvl(r.gl_ending_balance,0);l_var:=l_var+nvl(r.variance_amount,0);if abs(nvl(r.variance_amount,0))>=0.01 then l_out:=l_out+1;end if;
                 end loop;
                 apex_json.open_object;apex_json.write('ok',true);apex_json.open_object('summary');apex_json.write('account_count',to_char(l_count,'FM999G999G990'));apex_json.write('out_of_balance',to_char(l_out,'FM999G999G990'));apex_json.write('ar_total',to_char(l_ar,'FM999G999G999G990D00'));apex_json.write('gl_total',to_char(l_gl,'FM999G999G999G990D00'));apex_json.write('variance_total',to_char(l_var,'FM999G999G999G990D00'));apex_json.close_object;apex_json.close_object;
                exception when others then if apex_collection.collection_exists('P34_GL_AR_RECON') then apex_collection.delete_collection('P34_GL_AR_RECON');end if;apex_json.open_object;apex_json.write('ok',false);apex_json.write('message',case when sqlcode between -20999 and -20000 then substr(sqlerrm,12) else 'Unable to run GL/AR reconciliation. Check the APEX debug log.' end);apex_json.close_object;end;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 934160000000686106
        }
    )

    process validate-reconciliation-context (
        name: Validate Reconciliation Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare l_count number;l_by varchar2(128);l_on timestamp;l_asof date;
                begin :P34_BACK_URL:=apex_page.get_url(p_page=>32,p_clear_cache=>'32');:P34_CONTEXT_READY:='N';:P34_REPORT_READY:='N';
                 if apex_collection.collection_exists('P34_GL_AR_RECON') then apex_collection.delete_collection('P34_GL_AR_RECON');end if;
                 :P34_DB_LINK:=upper(trim(:P34_DB_LINK));:P34_PERIOD_NAME:=upper(trim(:P34_PERIOD_NAME));:P34_COMPANY:=upper(trim(:P34_COMPANY));
                 if :P34_DB_LINK not in ('ADG') or not regexp_like(:P34_PERIOD_NAME,'^[A-Z0-9 _./-]{1,30}$') or not regexp_like(:P34_LEDGER_ID,'^[0-9]{1,18}$') or not regexp_like(:P34_COMPANY,'^[A-Z0-9_.-]{1,25}$') or not regexp_like(:P34_AGING_BUCKET_ID,'^[0-9]{1,18}$') then apex_error.add_error(p_message=>'Select an available AR snapshot on Page 32 before opening reconciliation.',p_display_location=>apex_error.c_inline_in_notification);return;end if;
                 select count(*),max(loaded_by),max(loaded_at),max(as_of_date) into l_count,l_by,l_on,l_asof from xxme_ar_recon_v2_snap where db_link_name=:P34_DB_LINK and ledger_id=to_number(:P34_LEDGER_ID) and company_segment=:P34_COMPANY and period_name=:P34_PERIOD_NAME and aging_bucket_id=to_number(:P34_AGING_BUCKET_ID);
                 :P34_AS_OF_DATE:=to_char(l_asof,'DD-MON-YYYY');:P34_GENERATED_ON:=to_char(l_on,'DD-MON-YYYY HH24:MI:SS');:P34_GENERATED_BY:=l_by;:P34_ROW_COUNT:=to_char(l_count,'FM999G999G999G990');
                 if l_count>0 then :P34_CONTEXT_READY:='Y';else apex_error.add_error(p_message=>'The selected AR snapshot is no longer available. Return to Page 32 and run it again.',p_display_location=>apex_error.c_inline_in_notification);end if;
                exception when others then :P34_CONTEXT_READY:='N';apex_error.add_error(p_message=>'Unable to validate the AR snapshot context. Check the APEX debug log.',p_display_location=>apex_error.c_inline_in_notification);end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 934160000000686105
        }
    )

)

