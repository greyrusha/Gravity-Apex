                rowsPerPage: 50
            }

            displayColumn AR_LOADED_AT (
                sequence: 12
            )

            displayColumn AR_NOT_TRANSFERRED_AMOUNT (
                sequence: 11
            )

            displayColumn AR_OPEN_ACCOUNTED_AMOUNT (
                sequence: 3
