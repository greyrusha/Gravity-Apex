            displayColumn GL_ENDING_BALANCE (
                sequence: 8
            )

            displayColumn GL_PERIOD_NON_RECEIVABLES_ACTIVITY (
                sequence: 7
            )

            displayColumn GL_PERIOD_RECEIVABLES_ACTIVITY (
                sequence: 5
            )

            displayColumn GL_PERIOD_REVALUATION_ACTIVITY (
                sequence: 6
            )

            displayColumn GL_RETRIEVED_AT (
                sequence: 13
            )

            displayColumn NATURAL_ACCOUNT (
                sequence: 2
            )

            displayColumn RECEIVABLE_ACCOUNT (
                sequence: 1
            )

            displayColumn STATUS (
                sequence: 10
            )

            displayColumn VARIANCE_AMOUNT (
                sequence: 9
            )

            sort (
                column: VARIANCE_AMOUNT
                sort {
                    direction: desc
                    sequence: 1
                }
            )

        )

    )

    region interactive-report-ai-notice (
        name: Interactive Report AI Notice
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="t-Alert t-Alert--info t-Alert--horizontal" role="note">
                  <div class="t-Alert-wrap">
                    <div class="t-Alert-icon">
                      <span class="t-Icon fa fa-info-circle" aria-hidden="true"></span>
                    </div>
                    <div class="t-Alert-content">
                      AI Assistant available: Use it to filter, sort, summarize, and create informational charts from this report. It cannot update data, and AI-generated charts are not drillable. Verify important conclusions against the report rows.
                    </div>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        config {
            buildOption: @feature-ai
        }
    )

    region recon-context (
        name: Reconciliation Context
        title: GL/AR Reconciliation Context
        type: staticContent
        source {
            htmlCode: <p>Reconcile the selected local AR snapshot to TMS GL receivable control-account balances for the same ledger, company, and period.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: recon-context
        }
    )

    region recon-customer-detail (
        name: Receivable Account Detail
        title: AR Open Items for Selected Receivable Account
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select customer_name,customer_number,class_code,trx_number,trx_date,due_date,days_past_due,bucket_heading,currency_code,entered_balance_asof,accounted_balance_asof,
                 case control_account_flag when 'Y' then '<span class="p34-control-ok">Control Account</span>' else '<span class="p34-control-exception">Outside Control Account</span>' end control_account_status,
                 payment_schedule_id,customer_id,customer_trx_id,receivable_ccid,org_id,bucket_sequence,control_account_flag
                 from xxme_ar_recon_v2_snap where :P34_REPORT_READY='Y' and db_link_name=:P34_DB_LINK and ledger_id=to_number(:P34_LEDGER_ID) and company_segment=:P34_COMPANY and period_name=:P34_PERIOD_NAME and aging_bucket_id=to_number(:P34_AGING_BUCKET_ID) and receivable_ccid=to_number(:P34_SELECTED_CCID)
                ```
            pageItemsToSubmit: [
                P34_REPORT_READY
                P34_DB_LINK
                P34_LEDGER_ID
                P34_COMPANY
                P34_PERIOD_NAME
                P34_AGING_BUCKET_ID
                P34_SELECTED_CCID
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: recon-customer-detail
        }
        serverSideCondition {
            type: item=value
            item: P34_CONTEXT_READY
            value: Y
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No AR open items were found for the selected receivable account.
        }
        advanced {
            savedReportMappingIdentifier: 934160000000686655
        }

