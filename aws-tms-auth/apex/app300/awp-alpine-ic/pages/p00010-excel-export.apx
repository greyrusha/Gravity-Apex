page 10 (
    name: Excel Export
    alias: EXCEL-EXPORT
    title: Excel Export
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @tms-application-access
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region excel-export (
        name: Excel Export
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select *
                  from xx_ic_markup_user_review_v
                 where ebs_instance_code = :P10_EBS_INSTANCE
                   and (:P10_UNIT_STATUS = 'BOTH'
                        or sold_yes_no = case :P10_UNIT_STATUS
                                           when 'SOLD' then 'YES'
                                           when 'UNSOLD' then 'NO'
                                         end)
                ```
            pageItemsToSubmit: [
                P10_EBS_INSTANCE
                P10_UNIT_STATUS
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 32871855436157462
        }

