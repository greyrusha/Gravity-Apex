    pageItem P10_EBS_INSTANCE (
        type: hidden
        layout {
            sequence: 10
            region: @excel-export
            slot: regionBody
        }
        default {
            type: static
            staticValue: PTRXI
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P10_UNIT_STATUS (
        type: selectList
        label {
            label: Units
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Unsold;UNSOLD,Sold;SOLD,Both;BOTH
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @excel-export
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: UNSOLD
        }
    )

    button apply-filters (
        buttonName: APPLY_FILTERS
        label: Apply Filters
        layout {
            sequence: 30
            region: @excel-export
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button export-excel (
        buttonName: EXPORT_EXCEL
        label: Export to Excel
        layout {
            sequence: 30
            region: @excel-export
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction open-excel-download (
        name: Open Excel Download
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @export-excel
        }

        action native-invoke-ir-dialog (
            action: invokeInteractiveReportDialog
            settings {
                action: download
            }
            affectedElements {
                selectionType: region
                region: @excel-export
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

