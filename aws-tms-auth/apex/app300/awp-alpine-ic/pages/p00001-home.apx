    region current-markup (
        name: Current Markup by Model and Ledger
        title: Current Markup by Model and Ledger
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select model_name,
                       ledger_name,
                       sum(usd_amount) as usd_amount
                  from xx_ic_markup_report_all_v
                 where ebs_instance_code = :P1_EBS_INSTANCE
                   and sold_yes_no = 'NO'
                 group by model_name, ledger_name
                ```
