page 1 (
    name: Current Markup
    alias: HOME
    title: AWP Alpine IC Inventory Reconciliation
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            window.icMarkupRefresh = (function () {
                var pollHandle = null;
                var runId = null;
            
                function formatSeconds(value) {
                    var seconds = Math.max(0, Math.floor(Number(value || 0)));
                    var hours = Math.floor(seconds / 3600);
                    var minutes = Math.floor((seconds % 3600) / 60);
                    var remainder = seconds % 60;
                    return (hours ? hours + ':' : '') +
                           String(minutes).padStart(hours ? 2 : 1, '0') + ':' +
                           String(remainder).padStart(2, '0');
                }
            
                function setBusy(isBusy) {
                    var $ = apex.jQuery;
                    $('#dataset-status .ic-status').toggleClass('is-refreshing', isBusy).attr('aria-busy', isBusy ? 'true' : 'false');
                    $('#refresh-now').prop('disabled', isBusy);
                    $('#P1_EBS_INSTANCE').prop('disabled', isBusy);
                    $('#open-excel,#open-pivot').attr('aria-disabled', isBusy ? 'true' : 'false');
                }
            
                function showError(message) {
                    apex.message.clearErrors();
                    apex.message.showErrors([{type:'error', location:'page', message:message, unsafe:false}]);
                }
            
                function render(data) {
                    var $ = apex.jQuery;
                    $('#refresh-run-status').text('Status: ' + (data.display_status || data.status || 'Unknown'));
                    (data.stages || []).forEach(function (stage) {
                        var $card = $('#refresh-stage-' + stage.number);
                        $card.removeClass('ic-stage--running ic-stage--completed ic-stage--error ic-stage--skipped ic-stage--rolled_back');
                        $card.addClass('ic-stage--' + String(stage.status || 'waiting').toLowerCase());
                        $card.find('em').text(stage.display_status || stage.status || 'Waiting');
                        $card.find('small').text(formatSeconds(stage.elapsed_seconds));
                        $card.find('.ic-stage__dates').html('Started (ET): ' + (stage.started_at || '-') + '<br>Completed (ET): ' + (stage.completed_at || '-'));
                        $card.find('.ic-stage__count').text(stage.row_count === null || stage.row_count === undefined ? '' : stage.row_count + ' row(s)');
                    });
                }
            
                function poll() {
                    apex.server.process('REFRESH_STATUS', {x01:String(runId), pageItems:'#P1_EBS_INSTANCE'}, {dataType:'json'})
                        .done(function (data) {
                            if (!data.ok) {
                                if (pollHandle) { clearInterval(pollHandle); pollHandle = null; }
                                setBusy(false);
                                showError(data.message || 'Unable to read refresh status.');
                                return;
                            }
                            render(data);
                            if (data.status === 'COMPLETED') {
                                clearInterval(pollHandle);
                                pollHandle = null;
                                setBusy(false);
                                window.setTimeout(function () { window.location.reload(); }, 900);
                            } else if (data.status === 'ERROR') {
                                clearInterval(pollHandle);
                                pollHandle = null;
                                setBusy(false);
                                showError(data.message || 'Refresh failed. No changes were published.');
                            }
                        })
                        .fail(function () {
                            if (pollHandle) { clearInterval(pollHandle); pollHandle = null; }
                            setBusy(false);
                            showError('Unable to read refresh status.');
                        });
                }
            
                function start() {
                    apex.message.clearErrors();
                    setBusy(true);
                    apex.server.process('START_REFRESH', {pageItems:'#P1_EBS_INSTANCE'}, {dataType:'json'})
                        .done(function (data) {
                            if (!data.ok) {
                                setBusy(false);
                                showError(data.message || 'Unable to start refresh.');
                                return;
                            }
                            runId = data.run_id;
                            render(data);
                            poll();
                            pollHandle = window.setInterval(poll, 2000);
                        })
                        .fail(function () {
                            setBusy(false);
                            showError('Unable to start refresh.');
                        });
                }
            
                function init() {
                    var $ = apex.jQuery;
                    $('#refresh-now').off('click.icRefresh').on('click.icRefresh', start);
                    var $status = $('#dataset-status .ic-status');
                    runId = Number($status.attr('data-run-id')) || null;
                    var status = $status.attr('data-run-status');
                    if (runId && (status === 'QUEUED' || status === 'RUNNING')) {
                        setBusy(true);
                        poll();
                        pollHandle = window.setInterval(poll, 2000);
                    }
                }
            
                return {init:init};
            }());
            ```
        executeWhenPageLoads: icMarkupRefresh.init();
    }
    css {
        inline:
            ```css
            #dataset-status { position: relative; }
            .ic-status { border-left: 4px solid #2563eb; border-radius: .35rem; padding: 1rem; background: #eff6ff; }
            .ic-status__header { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
            .ic-status__header h2 { margin: 0 0 .25rem; font-size: 1.1rem; }
            .ic-status__header p { margin: .2rem 0; }
            .ic-status__actions { display: flex; gap: .5rem; flex-wrap: wrap; }
            .ic-stage-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; margin-top: 1rem; }
            .ic-stage { background: #fff; border: 1px solid #dbeafe; border-radius: .35rem; padding: .75rem; display: grid; gap: .25rem; }
            .ic-stage span { font-weight: 700; color: #2563eb; }
            .ic-stage em { font-style: normal; color: #6b7280; }
            .ic-stage small { font-variant-numeric: tabular-nums; }
            .ic-stage__dates,.ic-stage__count { font-size:.75rem; color:#6b7280; }
            .ic-stage--running { border-color:#2563eb; box-shadow:0 0 0 1px #2563eb inset; }
            .ic-stage--completed { border-color:#16a34a; }
            .ic-stage--error { border-color:#dc2626; background:#fef2f2; }
            .ic-stage--skipped { border-color:#d97706; background:#fffbeb; }
            .ic-stage--rolled_back { border-color:#dc2626; background:#fff7ed; }
            .ic-status--running { border-left-color:#2563eb; }
            .ic-status--completed { border-left-color:#16a34a; background:#f0fdf4; }
            .ic-status--error { border-left-color:#dc2626; background:#fef2f2; }
            .ic-status.is-refreshing .ic-status__actions a { pointer-events:none; opacity:.55; }
            .ic-admin-error { margin-top:1rem; padding:.75rem; background:#fff; border:1px solid #fecaca; white-space:pre-wrap; overflow:auto; }
            @media (max-width: 800px) { .ic-status__header { display: block; } .ic-status__actions { margin-top: .75rem; } .ic-stage-grid { grid-template-columns: 1fr; } }
            ```
