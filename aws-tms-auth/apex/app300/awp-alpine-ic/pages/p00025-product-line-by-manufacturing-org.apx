    region product-line-by-manufacturing-org (
        name: Product Line by Manufacturing Organization
        title: Product Line by Manufacturing Organization - Unsold Units
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    type t_mfg_org_tab is table of varchar2(240) index by pls_integer;
                    l_mfg_orgs t_mfg_org_tab;
                    l_amount number;
                    l_grand_total number;
                    l_url varchar2(4000);
                    l_library_url varchar2(4000);
                    l_html clob := '<div class="ic-pivot-wrap"><table class="ic-pivot-table"><thead><tr><th>Product Line</th>';
                begin
                    l_library_url := apex_page.get_url(
                        p_page => 20, p_clear_cache => '20',
                        p_items => 'P20_EBS_INSTANCE', p_values => :P25_EBS_INSTANCE);
                    l_html := '<div class="ic-pivot-actions"><a class="t-Button" href="' ||
                              apex_escape.html_attribute(l_library_url) ||
                              '">Back to Pivot Library</a></div>' || l_html;
                
                    select factory_org bulk collect into l_mfg_orgs
                      from (select distinct factory_org
                              from xx_ic_markup_user_review_v
                             where ebs_instance_code = :P25_EBS_INSTANCE
                               and sold_yes_no = 'NO'
                             order by factory_org nulls last);
                
                    for i in 1 .. l_mfg_orgs.count loop
                        l_html := l_html || '<th>' || apex_escape.html(nvl(l_mfg_orgs(i), 'Unassigned')) || '</th>';
                    end loop;
                    l_html := l_html || '<th>Total</th></tr></thead><tbody>';
                
                    for p in (select prod_line, sum(usd_amount) total_amount
                                from xx_ic_markup_user_review_v
                               where ebs_instance_code = :P25_EBS_INSTANCE
                                 and sold_yes_no = 'NO'
                               group by prod_line
                               order by prod_line) loop
                        l_html := l_html || '<tr><td>' || apex_escape.html(nvl(p.prod_line, 'Unassigned')) || '</td>';
                        for i in 1 .. l_mfg_orgs.count loop
                            select sum(usd_amount) into l_amount
                              from xx_ic_markup_user_review_v
                             where ebs_instance_code = :P25_EBS_INSTANCE
                               and sold_yes_no = 'NO'
                               and ((factory_org = l_mfg_orgs(i))
                                    or (factory_org is null and l_mfg_orgs(i) is null))
                               and ((prod_line = p.prod_line) or (prod_line is null and p.prod_line is null));
                            if l_amount is null then
                                l_html := l_html || '<td>-</td>';
                            else
                                l_url := apex_page.get_url(
                                    p_page => 25, p_clear_cache => '25',
                                    p_items => 'P25_EBS_INSTANCE,P25_DETAIL_PROD_LINE,P25_DETAIL_MANUFACTURING_ORG,P25_SHOW_DETAIL',
                                    p_values => :P25_EBS_INSTANCE || ',' || nvl(p.prod_line, '~NULL~') || ',' || nvl(l_mfg_orgs(i), '~NULL~') || ',Y');
                                l_html := l_html || '<td><a href="' || apex_escape.html_attribute(l_url || '#pivot-detail') || '">' ||
                                          to_char(l_amount, 'FM999G999G999G990') || '</a></td>';
                            end if;
                        end loop;
                        l_url := apex_page.get_url(
                            p_page => 25, p_clear_cache => '25',
                            p_items => 'P25_EBS_INSTANCE,P25_DETAIL_PROD_LINE,P25_DETAIL_MANUFACTURING_ORG,P25_SHOW_DETAIL',
                            p_values => :P25_EBS_INSTANCE || ',' || nvl(p.prod_line, '~NULL~') || ',,Y');
                        l_html := l_html || '<td><strong><a href="' || apex_escape.html_attribute(l_url || '#pivot-detail') || '">' ||
                                  to_char(p.total_amount, 'FM999G999G999G990') || '</a></strong></td></tr>';
                    end loop;
                
                    l_html := l_html || '</tbody><tfoot><tr><th>Grand Total</th>';
                    for i in 1 .. l_mfg_orgs.count loop
                        select sum(usd_amount) into l_amount
                          from xx_ic_markup_user_review_v
                         where ebs_instance_code = :P25_EBS_INSTANCE
                           and sold_yes_no = 'NO'
                           and ((factory_org = l_mfg_orgs(i))
                                or (factory_org is null and l_mfg_orgs(i) is null));
                        l_url := apex_page.get_url(
                            p_page => 25, p_clear_cache => '25',
                            p_items => 'P25_EBS_INSTANCE,P25_DETAIL_PROD_LINE,P25_DETAIL_MANUFACTURING_ORG,P25_SHOW_DETAIL',
                            p_values => :P25_EBS_INSTANCE || ',,' || nvl(l_mfg_orgs(i), '~NULL~') || ',Y');
                        l_html := l_html || '<td><a href="' || apex_escape.html_attribute(l_url || '#pivot-detail') || '">' ||
                                  to_char(l_amount, 'FM999G999G999G990') || '</a></td>';
                    end loop;
                
                    select sum(usd_amount) into l_grand_total
                      from xx_ic_markup_user_review_v
                     where ebs_instance_code = :P25_EBS_INSTANCE
                       and sold_yes_no = 'NO';
                    l_url := apex_page.get_url(
                        p_page => 25, p_clear_cache => '25',
                        p_items => 'P25_EBS_INSTANCE,P25_DETAIL_PROD_LINE,P25_DETAIL_MANUFACTURING_ORG,P25_SHOW_DETAIL',
                        p_values => :P25_EBS_INSTANCE || ',,,Y');
                    l_html := l_html || '<td><a href="' || apex_escape.html_attribute(l_url || '#pivot-detail') || '">' ||
                              to_char(l_grand_total, 'FM999G999G999G990') || '</a></td></tr></tfoot>';
                
                    return l_html || '</table></div>';
                end;
                ```
            pageItemsToSubmit: P25_EBS_INSTANCE
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P25_DETAIL_MANUFACTURING_ORG (
        type: hidden
        layout {
            sequence: 30
            region: @product-line-by-manufacturing-org
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P25_DETAIL_PROD_LINE (
        type: hidden
        layout {
            sequence: 20
            region: @product-line-by-manufacturing-org
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P25_EBS_INSTANCE (
        type: hidden
        layout {
            sequence: 10
            region: @product-line-by-manufacturing-org
            slot: regionBody
        }
        default {
            type: static
            staticValue: PTRXI
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P25_SHOW_DETAIL (
        type: hidden
        layout {
            sequence: 40
            region: @product-line-by-manufacturing-org
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button back-to-pivot (
        buttonName: BACK_TO_PIVOT
        label: Back to Pivot
        layout {
            sequence: 10
            region: @pivot-detail
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 25
                clearCache: 25
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

