page 25 (
    name: Product Line by Manufacturing Organization
    alias: PRODUCT-LINE-BY-MANUFACTURING-ORG
    title: Product Line by Manufacturing Organization
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline:
            ```css
            .ic-pivot-table { width:100%; border-collapse:collapse; }
            .ic-pivot-table th,.ic-pivot-table td { border:1px solid #d1d5db; padding:.55rem .7rem; text-align:right; }
            .ic-pivot-table th:first-child,.ic-pivot-table td:first-child { text-align:left; position:sticky; left:0; background:#fff; }
            .ic-pivot-table thead th { background:#f3f4f6; font-weight:700; }
            .ic-pivot-table tfoot th,.ic-pivot-table tfoot td { background:#f3f4f6; font-weight:700; }
            .ic-pivot-table a { font-variant-numeric:tabular-nums; }
            .ic-pivot-wrap { overflow:auto; }
            .ic-pivot-actions { margin:0 0 1rem; }
            #pivot-detail { scroll-margin-top:1rem; }
            ```
    }
    security {
        authorizationScheme: @tms-application-access
    }

    region pivot-detail (
        name: Pivot Detail
        title: Supporting Unsold Units
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select serial_number,
                       model_name,
                       item_number,
                       prod_line,
                       factory_org as manufacturing_organization,
                       ledger_name,
                       usd_amount,
                       receiving_inventory_org,
                       shipping_inventory_org,
                       accounting_date,
                       period_name,
                       trade_flow,
                       rec_org_location,
                       icp_from,
                       destination_country,
                       concatenated_segments,
                       line_description
                  from xx_ic_markup_user_review_v
                 where ebs_instance_code = :P25_EBS_INSTANCE
                   and sold_yes_no = 'NO'
                   and (:P25_DETAIL_PROD_LINE is null
                        or (:P25_DETAIL_PROD_LINE = '~NULL~' and prod_line is null)
                        or prod_line = :P25_DETAIL_PROD_LINE)
                   and (:P25_DETAIL_MANUFACTURING_ORG is null
                        or (:P25_DETAIL_MANUFACTURING_ORG = '~NULL~' and factory_org is null)
                        or factory_org = :P25_DETAIL_MANUFACTURING_ORG)
                ```
            pageItemsToSubmit: [
                P25_EBS_INSTANCE
                P25_DETAIL_PROD_LINE
                P25_DETAIL_MANUFACTURING_ORG
                P25_SHOW_DETAIL
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P25_SHOW_DETAIL
        }
        pagination {
            type: rowRangesXToY
        }
        advanced {
            savedReportMappingIdentifier: 300025011
        }

        column ACCOUNTING_DATE (
            type: plainText
            heading {
                heading: Accounting Date
            }
            layout {
                sequence: 10
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column CONCATENATED_SEGMENTS (
            type: plainText
            heading {
                heading: Full GL Account
            }
