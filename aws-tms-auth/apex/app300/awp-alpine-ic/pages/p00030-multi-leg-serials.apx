    region multi-leg-summary (
        name: Multi-Leg Serial Summary
        title: Serial Numbers with More Than One Leg
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with filtered as (
                    select r.*
                      from xx_ic_markup_user_review_v r
                     where r.ebs_instance_code = :P30_EBS_INSTANCE
                       and (:P30_UNIT_STATUS = 'BOTH'
                            or r.sold_yes_no = case :P30_UNIT_STATUS
                                                 when 'SOLD' then 'YES'
                                                 when 'UNSOLD' then 'NO'
                                               end)
                ), serial_summary as (
                    select serial_number,
                           count(*) as leg_count,
                           listagg(distinct model_name, ', ') within group (order by model_name) as model_name,
                           listagg(distinct prod_line, ', ') within group (order by prod_line) as prod_line,
                           case max(sold_yes_no) when 'YES' then 'Sold' else 'Unsold' end as sold_status,
                           min(date_sold) as date_sold,
                           sum(usd_amount) as total_usd_amount
                      from filtered
                     where serial_number is not null
                     group by serial_number
                    having count(*) > 1
                )
                select s.serial_number,
                       s.leg_count,
                       s.model_name,
                       s.prod_line,
                       s.sold_status,
                       s.date_sold,
                       s.total_usd_amount,
                       apex_page.get_url(
                           p_page        => 30,
                           p_clear_cache => '30',
                           p_items       => 'P30_EBS_INSTANCE,P30_UNIT_STATUS,P30_SERIAL_NUMBER',
                           p_values      => :P30_EBS_INSTANCE || ',' || :P30_UNIT_STATUS || ',' || s.serial_number
                       ) as detail_url
                  from serial_summary s
                ```
            pageItemsToSubmit: [
                P30_EBS_INSTANCE
                P30_UNIT_STATUS
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No multi-leg serial numbers match the selected filters.
        }
        advanced {
            savedReportMappingIdentifier: 300030002
        }

