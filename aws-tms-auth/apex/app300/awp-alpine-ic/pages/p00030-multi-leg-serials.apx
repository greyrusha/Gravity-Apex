page 30 (
    name: Multi-Leg Serials
    alias: MULTI-LEG-SERIALS
    title: Multi-Leg Serials
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            if ($v("P30_SERIAL_NUMBER")) {
                window.setTimeout(function () {
                    var detailRegion = document.getElementById("multi-leg-detail");
                    if (detailRegion) {
                        detailRegion.scrollIntoView({ behavior: "smooth", block: "start" });
                    }
                }, 100);
            }
            ```
    }
    security {
        authorizationScheme: @tms-application-access
    }

    region multi-leg-detail (
        name: Selected Serial Leg Details
        title: Selected Serial Leg Details
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select trade_flow,
                       factory_org as manufacturing_organization,
                       shipping_inventory_org as shipping_organization,
                       receiving_inventory_org as receiving_organization,
                       transaction_date,
                       usd_amount,
                       line_description
                  from xx_ic_markup_user_review_v
                 where ebs_instance_code = :P30_EBS_INSTANCE
                   and serial_number = :P30_SERIAL_NUMBER
                   and (:P30_UNIT_STATUS = 'BOTH'
                        or sold_yes_no = case :P30_UNIT_STATUS
                                           when 'SOLD' then 'YES'
                                           when 'UNSOLD' then 'NO'
                                         end)
                 order by accounting_date, ae_header_id, ae_line_num
                ```
            pageItemsToSubmit: [
                P30_EBS_INSTANCE
                P30_UNIT_STATUS
                P30_SERIAL_NUMBER
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No leg details match the selected serial and filters.
        }
        advanced {
            savedReportMappingIdentifier: 300030502
        }

        column LINE_DESCRIPTION (
            type: plainText
            heading {
                heading: Line Description
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column MANUFACTURING_ORGANIZATION (
            type: plainText
            heading {
                heading: Manufacturing Organization
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column RECEIVING_ORGANIZATION (
            type: plainText
            heading {
                heading: Receiving Organization
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column SHIPPING_ORGANIZATION (
            type: plainText
            heading {
                heading: Shipping Organization
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column TRADE_FLOW (
            type: plainText
            heading {
                heading: Trade Flow
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column TRANSACTION_DATE (
            type: plainText
            heading {
                heading: Transaction Date
            }
            layout {
                sequence: 5
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        column USD_AMOUNT (
            type: plainText
            heading {
                heading: USD Amount
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn LINE_DESCRIPTION (
                sequence: 7
            )

            displayColumn MANUFACTURING_ORGANIZATION (
                sequence: 2
            )

            displayColumn RECEIVING_ORGANIZATION (
                sequence: 4
            )

            displayColumn SHIPPING_ORGANIZATION (
                sequence: 3
            )

            displayColumn TRADE_FLOW (
                sequence: 1
            )

            displayColumn TRANSACTION_DATE (
                sequence: 5
            )

            displayColumn USD_AMOUNT (
                sequence: 6
            )

        )

