    process clear-selected-serial (
        name: Clear Selected Serial
        type: executeCode
        source {
            plsqlCode: :P30_SERIAL_NUMBER := null;
        }
        execution {
            sequence: 10
        }
        error {
            displayLocation: onErrorPage
        }
        advanced {
            executionMappingIdentifier: 300030801
        }
        serverSideCondition {
            whenButtonPressed: @apply-filters
        }
    )

    process export-all-multi-leg-details (
        name: Export All Multi-Leg Details
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_context     apex_exec.t_context;
                    l_export      apex_data_export.t_export;
                    l_column_list varchar2(32767);
                    l_sql         varchar2(32767);
                begin
                    select listagg('r.' || dbms_assert.enquote_name(c.column_name, false), ',')
                               within group (order by c.column_id)
                      into l_column_list
                      from user_tab_columns c
                     where c.table_name = 'XX_IC_MARKUP_USER_REVIEW_V'
                       and exists (
                               select 1
                                 from apex_application_page_ir_col p
                                where p.application_id = :APP_ID
                                  and p.page_id = 10
                                  and p.column_alias = c.column_name
                                  and p.authorization_scheme is null
                           );
                
                    if l_column_list is null then
                        raise_application_error(-20030, 'No authorized export columns are available.');
                    end if;
                
                    l_sql :=
                        'with filtered as (' ||
                        ' select ' || l_column_list ||
                        ' from xx_ic_markup_user_review_v r' ||
                        ' where r.ebs_instance_code = :P30_EBS_INSTANCE' ||
                        ' and (:P30_UNIT_STATUS = ''BOTH''' ||
                        ' or r.sold_yes_no = case :P30_UNIT_STATUS' ||
                        ' when ''SOLD'' then ''YES''' ||
                        ' when ''UNSOLD'' then ''NO'' end))' ||
                        ', multi_leg as (' ||
                        ' select serial_number from filtered' ||
                        ' where serial_number is not null' ||
                        ' group by serial_number having count(*) > 1)' ||
                        ' select f.* from filtered f' ||
                        ' join multi_leg m on m.serial_number = f.serial_number';
                
                    l_context := apex_exec.open_query_context(
                        p_location        => apex_exec.c_location_local_db,
                        p_sql_query       => l_sql,
                        p_auto_bind_items => true,
                        p_max_rows        => null
                    );
                
                    l_export := apex_data_export.export(
                        p_context   => l_context,
                        p_format    => apex_data_export.c_format_xlsx,
                        p_file_name => 'multi_leg_serials_' || lower(:P30_EBS_INSTANCE)
                    );
                
                    apex_exec.close(l_context);
                    apex_data_export.download(l_export);
                exception
                    when others then
                        begin
                            apex_exec.close(l_context);
                        exception
                            when others then null;
                        end;
                        raise;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 300030802
        }
        serverSideCondition {
            whenButtonPressed: @export-xlsx
        }
    )

)

