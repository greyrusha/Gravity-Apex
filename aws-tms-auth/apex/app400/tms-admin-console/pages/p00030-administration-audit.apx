page 30 (
    name: Administration Audit
    alias: ADMINISTRATION-AUDIT
    title: Administration Audit
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @workspace-administrator-only
    }

    region administration-audit-report (
        name: Administration Audit
        title: Administration Audit
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select action_on, actor_email, target_email, application_code,
                       action_name, action_status, action_detail, request_id
                  from xx_tms_admin_audit
                 order by action_on desc
                 fetch first 500 rows only
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: showAll
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
        }

        column ACTION_DETAIL (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Detail
                alignment: center
            }
            layout {
                sequence: 70
            }
            sorting {
                sortable: false
            }
        )

        column ACTION_NAME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Action
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column ACTION_ON (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Action On
                alignment: center
            }
            layout {
                sequence: 10
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI:SS
            }
            sorting {
                sortable: false
            }
        )

        column ACTION_STATUS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Status
                alignment: center
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column ACTOR_EMAIL (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Actor
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column APPLICATION_CODE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Application
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column REQUEST_ID (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Request ID
                alignment: center
            }
            layout {
                sequence: 80
            }
            sorting {
                sortable: false
            }
        )

        column TARGET_EMAIL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Target
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

    )

)

