    process save-ebs-user (
        name: Save TMS (EBS) User
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_message varchar2(4000);
                begin
                  xx_tms_admin_pkg.save_ebs_user(
                    p_ebs_user_name       => :P10_EBS_USER_NAME,
                    p_local_user_email    => :P10_EBS_LOCAL_EMAIL,
                    p_full_name           => :P10_EBS_FULL_NAME,
                    p_enabled_yn          => nvl(:P10_EBS_ENABLED_YN, 'Y'),
                    p_is_console_admin_yn => nvl(:P10_EBS_ADMIN_YN, 'N'),
                    p_notes               => null,
                    p_message             => l_message
                  );
                  apex_application.g_print_success_message := l_message;
                end;
                ```
        }
        execution {
            sequence: 5
        }
        advanced {
            executionMappingIdentifier: 4002055
        }
        serverSideCondition {
            type: request=Value
            value: SAVE_EBS_USER
        }
    )

    process create-user (
        name: Create User
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare l_message varchar2(4000);
                begin
                  xx_tms_admin_pkg.create_user(
                    p_email => :P10_EMAIL, p_first_name => :P10_FIRST_NAME,
                    p_last_name => :P10_LAST_NAME, p_temp_password => :P10_CREATE_TEMP_PASSWORD,
                    p_application_codes => null, p_message => l_message);
                  apex_application.g_print_success_message := l_message;
                  apex_util.set_session_state('P10_CREATE_TEMP_PASSWORD', null);
                exception when others then
                  apex_util.set_session_state('P10_CREATE_TEMP_PASSWORD', null);
                  raise;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 4002050
        }
        serverSideCondition {
            type: request=Value
            value: CREATE_USER
        }
    )

    process save-account-actions (
        name: Save Account Actions
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_message varchar2(4000);
                  l_action_count pls_integer := 0;
                begin
                  for i in 1 .. apex_application.g_f04.count loop
                    for j in 1 .. apex_application.g_f05.count loop
                      if apex_application.g_f04(i) = apex_application.g_f05(j) then
                        raise_application_error(-20822, 'The same account cannot be locked and unlocked.');
                      end if;
                    end loop;
                  end loop;
                  for i in 1 .. apex_application.g_f03.count loop
                    xx_tms_admin_pkg.reset_password(apex_application.g_f03(i), :P10_RESET_TEMP_PASSWORD, l_message);
                    l_action_count := l_action_count + 1;
                  end loop;
                  for i in 1 .. apex_application.g_f04.count loop
                    xx_tms_admin_pkg.set_account_locked(apex_application.g_f04(i), 'Y', l_message);
                    l_action_count := l_action_count + 1;
                  end loop;
                  for i in 1 .. apex_application.g_f05.count loop
                    xx_tms_admin_pkg.set_account_locked(apex_application.g_f05(i), 'N', l_message);
                    l_action_count := l_action_count + 1;
                  end loop;
                  if l_action_count = 0 then raise_application_error(-20823, 'Select at least one account action.'); end if;
                  apex_application.g_print_success_message := l_action_count || ' account action(s) saved.';
                  apex_util.set_session_state('P10_RESET_TEMP_PASSWORD', null);
                exception when others then
                  apex_util.set_session_state('P10_RESET_TEMP_PASSWORD', null);
                  raise;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 4002051
        }
        serverSideCondition {
            type: request=Value
            value: SAVE_ACCOUNT_ACTIONS
        }
    )

)

