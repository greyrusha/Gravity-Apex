page 10 (
    name: User Maintenance
    alias: USER-MAINTENANCE
    title: User Maintenance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @workspace-administrator-only
    }

    region provision-ebs-user (
        name: Provision or Update TMS (EBS) User
        title: Provision or Update TMS (EBS) User
        type: staticContent
        source {
            htmlCode: <p>Add or update an Oracle EBS (TMS) user in the unified TMS directory. Existing @terex.com bridge accounts continue working for legacy apps (115 and 300) during transition. Console Administrators can sign in to App 400 and access all registered apps.</p>
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region apply-account-actions (
        name: Legacy Local Account Actions
        title: Legacy Local Account Actions
        type: staticContent
        source {
            htmlCode: <p>Select Reset Password, Lock, or Unlock for legacy @terex.com bridge workspace accounts (Apps 115 and 300), then click Save. To disable an EBS user globally across all apps, update the user in Provision or Update TMS (EBS) User.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region create-new-user (
        name: Create Legacy Bridge User (@terex.com)
        title: Create Legacy Bridge User (@terex.com)
        type: staticContent
        source {
            htmlCode: <p>Optional transition helper: create an @terex.com workspace account for legacy apps (115 and 300) and auto-link it in the TMS directory. There is no permanent delete action.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region workspace-users (
        name: Workspace Users
        title: Workspace Users
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select coalesce(x.local_user_email, lower(u.user_name)) user_name,
                       coalesce(x.full_name, trim(u.first_name || ' ' || u.last_name)) full_name,
                       (select max(l.access_date)
                          from apex_workspace_access_log l
                         where l.authentication_result = 'AUTH_SUCCESS'
                           and (
                             (x.ebs_user_name is not null and upper(l.user_name) = x.ebs_user_name)
                             or (u.user_name is not null and lower(l.user_name) = lower(u.user_name))
                           )) last_successful_login,
                       case when u.user_name is not null
                                 and regexp_like(u.user_name, '@terex[.]com$', 'i')
                                 and upper(nvl(u.is_admin, 'NO')) <> 'YES'
                                 and upper(nvl(u.is_application_developer, 'NO')) <> 'YES'
                            then apex_item.checkbox2(3, lower(u.user_name), null, null, null,
                                   'reset_' || ora_hash(coalesce(x.ebs_user_name, lower(u.user_name))),
                                   'Reset password for ' || lower(u.user_name)) end reset_password,
                       case when u.user_name is not null
                                 and regexp_like(u.user_name, '@terex[.]com$', 'i')
                                 and upper(nvl(u.is_admin, 'NO')) <> 'YES'
                                 and upper(nvl(u.is_application_developer, 'NO')) <> 'YES'
                                 and upper(nvl(u.account_locked, 'NO')) <> 'YES'
                            then apex_item.checkbox2(4, lower(u.user_name), null, null, null,
                                   'lock_' || ora_hash(coalesce(x.ebs_user_name, lower(u.user_name))),
                                   'Lock ' || lower(u.user_name)) end lock_account,
                       case when u.user_name is not null
                                 and regexp_like(u.user_name, '@terex[.]com$', 'i')
                                 and upper(nvl(u.is_admin, 'NO')) <> 'YES'
                                 and upper(nvl(u.is_application_developer, 'NO')) <> 'YES'
                                 and upper(nvl(u.account_locked, 'NO')) = 'YES'
                            then apex_item.checkbox2(5, lower(u.user_name), null, null, null,
                                   'unlock_' || ora_hash(coalesce(x.ebs_user_name, lower(u.user_name))),
                                   'Unlock ' || lower(u.user_name)) end unlock_account,
                       case when x.ebs_user_name is not null then
                              case when x.enabled_yn = 'Y' then 'TMS Enabled' else 'TMS Disabled' end ||
                              case when u.user_name is not null then
                                     case when upper(nvl(u.account_locked, 'NO')) = 'YES'
                                          then ' / Local Locked' else ' / Local Active' end
                                   else '' end
                            when upper(nvl(u.account_locked, 'NO')) = 'YES' then 'Local Locked'
                            else 'Local Active' end account_status,
                       case when x.is_console_admin_yn = 'Y' then 'Console Administrator'
                            when x.ebs_user_name is not null and u.user_name is not null then 'TMS EBS + Local Bridge'
                            when x.ebs_user_name is not null then 'TMS EBS Only'
                            when upper(nvl(u.is_admin, 'NO')) = 'YES' then 'Workspace Administrator'
                            when upper(nvl(u.is_application_developer, 'NO')) = 'YES' then 'Application Developer'
                            when not regexp_like(u.user_name, '@terex[.]com$', 'i') then 'Service/System Account'
                            else 'Legacy Local End User' end account_type,
                       x.ebs_user_name ebs_user_name
                  from xx_tms_users x
                  full outer join apex_workspace_apex_users u
                    on lower(u.user_name) = x.local_user_email
                 order by x.ebs_user_name nulls last, lower(u.user_name)
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        reportLayout {
            numberOfRows: 500
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: showAll
        }
        download {
            csvExportEnabled: true
        }

