list navigation-menu (
    name: Navigation Menu

    entry administration-audit (
        label: Administration Audit
        icon {
            imageIconCssClasses: fa-history
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 30
                action: resetPagination
            }
        }
        security {
            authorizationScheme: @workspace-administrator-only
        }
    )

    entry application-access-maintenance (
        label: Application Access Maintenance
        icon {
            imageIconCssClasses: fa-key
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 11
                action: resetPagination
            }
        }
        security {
            authorizationScheme: @workspace-administrator-only
        }
    )

    entry application-management (
        label: Application Management
        icon {
            imageIconCssClasses: fa-apps
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 12
                action: resetPagination
            }
        }
        security {
            authorizationScheme: @workspace-administrator-only
        }
    )

    entry current-activity (
        label: Current Activity
        icon {
            imageIconCssClasses: fa-chart-bar
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 20
                action: resetPagination
            }
        }
        security {
            authorizationScheme: @workspace-administrator-only
        }
    )

    entry dashboard (
        label: Dashboard
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
        security {
            authorizationScheme: @workspace-administrator-only
        }
    )

    entry user-maintenance (
        label: User Maintenance
        icon {
            imageIconCssClasses: fa-users
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 10
                action: resetPagination
            }
        }
        security {
            authorizationScheme: @workspace-administrator-only
        }
    )

)

