    pageItem P61_DB_LINK (
        type: hidden
        settings {
            valueProtected: true
        }
        layout {
            sequence: 20
            region: @pending-filters
            slot: regionBody
        }
        default {
            type: static
            staticValue: ADG
        }
    )

    pageItem P61_ORG_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            slot: body
        }
    )

    pageItem P61_PERIOD_NAME (
        type: selectList
        label {
            label: Accounting Period
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @tms-close-periods
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @pending-filters
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select upper(to_char(trunc(sysdate - 7, 'MM'), 'MON-YYYY', 'NLS_DATE_LANGUAGE=English')) from dual
        }
    )

    pageItem P61_READY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 32
            slot: body
        }
        default {
            type: static
            staticValue: N
        }
    )

    pageItem P61_RESOLUTION (
        type: selectList
        label {
            label: Resolution
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Required' d, 'REQUIRED' r from dual
                union all select 'Recommended', 'RECOMMENDED' from dual
                union all select 'All', 'ALL' from dual
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 25
            region: @pending-filters
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: REQUIRED
        }
    )

    pageItem P61_RUN_ID (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 36
            slot: body
        }
    )

