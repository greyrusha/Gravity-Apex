    button export-pending-summary (
        buttonName: EXPORT_SUMMARY
        label: Export Summary to Excel
        layout {
            sequence: 20
            region: @pending-filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-file-excel-o
        }
        behavior {
            executeValidations: false
        }
        advanced {
            htmlDomId: export-pending-summary
        }
    )

    button run-pending-analysis (
        buttonName: RUN_ANALYSIS
        label: Run Analysis
        layout {
            sequence: 10
            region: @pending-filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: run-pending-analysis
        }
    )

    process export-accepted-summary-xlsx (
        name: Export Accepted Summary to XLSX
        type: executeCode
        source {
            plsqlCode: xxme_inv_pending_ui_pkg.export_accepted_summary_xlsx;
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 120061000000000052
        }
        serverSideCondition {
            whenButtonPressed: @export-pending-summary
        }
    )

    process initialize-ajax-panes (
        name: Initialize AJAX Panes
        type: executeCode
        source {
            plsqlCode: xxme_inv_pending_ui_pkg.initialize_panes;
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 120061000000000040
        }
    )

    process p61-set-context (
        name: P61_SET_CONTEXT
        type: executeCode
        source {
            plsqlCode: xxme_inv_pending_ui_pkg.set_context;
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 120061000000000042
        }
    )

)

