            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: AA
            }
        )

        column RECEIPT_DATE (
            type: plainText
            heading {
                heading: Receipt Date
            }
            layout {
                sequence: 50
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: P
            }
        )

        column RECEIPT_NUMBER (
            type: plainText
            heading {
                heading: Receipt Number
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: O
            }
        )

        column RECEIPT_STATUS (
            type: plainText
            heading {
                heading: Receipt Status
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: R
            }
        )

        column RECEIPT_TYPE (
