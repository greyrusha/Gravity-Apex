            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: Q
            }
        )

        column REFRESH_TIMESTAMP (
            type: hidden
            heading {
                heading: Refresh Timestamp
            }
            layout {
                sequence: 190
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: M
            }
        )

        column UNAPPLIED_AMOUNT (
            type: plainText
            heading {
                heading: Unapplied Amount
                alignment: end
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: X
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Receivables Exceptions
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn ACCOUNTED_UNAPPLIED_AMOUNT (
                sequence: 14
            )

            displayColumn APPLIED_AMOUNT (
                sequence: 11
            )

            displayColumn CURRENCY_CODE (
                sequence: 7
            )

            displayColumn CUSTOMER_NAME (
                sequence: 9
            )

            displayColumn CUSTOMER_NUMBER (
                sequence: 8
            )

            displayColumn LEDGER_CURRENCY_CODE (
                sequence: 13
            )

            displayColumn LEDGER_NAME (
                sequence: 1
            )

            displayColumn OPERATING_UNIT (
                sequence: 2
            )

            displayColumn ORIGINAL_RECEIPT_AMOUNT (
                sequence: 10
            )

            displayColumn RECEIPT_AGE_DAYS (
                sequence: 15
            )

            displayColumn RECEIPT_DATE (
                sequence: 4
            )

            displayColumn RECEIPT_NUMBER (
                sequence: 3
            )

            displayColumn RECEIPT_STATUS (
                sequence: 6
            )

            displayColumn RECEIPT_TYPE (
                sequence: 5
            )

            displayColumn UNAPPLIED_AMOUNT (
                sequence: 12
            )

        )

    )

    pageItem P31_DB_LINK (
        type: hidden
        settings {
            valueProtected: true
        }
        layout {
            sequence: 10
            region: @filters
            slot: regionBody
        }
        default {
            type: static
            staticValue: ADG
        }
    )

    button back-to-dashboard (
        buttonName: BACK_TO_DASHBOARD
        label: Close
        layout {
            sequence: 20
            region: @filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-arrow-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh-gl (
        buttonName: REFRESH_AR
        label: Refresh
        layout {
            sequence: 20
            region: @filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction close (
        name: Close
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @back-to-dashboard
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.close();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-ar-report (
        name: Refresh AR Report
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh-gl
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @gl-readiness
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

