page 71 (
    name: Fixed Assets Month-End Close
    alias: FIXED-ASSETS
    title: Fixed Assets Month-End Close
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            (function(){const $=apex.jQuery;
             function decorate(){const r=$('#fa71-report');r.find('.fa71-status').each(function(){const s=this.textContent.trim();this.className='fa71-status fa71-badge '+(s==='COMPLETE'||s==='COMPLETE (NO GL POSTING)'?'fa71-good':['GL NOT POSTED','NOT TRANSFERRED TO GL','ANNUAL CALENDAR - CONFIRM SCOPE'].includes(s)?'fa71-warn':'fa71-bad');});
             r.find('.fa71-activity').each(function(){if(this.textContent.trim())this.className='fa71-activity fa71-badge fa71-note';});
             r.find('.fa71-reconciliation').each(function(){const s=this.textContent.trim();this.className='fa71-reconciliation fa71-badge '+(s==='MATCHED'?'fa71-good':s==='DIFFERENCE'?'fa71-bad':'fa71-warn');});
             r.find('.fa71-indicator').each(function(){this.classList.toggle('fa71-warn',/[1-9]/.test(this.textContent));this.classList.toggle('fa71-badge',/[1-9]/.test(this.textContent));});}
             $('#fa71-report').on('apexafterrefresh',decorate);
             $(document).on('click','.fa71-refresh',function(){apex.region('fa71-report').refresh();});decorate();})();
            ```
    }
    css {
        inline:
            ```css
            #fa71-filters .apex-item-group--popup-lov,#fa71-filters .apex-item-multi,#fa71-filters .apex-item-select{min-height:76px}
            #fa71-filters .apex-item-multi{padding-top:26px!important;padding-bottom:6px!important;align-content:flex-start}
            #fa71-filters .apex-item-multi:has([data-value])>.apex-item-multi-item:last-child{flex:0 0 1px;min-width:1px;width:1px}
            #fa71-filters .apex-item-multi:has([data-value])>.apex-item-multi-item:last-child input{width:1px!important;min-width:1px!important;padding:0}
            #fa71-filters .a-Button--popupLOV{min-height:76px}
            .fa71-intro h1{margin:0 0 8px}.fa71-intro p{margin:6px 0;color:var(--ut-body-text-color,#333)}
            .fa71-muted{font-size:12px;opacity:.8}
            .fa71-badge{display:inline-block;padding:4px 8px;border-radius:4px;font-weight:600;white-space:nowrap}
            .fa71-good{background:#e6f4eb;color:#185c37}.fa71-warn{background:#fff1d6;color:#704500}.fa71-bad{background:#fde5e7;color:#9d1521}.fa71-note{background:var(--ut-component-background-color,#eef0f3);color:var(--ut-body-text-color,#333);font-size:11px}
            #fa71-report .a-IRR-tableContainer{max-height:560px;overflow:auto;isolation:isolate}
            #fa71-report .a-IRR-header:not(.a-IRR-header--group){position:sticky;top:0;z-index:2;background:var(--ut-region-header-background-color,#edf2f6);font-weight:700;text-align:center;border-bottom:2px solid var(--ut-component-border-color,#a5b5c1)}
            #fa71-report .a-IRR-headerLink{color:inherit;font-weight:700}
            
            ```
    }
    security {
        authorizationScheme: @tms-application-access
    }

    region filters (
        name: Filters
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--hideHeader
            ]
        }
        advanced {
            htmlDomId: fa71-filters
        }
    )

    region fixed-assets (
        name: Fixed Assets
        type: staticContent
        source {
            htmlCode: <div class="fa71-intro"><h1>Fixed Assets Month-End Close</h1><p>Compare net FA depreciation with final SLA expense and posted GL expense, using expense debits minus credits.</p><p class="fa71-muted">Select a book or difference to open the accounting bridge and asset details. Unresolved GL mappings require review. Books with GL posting disabled are exempt from the SLA and GL checks.</p></div>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--hideHeader
            ]
        }
        advanced {
            htmlDomId: fa71-intro
        }
    )

    region fixed-assets-close-status (
        name: Fixed Assets Close Status
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select q.*,apex_page.get_url(p_page=>72,p_clear_cache=>'72',p_items=>'P72_LEDGER_ID,P72_BOOK_TYPE_CODE,P72_PERIOD_NAME',p_values=>to_char(q.ledger_id)||','||q.book_type_code||','||q.period_name) bridge_url from table(xxme_fa_close_pkg.get_close_status(:P71_PERIOD_NAME,:P71_LEDGER_IDS,:P71_BOOK_CLASS)) q
            pageItemsToSubmit: [
                P71_PERIOD_NAME
                P71_LEDGER_IDS
                P71_BOOK_CLASS
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: fa71-report
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No books match the selected filters.
        }
        actionsMenu {
            subscription: false
        }
        download {
            formats: [
                csv
                excel
            ]
            sendAsEmail: false
        }
        heading {
            fixedTo: region
            maxReportHeight: 560
        }
        advanced {
            savedReportMappingIdentifier: 15409416763381769
        }

