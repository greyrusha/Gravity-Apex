        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport fa-close-primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 25
            }

            displayColumn BOOK_TYPE_CODE (
                sequence: 2
            )

            displayColumn CLOSE_STATUS (
                sequence: 5
            )

            displayColumn CURRENCY_CODE (
                sequence: 4
            )

            displayColumn FA_DEPRN_AMOUNT (
                sequence: 6
            )

            displayColumn FA_VS_GL_EXPENSE_DIFF (
                sequence: 9
            )

            displayColumn GL_POSTED_EXPENSE_NET (
                sequence: 8
            )

            displayColumn LEDGER_NAME (
                sequence: 1
            )

            displayColumn PERIOD_NAME (
                sequence: 3
            )

            displayColumn RECONCILIATION_STATUS (
                sequence: 10
            )

            displayColumn SLA_EXPENSE_NET (
                sequence: 7
            )

            sort (
                column: LEDGER_NAME
                sort {
                    sequence: 1
                }
            )

            sort (
                column: BOOK_CLASS
                sort {
                    sequence: 2
                }
            )

            sort (
                column: BOOK_TYPE_CODE
                sort {
                    sequence: 3
                }
            )

            controlBreak (
                column: LEDGER_NAME
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P71_BOOK_CLASS (
        type: selectList
        label {
            label: Book class
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Corporate;CORPORATE,Tax;TAX
            nullDisplayValue: All book classes
        }
        layout {
            sequence: 30
            region: @filters
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 0
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: CORPORATE
        }
    )

    pageItem P71_LEDGER_IDS (
        type: popupLov
        label {
            label: Ledgers
            alignment: left
        }
        settings {
            displayAs: inlinePopup
        }
        lov {
            type: sharedComponent
            lov: @tms-approved-ledgers
            displayExtraValues: false
            displayNullValue: false
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 20
            region: @filters
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 0
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            valuePlaceholder: All in-scope ledgers
        }
        default {
            type: static
            staticValue: 1003:5001:10001
        }
    )

    pageItem P71_PERIOD_NAME (
        type: selectList
        label {
            label: Period
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @tms-close-periods
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filters
            slot: regionBody
            alignment: left
            columnSpan: 4
            labelColumnSpan: 0
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select upper(to_char(trunc(sysdate - 7, 'MM'), 'MON-YYYY', 'NLS_DATE_LANGUAGE=English')) from dual
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 40
            region: @filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: fa71-refresh
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    process normalize-fixed-assets-filters (
        name: Normalize Fixed Assets filters
        type: executeCode
        source {
            plsqlCode: xxme_fa_close_pkg.normalize_p71_filters;
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15414654583381780
        }
    )

)

