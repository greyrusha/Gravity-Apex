    region p70-process-selector (
        name: Month-End Activity
        type: staticContent
        source {
            htmlCode: <h1>Month-End Process Monitor</h1><div class="p70-processes" role="tablist" aria-label="Month-end processes"><button type="button" class="p70-process" role="tab" id="p70-tab-CA" aria-controls="p70-CA" aria-selected="true" data-p70-tab="CA"><strong>Create Accounting</strong><span id="p70-summary-CA">Loading summary...</span><span id="p70-context-CA">AP, AR and Cost Management execution history</span></button><button type="button" class="p70-process" role="tab" id="p70-tab-RV" aria-controls="p70-RV" aria-selected="false" data-p70-tab="RV"><strong>Revaluations</strong><span id="p70-summary-RV">Loading summary...</span><span id="p70-context-RV">Last 3 revaluation runs per ledger</span></button><button type="button" class="p70-process" role="tab" id="p70-tab-RS" aria-controls="p70-RS" aria-selected="false" data-p70-tab="RS"><strong>Reversals</strong><span id="p70-summary-RS">Loading summary...</span><span id="p70-context-RS">Last 3 journal reversal runs per ledger</span></button></div>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--noPadding
                t-Region--hideHeader
            ]
        }
        advanced {
            htmlDomId: p70-process-selector
        }
    )

    region p70-report-CA (
        name: Create Accounting Executions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select * from table(xxme_process_monitor_pkg.get_ca_executions(:P70_CA_LEDGERS,:P70_CA_APPS,:P70_CA_VIEW))
            pageItemsToSubmit: [
                P70_CA_LEDGERS
                P70_CA_APPS
                P70_CA_VIEW
            ]
        }
        layout {
            sequence: 20
            parentRegion: @p70-CA
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: p70-report-CA
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No completed executions match the selected filters.
        }
        actionsMenu {
            subscription: false
        }
        download {
            formats: [
                csv
                excel
            ]
            sendAsEmail: false
        }
