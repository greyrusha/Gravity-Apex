page 72 (
    name: Fixed Assets Accounting Bridge
    alias: FIXED-ASSETS-BRIDGE
    title: Fixed Assets Accounting Bridge
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1450
        height: 850
        chained: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    javaScript {
        executeWhenPageLoads: "(function(){const $=apex.jQuery;function decorate(){document.querySelectorAll('.fa72-activity').forEach(el=>el.classList.toggle('fa72-negative',el.textContent.trim()==='NEGATIVE DEPRECIATION'));}function explainSlaLink(){const help=\"MAPPED: GL line references resolve consistently to SLA depreciation for the selected FA book, ledger and period, with one accounting class. REVIEW MAPPING: references are missing, unresolved or span conflicting books, ledgers, periods or accounting classes. A GL line may summarize multiple assets; posting status is checked separately.\";document.querySelectorAll('#fa72-gl-lines th').forEach(th=>{const link=th.querySelector('a');if((link?link.textContent:th.textContent).trim()==='SLA Link Status'){th.title=help;if(link){link.title=help;link.setAttribute('aria-label','SLA Link Status. '+help);}}});}$('#fa72-assets').on('apexafterrefresh',decorate);$('#fa72-gl-lines').on('apexafterrefresh',explainSlaLink);decorate();explainSlaLink();})();"
    }
    css {
        inline: ".fa72-context h2{margin-top:0}.fa72-subtle{font-size:12px;opacity:.8}.fa72-stage{width:100%;border-collapse:collapse;margin:12px 0}.fa72-stage th,.fa72-stage td{padding:9px 12px;border-bottom:1px solid var(--ut-component-border-color,#ddd)}.fa72-stage td:not(:first-child),.fa72-stage th:not(:first-child){text-align:right}.fa72-status{padding:6px 10px;border-radius:4px;display:inline-block;font-weight:600}.fa72-good{background:#e6f4eb;color:#185c37}.fa72-warn{background:#fff1d6;color:#704500}.fa72-negative{background:#fff1d6;color:#704500;font-weight:600;padding:3px 6px;border-radius:3px}.fa72-diff{font-weight:600}#fa72-assets .a-IRR-tableContainer,#fa72-gl-lines .a-IRR-tableContainer{max-height:420px;overflow:auto}#fa72-assets .a-IRR-header,#fa72-gl-lines .a-IRR-header{font-weight:700;text-align:center}"
    }
    security {
        authorizationScheme: @tms-application-access
    }

    region actual-gl-journal-lines (
        name: Actual GL Journal Lines
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select * from table(xxme_fa_close_pkg.get_gl_lines(to_number(:P72_LEDGER_ID),:P72_BOOK_TYPE_CODE,:P72_PERIOD_NAME))
            pageItemsToSubmit: [
                P72_LEDGER_ID
                P72_BOOK_TYPE_CODE
                P72_PERIOD_NAME
            ]
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: fa72-gl-lines
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No rows for this book and period.
        }
        actionsMenu {
            subscription: false
        }
        download {
            formats: [
                csv
                excel
            ]
            sendAsEmail: false
        }
        heading {
            fixedTo: region
            maxReportHeight: 420
        }
        advanced {
            savedReportMappingIdentifier: 15414845009381780
        }

        column ACCOUNTED_CR (
            type: plainText
            heading {
                heading: GL Credit
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G999G990D00
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column ACCOUNTED_DR (
