            }
            advanced {
                endUserAlias: A
            }
        )

        column MAPPING_STATUS (
            type: plainText
            heading {
                heading: SLA Link Status
                alignment: center
            }
            layout {
                sequence: 130
            }
            columnFormatting {
                htmlExpression: <span class="fa72-sla-link" tabindex="0" title="MAPPED: GL line references resolve consistently to SLA depreciation for the selected FA book, ledger and period, with one accounting class. REVIEW MAPPING: references are missing, unresolved or span conflicting books, ledgers, periods or accounting classes. A GL line may summarize multiple assets; posting status is checked separately." aria-label="#MAPPING_STATUS#. MAPPED: GL line references resolve consistently to SLA depreciation for the selected FA book, ledger and period, with one accounting class. REVIEW MAPPING: references are missing, unresolved or span conflicting books, ledgers, periods or accounting classes. A GL line may summarize multiple assets; posting status is checked separately.">#MAPPING_STATUS#</span>
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: M
            }
        )

        column PERIOD_NAME (
            type: plainText
            heading {
                heading: Period
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Posting Status
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport fa72-gl-lines-primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 25
            }

            displayColumn ACCOUNTED_CR (
                sequence: 7
            )

            displayColumn ACCOUNTED_DR (
                sequence: 6
            )

            displayColumn ACCOUNTING_CLASS_CODE (
                sequence: 5
            )

            displayColumn ACCOUNT_CODE (
                sequence: 4
            )

            displayColumn JE_LINE_NUM (
                sequence: 3
            )

            displayColumn JOURNAL_NAME (
                sequence: 1
            )

            displayColumn MAPPING_STATUS (
                sequence: 8
            )

            displayColumn STATUS (
                sequence: 2
            )

            sort (
                column: JE_HEADER_ID
                sort {
                    sequence: 1
                }
            )

            sort (
                column: JE_LINE_NUM
                sort {
                    sequence: 2
                }
            )

        )

    )

