    region fa-to-sla-to-gl-bridge (
        name: FA to SLA to GL Bridge
        type: plSqlDynamicContent
        source {
            plsqlCode: xxme_fa_close_pkg.render_bridge(to_number(:P72_LEDGER_ID),:P72_BOOK_TYPE_CODE,:P72_PERIOD_NAME);
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: fa72-bridge
        }
    )

    pageItem P72_BOOK_TYPE_CODE (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P72_LEDGER_ID (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P72_PERIOD_NAME (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    button close-bridge (
        buttonName: CLOSE_BRIDGE
        label: Back to Fixed Assets
        layout {
            sequence: 10
            region: @fa-to-sla-to-gl-bridge
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-arrow-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction close-accounting-bridge (
        name: Close accounting bridge
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @close-bridge
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.navigation.dialog.close(true);
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process validate-fixed-assets-context (
        name: Validate Fixed Assets context
        type: executeCode
        source {
            plsqlCode: xxme_fa_close_pkg.validate_p72_context;
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15419581732381806
        }
    )

)

