        )

    )

    pageItem P41_DB_LINK (
        type: hidden
        settings {
            valueProtected: true
        }
        layout {
            sequence: 20
            region: @filters
            slot: regionBody
        }
        default {
            type: static
            staticValue: ADG
        }
    )

    pageItem P41_PERIOD_NAME (
        type: selectList
        label {
            label: Period Name
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @tms-close-periods
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filters
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select upper(to_char(trunc(sysdate - 7, 'MM'), 'MON-YYYY', 'NLS_DATE_LANGUAGE=English'))
                from dual
                ```
        }
    )

    pageItem P41_RUN_SLA (
        type: hidden
        settings {
            valueProtected: true
        }
        layout {
            sequence: 40
            slot: body
        }
        default {
            type: static
            staticValue: N
        }
    )

    button back-to-dashboard (
        buttonName: BACK_TO_DASHBOARD
        label: Close
        layout {
            sequence: 30
            region: @filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button run-sla (
        buttonName: RUN_SLA
        label: Run Analysis
        layout {
            sequence: 20
            region: @filters
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close (
        name: Close
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @back-to-dashboard
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: window.close();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process enable-sla-report (
        name: Enable SLA Report
        type: executeCode
        source {
            plsqlCode: :P41_RUN_SLA := 'Y';
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16464590222610519
        }
        serverSideCondition {
            whenButtonPressed: @run-sla
        }
    )

)

