list navigation-menu (
    name: Navigation Menu

    entry ai-conversation-review (
        label: AI Conversation Review
        icon {
            imageIconCssClasses: fa-comments-o
        }
        layout {
            sequence: 9980
        }
        isCurrent {
            type: pages
            pages: [
                92
                93
                94
                95
            ]
        }
        link {
            target: {
                page: 92
                clearCache: 92
                action: resetPagination
            }
        }
        security {
            authorizationScheme: @tms-application-access
        }
        config {
            buildOption: @feature-ai
        }
    )

