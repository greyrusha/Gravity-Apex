    region workbench-tabs (
        name: Connected Customer Master Tabs
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                t-TabsRegion-mod--simple
            ]
        }
    )

    pageItem P10_EXCEL_FILE (
        type: fileUpload
        label {
            label: Upload Edited Connected 8-Tab Workbook (.xlsx)
        }
        display {
            displayAs: inlineDropzone
            dropzoneTitle: Drop Edited Connected 8-Tab Workbook (.xlsx) Here
            dropzoneDesc: Automatically applies cell-by-cell edits across Customers, Sites, Site Uses, Contacts, Multi-Currency Credit, Account Relationships & Payment Instruments, cascades exclusions, and refreshes 4-stage validation.
        }
        storage {
            type: appTempFiles
        }
        layout {
            sequence: 10
            region: @excel-roundtrip-tab
            slot: regionBody
            columnSpan: 8
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P10_TARGET_SHEET (
        type: selectList
        label {
            label: Worksheet Import Scope
        }
        lov {
            type: staticValues
            staticValues: STATIC:All Connected Worksheets (Recommended);AUTO,Tab 1 Only - Customers & Credit Profiles;CUSTOMERS,Tab 2 Only - Addresses & Sites;SITES,Tab 3 Only - Site Uses & GL Accounts;SITE_USES,Tab 4 Only - Contacts & Roles;CONTACTS,Tab 5 Only - Multi-Currency Credit;MULTI_CURR,Tab 6 Only - Account Relationships;ACCT_RELATES,Tab 7 Only - Payment Instruments;PAYMENT_INSTR
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @excel-roundtrip-tab
            slot: regionBody
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
    )

    button btn-auto-exclude-p10 (
        buttonName: AUTO_EXCLUDE_DUPS
        label: Auto-Exclude $0-AR / 0-Open-SO Duplicates
        layout {
            sequence: 7
            region: @buttons
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
