    process sync-and-validate-after-save (
        name: Cascade Exclusions, Sync Deltas & Re-Validate After Inline Save
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_proj_id number := xxcr_security_pkg.resolve_active_project(
                    to_number(:P0_PROJECT_ID default null on conversion error)
                  );
                begin
                  if l_proj_id is not null then
                    xxcr_rollout_pkg.cascade_exclusions(l_proj_id);
                    xxcr_rollout_pkg.sync_deltas(l_proj_id);
                    xxcr_rollout_pkg.find_duplicates(l_proj_id);
                    xxcr_rollout_pkg.validate_project(l_proj_id);
                  end if;
                end;
                ```
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Inline edits saved on active project, Account/Site exclusions cascaded, duplicates re-scanned, and 4-stage validation refreshed!
        }
        advanced {
            executionMappingIdentifier: 60001013
        }
        serverSideCondition {
            type: requestIsNotContainedInValue
            value: UPLOAD_EXCEL:AUTO_EXCLUDE_DUPS:SWITCH_PROJECT
        }
        security {
            authorizationScheme: @can-edit-data
        }
    )

)

