    process download-connected-xlsx (
        name: Stream Connected 5-Tab Excel Workbook
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_proj_id  number := xxcr_security_pkg.resolve_active_project(
                    to_number(:P0_PROJECT_ID default null on conversion error)
                  );
                  l_proj_cd  varchar2(60);
                  l_blob     blob;
                begin
                  select project_code
                    into l_proj_cd
                    from xxcr_projects
                   where project_id = l_proj_id;
                
                  l_blob := xxcr_rollout_pkg.generate_connected_xlsx(l_proj_id);
                
                  apex_http.download(
                    p_blob         => l_blob,
                    p_content_type => 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                    p_filename     => l_proj_cd || '_Connected_Workbook_' || to_char(sysdate, 'YYYYMMDD_HH24MI') || '.xlsx'
                  );
                end;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 60003010
        }
        serverSideCondition {
            type: request=Value
            value: DOWNLOAD_CONNECTED_XLSX
        }
    )

    process init-active-project-p10 (
        name: Resolve Active Conversion Project
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  :P0_PROJECT_ID := xxcr_security_pkg.resolve_active_project(
                    to_number(:P0_PROJECT_ID default null on conversion error)
                  );
                end;
                ```
        }
        execution {
            sequence: 1
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 60001010
        }
    )

    process run-auto-exclude-dups (
        name: Auto-Exclude $0-AR / 0-Open-SO Duplicates
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_proj_id number := xxcr_security_pkg.resolve_active_project(
                    to_number(:P0_PROJECT_ID default null on conversion error)
                  );
                  l_cnt     number := 0;
                begin
                  if l_proj_id is not null then
                    xxcr_rollout_pkg.auto_exclude_dormant_duplicates(l_proj_id, l_cnt);
                  end if;
                end;
                ```
        }
        execution {
            sequence: 45
        }
        successMessage {
            successMessage: Dormant duplicate Sites, Site Uses ($0 Open AR & 0 Open Sales Orders), and duplicate Contacts excluded and cascaded on active project!
        }
        advanced {
            executionMappingIdentifier: 60001017
        }
        serverSideCondition {
            whenButtonPressed: @btn-auto-exclude-p10
        }
        security {
            authorizationScheme: @can-edit-data
        }
    )

    process run-excel-import (
        name: Parse Uploaded Connected Excel & Apply Deltas
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_proj_id   number := xxcr_security_pkg.resolve_active_project(
                    to_number(:P0_PROJECT_ID default null on conversion error)
                  );
                  l_import_id number;
                begin
                  for r_file in (
                    select filename, mime_type, blob_content
                      from apex_application_temp_files
                     where name = :P10_EXCEL_FILE
                  ) loop
                    xxcr_rollout_pkg.process_excel_upload(
                      p_project_id   => l_proj_id,
                      p_file_name    => r_file.filename,
                      p_mime_type    => r_file.mime_type,
                      p_file_blob    => r_file.blob_content,
                      p_target_sheet => nvl(:P10_TARGET_SHEET, 'AUTO'),
                      p_import_id    => l_import_id
                    );
                  end loop;
                end;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Connected Excel workbook parsed for active project, cascading exclusions & cell deltas applied across all 4 entities, duplicates re-scanned, and 4-stage validation refreshed!
        }
        advanced {
            executionMappingIdentifier: 60003011
        }
        serverSideCondition {
            whenButtonPressed: @btn-upload-excel
        }
        security {
            authorizationScheme: @can-edit-data
        }
    )

