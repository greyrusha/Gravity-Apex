    region sites-ig (
        name: 2. Addresses & Sites
        title: 2. Addresses & Sites
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: XXCR_STG_SITES
            whereClause: project_id = :P0_PROJECT_ID
            pageItemsToSubmit: P0_PROJECT_ID
        }
        layout {
            sequence: 20
            parentRegion: @workbench-tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--noPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        editAuthorization {
            update: @can-edit-data
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 60001003
        }

