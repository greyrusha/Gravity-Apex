    dynamicAction da-refresh-after-drawer (
        name: Refresh Workbench Grids After Drawer Save
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: jQuerySelector
            jquerySelector: body
        }

        action act-refresh-cnt-ig (
            action: refresh
            affectedElements {
                selectionType: region
                region: @contacts-ig
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action act-refresh-cust-ig (
            action: refresh
            affectedElements {
                selectionType: region
                region: @customers-ig
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action act-refresh-deltas-ig (
            action: refresh
            affectedElements {
                selectionType: region
                region: @deltas-ig
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action act-refresh-pa-ig (
            action: refresh
            affectedElements {
                selectionType: region
                region: @prof-amts-ig
            }
            execution {
                sequence: 42
                fireOnInit: false
            }
        )

        action act-refresh-pmt-ig (
            action: refresh
            affectedElements {
                selectionType: region
                region: @payment-instr-ig
            }
            execution {
                sequence: 46
                fireOnInit: false
            }
        )

        action act-refresh-rel-ig (
            action: refresh
            affectedElements {
                selectionType: region
                region: @acct-relates-ig
            }
            execution {
                sequence: 44
                fireOnInit: false
            }
        )

        action act-refresh-sites-ig (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sites-ig
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action act-refresh-su-ig (
            action: refresh
            affectedElements {
                selectionType: region
                region: @site-uses-ig
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    validation val-contacts-ig (
        name: Pre-Save Contact Name & Email Format Check (Contacts)
        execution {
            sequence: 40
        }
        validation {
            editableRegion: @contacts-ig
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                return xxcr_rollout_pkg.validate_contact_row(
                  p_include_yn   => :INCLUDE_YN,
                  p_primary_flag => :TGT_PRIMARY_FLAG,
                  p_first_name   => :TGT_FIRST_NAME,
                  p_last_name    => :TGT_LAST_NAME,
                  p_email        => :TGT_EMAIL_ADDRESS
                );
                ```
        }
        error {
            associatedColumn: TGT_EMAIL_ADDRESS
        }
    )

