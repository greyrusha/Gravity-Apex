page 15 (
    name: Guided Edit Record Drawer
    alias: EDIT-RECORD
    title: Edit Staged Customer Master Record
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 780
        chained: false
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    security {
        authorizationScheme: @can-edit-data
    }

    region cnt-form (
        name: Contact Person, Email & Phone
        title: Validated Contact Person & Role
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P15_ENTITY = 'CONTACT'
        }
    )

    region cust-form (
        name: Customer Account & Credit Profile
        title: Validated Customer Account & Credit Profile
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P15_ENTITY = 'CUSTOMER'
        }
    )

    region drawer-buttons (
        name: Drawer Footer Buttons
        type: staticContent
        layout {
            sequence: 90
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region hidden-ctx (
        name: Drawer Keys
        type: staticContent
        layout {
            sequence: 6
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
        }
    )

    region site-form (
        name: Party Address & Customer Site
        title: Validated Party Address & Customer Site
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P15_ENTITY = 'SITE'
        }
    )

    region source-context-banner (
        name: Frozen EBS Source Snapshot Context
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                  l_html clob;
                begin
                  if :P15_ENTITY = 'CUSTOMER' then
                    for r in (
                      select src_account_number, src_party_name, scope_class,
                             nvl(src_open_ar_amt, 0) as open_ar, nvl(src_trx_cnt_recent, 0) as trx_cnt,
                             nvl(dup_role, 'UNIQUE') as dup_role, val_status
                        from xxcr_stg_customers
                       where stg_cust_id = to_number(:P15_ROW_ID default null on conversion error)
                         and project_id = :P0_PROJECT_ID
                    ) loop
                      l_html := '<div style="background:#f8fbff;border:1px solid #d0e0fc;border-left:4px solid #174ea6;border-radius:6px;padding:10px 14px;margin-bottom:12px;font-size:13px;">'
                             || '<strong>Customer Account #' || apex_escape.html(r.src_account_number) || '</strong> &mdash; ' || apex_escape.html(r.src_party_name)
                             || '<br><span style="color:#4b5563;">Scope: <strong>' || apex_escape.html(r.scope_class)
                             || '</strong> | Open AR: <strong>' || to_char(r.open_ar, 'FM999G999G990D00')
                             || '</strong> | 24m Trx: <strong>' || r.trx_cnt
                             || '</strong> | Dup Role: <strong>' || apex_escape.html(r.dup_role)
                             || '</strong> | Validation: <strong>' || apex_escape.html(r.val_status) || '</strong></span></div>';
                    end loop;
                  elsif :P15_ENTITY = 'SITE' then
                    for r in (
                      select s.site_ref_code, s.tgt_account_number, c.src_party_name,
                             nvl(s.src_open_ar_amt, 0) as open_ar, nvl(s.src_open_so_cnt, 0) as so_cnt,
                             nvl(s.dup_role, 'UNIQUE') as dup_role, s.val_status
                        from xxcr_stg_sites s
                        join xxcr_stg_customers c on c.stg_cust_id = s.stg_cust_id
                       where s.stg_site_id = to_number(:P15_ROW_ID default null on conversion error)
                         and s.project_id = :P0_PROJECT_ID
                    ) loop
                      l_html := '<div style="background:#f8fbff;border:1px solid #d0e0fc;border-left:4px solid #174ea6;border-radius:6px;padding:10px 14px;margin-bottom:12px;font-size:13px;">'
                             || '<strong>Address Site ' || apex_escape.html(r.site_ref_code) || '</strong> (Acct #' || apex_escape.html(r.tgt_account_number) || ' &mdash; ' || apex_escape.html(r.src_party_name) || ')'
                             || '<br><span style="color:#4b5563;">Site Open AR: <strong>' || to_char(r.open_ar, 'FM999G999G990D00')
                             || '</strong> | Open SOs: <strong>' || r.so_cnt
                             || '</strong> | Dup Role: <strong>' || apex_escape.html(r.dup_role)
                             || '</strong> | Validation: <strong>' || apex_escape.html(r.val_status) || '</strong></span></div>';
                    end loop;
                  elsif :P15_ENTITY = 'SITE_USE' then
                    for r in (
                      select su.tgt_site_use_code, su.site_ref_code, su.tgt_account_number, c.src_party_name,
                             nvl(su.src_open_ar_amt, 0) as open_ar, nvl(su.src_open_so_cnt, 0) as so_cnt,
                             nvl(su.dup_role, 'UNIQUE') as dup_role, su.val_status
                        from xxcr_stg_site_uses su
                        join xxcr_stg_customers c on c.stg_cust_id = su.stg_cust_id
                       where su.stg_site_use_id = to_number(:P15_ROW_ID default null on conversion error)
                         and su.project_id = :P0_PROJECT_ID
                    ) loop
                      l_html := '<div style="background:#f8fbff;border:1px solid #d0e0fc;border-left:4px solid #174ea6;border-radius:6px;padding:10px 14px;margin-bottom:12px;font-size:13px;">'
                             || '<strong>' || apex_escape.html(r.tgt_site_use_code) || ' Site Use</strong> on ' || apex_escape.html(r.site_ref_code)
                             || ' (Acct #' || apex_escape.html(r.tgt_account_number) || ' &mdash; ' || apex_escape.html(r.src_party_name) || ')'
                             || '<br><span style="color:#4b5563;">Open AR: <strong>' || to_char(r.open_ar, 'FM999G999G990D00')
                             || '</strong> | Open SOs: <strong>' || r.so_cnt
                             || '</strong> | Dup Role: <strong>' || apex_escape.html(r.dup_role)
                             || '</strong> | Validation: <strong>' || apex_escape.html(r.val_status) || '</strong></span></div>';
                    end loop;
                  elsif :P15_ENTITY = 'CONTACT' then
                    for r in (
                      select ct.contact_ref_code, ct.site_ref_code, ct.tgt_account_number, c.src_party_name, ct.val_status
                        from xxcr_stg_contacts ct
                        join xxcr_stg_customers c on c.stg_cust_id = ct.stg_cust_id
                       where ct.stg_contact_id = to_number(:P15_ROW_ID default null on conversion error)
                         and ct.project_id = :P0_PROJECT_ID
                    ) loop
                      l_html := '<div style="background:#f8fbff;border:1px solid #d0e0fc;border-left:4px solid #174ea6;border-radius:6px;padding:10px 14px;margin-bottom:12px;font-size:13px;">'
                             || '<strong>Contact ' || apex_escape.html(r.contact_ref_code) || '</strong> (Acct #' || apex_escape.html(r.tgt_account_number)
                             || case when r.site_ref_code is not null then ' | Site ' || apex_escape.html(r.site_ref_code) end
                             || ' &mdash; ' || apex_escape.html(r.src_party_name) || ')</div>';
                    end loop;
                  end if;
                  return nvl(l_html, '<p>Select a valid record from Customer Master Workbench.</p>');
                end;
                ```
        }
        layout {
            sequence: 5
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

