    button btn-cancel-drawer (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @drawer-buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button btn-save-drawer (
        buttonName: SAVE_DRAWER
        label: Validate, Save & Cascade
        layout {
            sequence: 20
            region: @drawer-buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction da-cancel-drawer (
        name: Cancel Drawer Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @btn-cancel-drawer
        }

        action act-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation val-drawer-fields (
        name: Pre-Save EBS Lookup & Format Validation
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                  if :P15_ENTITY = 'CUSTOMER' then
                    return xxcr_rollout_pkg.validate_cust_row(
                      p_include_yn         => :P15_C_INCLUDE_YN,
                      p_action_code        => :P15_C_ACTION_CODE,
                      p_tgt_party_name     => :P15_C_PARTY_NAME,
                      p_tgt_account_number => null,
                      p_cust_class         => :P15_C_CUST_CLASS,
                      p_profile_class      => :P15_C_PROFILE_CLASS,
                      p_collector          => :P15_C_COLLECTOR,
                      p_payment_term       => :P15_C_PAYMENT_TERM,
                      p_credit_curr        => :P15_C_CURRENCY,
                      p_overall_limit      => :P15_C_OVERALL_LIM,
                      p_trx_limit          => :P15_C_TRX_LIM
                    );
                  elsif :P15_ENTITY = 'SITE' then
                    return xxcr_rollout_pkg.validate_site_row(
                      p_include_yn  => :P15_S_INCLUDE_YN,
                      p_country     => :P15_S_COUNTRY,
                      p_address1    => :P15_S_ADDR1,
                      p_city        => :P15_S_CITY,
                      p_postal_code => :P15_S_POSTAL,
                      p_sales_curr  => :P15_S_SALES_CURR,
                      p_rps_hold    => :P15_S_RPS_HOLD
                    );
                  elsif :P15_ENTITY = 'SITE_USE' then
                    return xxcr_rollout_pkg.validate_site_use_row(
                      p_include_yn     => :P15_U_INCLUDE_YN,
                      p_primary_flag   => :P15_U_PRIMARY_FLAG,
                      p_location_code  => :P15_U_LOCATION,
                      p_profile_class  => :P15_U_PROFILE_CLASS,
                      p_collector      => :P15_U_COLLECTOR,
                      p_payment_term   => :P15_U_PAYMENT_TERM,
                      p_credit_curr    => :P15_U_CURRENCY,
                      p_overall_limit  => :P15_U_OVERALL_LIM,
                      p_trx_limit      => :P15_U_TRX_LIM,
                      p_warehouse_code => :P15_U_WAREHOUSE,
                      p_order_type     => :P15_U_ORDER_TYPE,
                      p_price_list     => :P15_U_PRICE_LIST,
                      p_tax_code       => :P15_U_TAX_CODE,
                      p_gl_rec         => :P15_U_GL_REC,
                      p_gl_rev         => :P15_U_GL_REV,
                      p_gl_tax         => :P15_U_GL_TAX,
                      p_stmt_cycle     => :P15_U_STMT_CYCLE,
                      p_autocash_rule  => :P15_U_AUTOCASH,
                      p_grouping_rule  => :P15_U_GROUP_RULE
                    );
                  elsif :P15_ENTITY = 'CONTACT' then
                    return xxcr_rollout_pkg.validate_contact_row(
                      p_include_yn   => :P15_T_INCLUDE_YN,
                      p_primary_flag => :P15_T_PRIMARY_FLAG,
                      p_first_name   => :P15_T_FIRST_NAME,
                      p_last_name    => :P15_T_LAST_NAME,
                      p_email        => :P15_T_EMAIL
                    );
                  end if;
                  return null;
                end;
                ```
        }
        error {
            displayLocation: inlineInNotification
        }
        serverSideCondition {
            whenButtonPressed: @btn-save-drawer
        }
    )

    process close-drawer-proc (
        name: Close Drawer Dialog
        type: closeDialog
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 60001503
        }
        serverSideCondition {
            whenButtonPressed: @btn-save-drawer
        }
    )

    process load-drawer-record (
        name: Load Staged Record Into Drawer
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_id number := to_number(:P15_ROW_ID default null on conversion error);
                begin
                  :P0_PROJECT_ID := xxcr_security_pkg.resolve_active_project(
                    to_number(:P0_PROJECT_ID default null on conversion error)
                  );
                  if :P15_ENTITY = 'CUSTOMER' then
                    for r in (select * from xxcr_stg_customers where stg_cust_id = l_id and project_id = :P0_PROJECT_ID) loop
                      :P15_C_INCLUDE_YN    := r.include_yn;
                      :P15_C_ACTION_CODE   := r.action_code;
                      :P15_C_PARTY_NAME    := r.tgt_party_name;
                      :P15_C_ACCOUNT_NAME  := r.tgt_account_name;
                      :P15_C_TAX_REF       := r.tgt_tax_reference;
                      :P15_C_CUST_CLASS    := r.tgt_customer_class_code;
                      :P15_C_PROFILE_CLASS := r.tgt_profile_class_name;
                      :P15_C_COLLECTOR     := r.tgt_collector_name;
                      :P15_C_PAYMENT_TERM  := r.tgt_payment_term_name;
                      :P15_C_CURRENCY      := r.tgt_credit_currency;
                      :P15_C_OVERALL_LIM   := r.tgt_overall_credit_limit;
                      :P15_C_TRX_LIM       := r.tgt_trx_credit_limit;
                      :P15_C_NOTES         := r.user_notes;
                    end loop;
                  elsif :P15_ENTITY = 'SITE' then
                    for r in (select * from xxcr_stg_sites where stg_site_id = l_id and project_id = :P0_PROJECT_ID) loop
                      :P15_S_INCLUDE_YN  := r.include_yn;
                      :P15_S_COUNTRY     := r.tgt_country;
                      :P15_S_ADDR1       := r.tgt_address1;
                      :P15_S_ADDR2       := r.tgt_address2;
                      :P15_S_CITY        := r.tgt_city;
                      :P15_S_STATE       := r.tgt_state;
                      :P15_S_POSTAL      := r.tgt_postal_code;
                      :P15_S_SALES_CURR  := r.tgt_sales_currency;
                      :P15_S_RPS_HOLD    := r.tgt_rps_hold_flag;
                      :P15_S_THIRD_PARTY := r.tgt_third_party_name;
                      :P15_S_NOTES       := r.user_notes;
                    end loop;
                  elsif :P15_ENTITY = 'SITE_USE' then
                    for r in (select * from xxcr_stg_site_uses where stg_site_use_id = l_id and project_id = :P0_PROJECT_ID) loop
                      :P15_U_INCLUDE_YN    := r.include_yn;
                      :P15_U_PRIMARY_FLAG  := r.tgt_primary_flag;
                      :P15_U_LOCATION      := r.tgt_location_code;
                      :P15_U_PROFILE_CLASS := r.tgt_profile_class_name;
                      :P15_U_COLLECTOR     := r.tgt_collector_name;
                      :P15_U_PAYMENT_TERM  := r.tgt_payment_term_name;
                      :P15_U_CURRENCY      := r.tgt_credit_currency;
                      :P15_U_OVERALL_LIM   := r.tgt_overall_credit_limit;
                      :P15_U_TRX_LIM       := r.tgt_trx_credit_limit;
                      :P15_U_WAREHOUSE     := r.tgt_warehouse_code;
                      :P15_U_ORDER_TYPE    := r.tgt_order_type_name;
                      :P15_U_PRICE_LIST    := r.tgt_price_list_name;
                      :P15_U_TAX_CODE      := r.tgt_tax_code;
                      :P15_U_GL_REC        := r.tgt_gl_rec_concat;
                      :P15_U_GL_REV        := r.tgt_gl_rev_concat;
                      :P15_U_GL_TAX        := r.tgt_gl_tax_concat;
                      :P15_U_TAX_REF       := r.tgt_tax_reference;
                      :P15_U_GENIE_REP     := r.tgt_awp_genie_rep;
                      :P15_U_SHIP_VIA      := r.tgt_ship_via;
                      :P15_U_SEND_STMTS    := r.tgt_send_statements;
                      :P15_U_STMT_CYCLE    := r.tgt_statement_cycle_name;
                      :P15_U_AUTOCASH      := r.tgt_autocash_rule_name;
                      :P15_U_GROUP_RULE    := r.tgt_grouping_rule_name;
                      :P15_U_NOTES         := r.user_notes;
                    end loop;
                  elsif :P15_ENTITY = 'CONTACT' then
                    for r in (select * from xxcr_stg_contacts where stg_contact_id = l_id and project_id = :P0_PROJECT_ID) loop
                      :P15_T_INCLUDE_YN   := r.include_yn;
                      :P15_T_PRIMARY_FLAG := r.tgt_primary_flag;
                      :P15_T_FIRST_NAME   := r.tgt_first_name;
                      :P15_T_LAST_NAME    := r.tgt_last_name;
                      :P15_T_JOB_TITLE    := r.tgt_job_title;
                      :P15_T_EMAIL        := r.tgt_email_address;
                      :P15_T_PHONE_CC     := r.tgt_phone_country_code;
                      :P15_T_PHONE_AREA   := r.tgt_phone_area_code;
                      :P15_T_PHONE_NUM    := r.tgt_phone_number;
                      :P15_T_MOBILE       := r.tgt_mobile_number;
                      :P15_T_FAX          := r.tgt_fax_number;
                      :P15_T_NOTES        := r.user_notes;
                    end loop;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 60001501
        }
    )

    process save-drawer-record (
        name: Save Validated Record & Cascade
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_id      number := to_number(:P15_ROW_ID default null on conversion error);
                  l_proj_id number := xxcr_security_pkg.resolve_active_project(
                    to_number(:P0_PROJECT_ID default null on conversion error)
                  );
                begin
                  if :P15_ENTITY = 'CUSTOMER' then
                    update xxcr_stg_customers
                       set include_yn               = :P15_C_INCLUDE_YN,
                           action_code              = :P15_C_ACTION_CODE,
                           tgt_party_name           = :P15_C_PARTY_NAME,
                           tgt_account_name         = :P15_C_ACCOUNT_NAME,
                           tgt_tax_reference        = :P15_C_TAX_REF,
                           tgt_customer_class_code  = :P15_C_CUST_CLASS,
                           tgt_profile_class_name   = :P15_C_PROFILE_CLASS,
                           tgt_collector_name       = :P15_C_COLLECTOR,
                           tgt_payment_term_name    = :P15_C_PAYMENT_TERM,
                           tgt_credit_currency      = :P15_C_CURRENCY,
                           tgt_overall_credit_limit = to_number(:P15_C_OVERALL_LIM default null on conversion error),
                           tgt_trx_credit_limit     = to_number(:P15_C_TRX_LIM default null on conversion error),
                           user_notes               = :P15_C_NOTES,
                           updated_at               = systimestamp
                     where stg_cust_id = l_id
                       and project_id  = l_proj_id;
                  elsif :P15_ENTITY = 'SITE' then
                    update xxcr_stg_sites
                       set include_yn           = :P15_S_INCLUDE_YN,
                           tgt_country          = :P15_S_COUNTRY,
                           tgt_address1         = :P15_S_ADDR1,
                           tgt_address2         = :P15_S_ADDR2,
                           tgt_city             = :P15_S_CITY,
                           tgt_state            = :P15_S_STATE,
                           tgt_postal_code      = :P15_S_POSTAL,
                           tgt_sales_currency   = :P15_S_SALES_CURR,
                           tgt_rps_hold_flag    = :P15_S_RPS_HOLD,
                           tgt_third_party_name = :P15_S_THIRD_PARTY,
                           user_notes           = :P15_S_NOTES,
                           updated_at           = systimestamp
                     where stg_site_id = l_id
                       and project_id  = l_proj_id;
                  elsif :P15_ENTITY = 'SITE_USE' then
                    update xxcr_stg_site_uses
                       set include_yn               = :P15_U_INCLUDE_YN,
                           tgt_primary_flag         = :P15_U_PRIMARY_FLAG,
                           tgt_location_code        = :P15_U_LOCATION,
                           tgt_profile_class_name   = :P15_U_PROFILE_CLASS,
                           tgt_collector_name       = :P15_U_COLLECTOR,
                           tgt_payment_term_name    = :P15_U_PAYMENT_TERM,
                           tgt_credit_currency      = :P15_U_CURRENCY,
                           tgt_overall_credit_limit = to_number(:P15_U_OVERALL_LIM default null on conversion error),
                           tgt_trx_credit_limit     = to_number(:P15_U_TRX_LIM default null on conversion error),
                           tgt_warehouse_code       = :P15_U_WAREHOUSE,
                           tgt_order_type_name      = :P15_U_ORDER_TYPE,
                           tgt_price_list_name      = :P15_U_PRICE_LIST,
                           tgt_tax_code             = :P15_U_TAX_CODE,
                           tgt_gl_rec_concat        = :P15_U_GL_REC,
                           tgt_gl_rev_concat        = :P15_U_GL_REV,
                           tgt_gl_tax_concat        = :P15_U_GL_TAX,
                           tgt_tax_reference        = :P15_U_TAX_REF,
                           tgt_awp_genie_rep    = :P15_U_GENIE_REP,
                           tgt_ship_via             = :P15_U_SHIP_VIA,
                           tgt_send_statements      = :P15_U_SEND_STMTS,
                           tgt_statement_cycle_name = :P15_U_STMT_CYCLE,
                           tgt_autocash_rule_name   = :P15_U_AUTOCASH,
                           tgt_grouping_rule_name   = :P15_U_GROUP_RULE,
                           user_notes               = :P15_U_NOTES,
                           updated_at               = systimestamp
                     where stg_site_use_id = l_id
                       and project_id      = l_proj_id;
                  elsif :P15_ENTITY = 'CONTACT' then
                    update xxcr_stg_contacts
                       set include_yn             = :P15_T_INCLUDE_YN,
                           tgt_primary_flag       = :P15_T_PRIMARY_FLAG,
                           tgt_first_name         = :P15_T_FIRST_NAME,
                           tgt_last_name          = :P15_T_LAST_NAME,
                           tgt_job_title          = :P15_T_JOB_TITLE,
                           tgt_email_address      = :P15_T_EMAIL,
                           tgt_phone_country_code = :P15_T_PHONE_CC,
                           tgt_phone_area_code    = :P15_T_PHONE_AREA,
                           tgt_phone_number       = :P15_T_PHONE_NUM,
                           tgt_mobile_number      = :P15_T_MOBILE,
                           tgt_fax_number         = :P15_T_FAX,
                           user_notes             = :P15_T_NOTES,
                           updated_at             = systimestamp
                     where stg_contact_id = l_id
                       and project_id     = l_proj_id;
                  end if;
                
                  xxcr_rollout_pkg.cascade_exclusions(l_proj_id);
                  xxcr_rollout_pkg.sync_deltas(l_proj_id);
                  xxcr_rollout_pkg.find_duplicates(l_proj_id);
                  xxcr_rollout_pkg.validate_project(l_proj_id);
                end;
