        }
    )

    pageItem P80_ACC_USERNAME (
        type: selectList
        label {
            label: Provisioned EBS User
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.user_name
                       || ' (Global: ' || u.role_code
                       || coalesce(
                            (select ' | Overrides: ' || listagg(p.project_code || '=' || pa.project_role_code || case when pa.enabled_yn = 'N' then '[OFF]' end, ', ')
                                      within group (order by p.project_id)
                               from xxcr_project_access pa
                               join xxcr_projects p on p.project_id = pa.project_id
                              where pa.user_name = u.user_name
                             having count(*) > 0),
                            case when u.all_projects_yn = 'N' then ' | Assigned Projects Only' else ' | All Projects' end
                          )
                       || ')' as d,
                       u.user_name as r
                  from xxcr_app_users u
                 order by u.user_name
                ```
            displayExtraValues: false
            nullDisplayValue: — Select EBS User —
        }
        layout {
            sequence: 20
            region: @proj-acc-form-reg
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

