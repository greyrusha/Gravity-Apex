    region user-form-reg (
        name: Provision or Update Oracle EBS User
        title: Provision or Update Oracle EBS User & Global SoD Role
        type: staticContent
        source {
            htmlCode: <p style="margin:0 0 .75rem;color:var(--ut-component-text-muted-color);font-size:.9rem;">Users sign in on Page 9999 with their live <strong>Oracle EBS username &amp; password</strong> (verified over HTTPS against EBS <span style="font-family:Consolas,monospace;">/OA_HTML/RF.jsp?function_id=mLogin</span>). Leave Full Name / Email blank to auto-populate from <span style="font-family:Consolas,monospace;">FND_USER@ADG</span> when available.</p>
        }
        layout {
            sequence: 10
            parentRegion: @tab-users
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region users-ig (
        name: Provisioned Oracle EBS Users (XXCR_APP_USERS)
        title: Provisioned Oracle EBS Users & Global SoD Roles
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.user_name,
                       u.full_name,
                       u.email_address,
                       u.role_code,
                       xxcr_security_pkg.role_label(u.role_code) as role_display,
                       u.all_projects_yn,
                       coalesce(
                         (select listagg(p.project_code || ': ' || xxcr_security_pkg.role_label(pa.project_role_code)
                                   || case when pa.enabled_yn = 'N' then ' [REVOKED]' end, ' | ')
                                   within group (order by p.project_id)
                            from xxcr_project_access pa
                            join xxcr_projects p on p.project_id = pa.project_id
                           where pa.user_name = u.user_name),
                         case when u.all_projects_yn = 'Y' then 'Inherits Global Role on All Projects' else 'None (No Project Access Yet)' end
                       ) as project_override_summary,
                       u.notes,
                       u.enabled_yn,
                       u.updated_by,
                       to_char(u.updated_at, 'YYYY-MM-DD HH24:MI') as updated_at_fmt
                  from xxcr_app_users u
                 order by decode(u.role_code, 'ROLLOUT_ADMIN', 1, 'FINANCE_APPROVER', 2, 'DATA_STEWARD', 3, 4), u.user_name
                ```
        }
        layout {
            sequence: 20
            parentRegion: @tab-users
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
