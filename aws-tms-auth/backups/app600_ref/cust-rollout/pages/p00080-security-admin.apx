        }
        lov {
            type: staticValues
            staticValues: STATIC:Data Steward — Maker;DATA_STEWARD,Finance Approver — Checker;FINANCE_APPROVER,Read-Only Viewer;VIEWER,Rollout Administrator;ROLLOUT_ADMIN
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @proj-acc-form-reg
