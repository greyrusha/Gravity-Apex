page 80 (
    name: Security, Roles & SoD
    alias: SECURITY-ADMIN
    title: 5. Security, EBS Users & Segregation of Duties (SoD)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @rollout-admin
    }

    region audit-ig (
        name: EBS Authentication & SoD Security Audit Log (XXCR_ACCESS_AUDIT)
        title: EBS Login, Role Provisioning, Project Creation & Finance Sign-Off Audit Trail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.audit_id,
                       to_char(a.event_ts, 'YYYY-MM-DD HH24:MI:SS') as event_time,
                       a.actor,
                       a.event_code,
                       a.subject_user,
                       p.project_code,
                       a.details
                  from xxcr_access_audit a
                  left join xxcr_projects p on p.project_id = a.project_id
                 order by a.audit_id desc
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tab-audit
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        enableUsersTo {
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 60008005
        }

        savedReport 60008006 (
            visibility: primary
            view {
                default: grid
                rowsPerPage: 25
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @AUDIT_ID
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @EVENT_TIME
                layout {
                    sequence: 20
                }
            )

            displayColumn (
                column: @EVENT_CODE
                layout {
                    sequence: 30
                }
            )

            displayColumn (
                column: @ACTOR
                layout {
                    sequence: 40
                }
            )

            displayColumn (
                column: @SUBJECT_USER
                layout {
                    sequence: 50
                }
            )

            displayColumn (
                column: @PROJECT_CODE
                layout {
                    sequence: 60
                }
            )

            displayColumn (
                column: @DETAILS
                layout {
                    sequence: 70
                }
            )

        )

        column ACTOR (
            type: displayOnly
            heading {
                heading: Actor (EBS User)
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ACTOR
                dataType: varchar2
            }
        )

        column AUDIT_ID (
            type: displayOnly
            heading {
                heading: Audit ID
            }
            layout {
                sequence: 10
            }
            source {
                databaseColumn: AUDIT_ID
                dataType: number
                primaryKey: true
            }
        )

        column DETAILS (
            type: displayOnly
            heading {
                heading: Event Details
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: DETAILS
                dataType: varchar2
            }
        )

        column EVENT_CODE (
            type: displayOnly
            heading {
                heading: Event Code
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: EVENT_CODE
                dataType: varchar2
            }
        )

        column EVENT_TIME (
            type: displayOnly
            heading {
                heading: Timestamp
            }
            layout {
                sequence: 20
            }
            source {
                databaseColumn: EVENT_TIME
                dataType: varchar2
            }
        )

        column PROJECT_CODE (
            type: displayOnly
            heading {
                heading: Project
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: PROJECT_CODE
                dataType: varchar2
            }
        )

        column SUBJECT_USER (
            type: displayOnly
            heading {
                heading: Target User
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: SUBJECT_USER
                dataType: varchar2
            }
        )

    )

    region origin-form-reg (
        name: Oracle EBS HTTPS Authentication Endpoint Configuration
        title: Oracle EBS HTTPS Authentication Endpoint (Borrowed from App 500 Pattern)
        type: staticContent
        source {
            htmlCode: <p style="margin:0 0 .75rem;color:var(--ut-component-text-muted-color);font-size:.9rem;">App 600 verifies EBS credentials via an outbound HTTPS Basic Auth call to <span style="font-family:Consolas,monospace;">&lt;EBS_ORIGIN&gt;/OA_HTML/RF.jsp?function_id=mLogin</span>, verifies HTTP 200 + matching <span style="font-family:Consolas,monospace;">userName</span> + non-<span style="font-family:Consolas,monospace;">-1</span> access token, and <strong>immediately terminates</strong> the remote EBS session via <span style="font-family:Consolas,monospace;">function_id=mLogout</span>. Zero passwords or EBS cookies are ever stored in APEX.</p>
        }
        layout {
            sequence: 10
            parentRegion: @tab-sod-matrix
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region proj-acc-form-reg (
        name: Assign Per-Project Role Override (Source OU Isolation)
        title: Assign Per-Project Role Override (Multi-OU Segregation of Duties)
        type: staticContent
        source {
            htmlCode:
                ```html
                <p style="margin:0 0 .75rem;color:var(--ut-component-text-muted-color);font-size:.9rem;">Grant a user access to a specific Source OU conversion project (when <span style="font-family:Consolas,monospace;">All Projects = N</span>), or override their global role on a specific project &mdash; for example, a user can be <strong>DATA_STEWARD</strong> on Australia OU 14474 and <strong>VIEWER</strong> (or <strong>Revoked</strong>) on another region's conversion project. <strong>Scope Note:</strong> Per-project role overrides on Tab 2 govern all capabilities inside that Conversion Project (Extract from @ADG, Target OU/BSV, Bulk Remap, Data Editing, and Warning Sign-Off), whereas <strong>Global SoD Role = ROLLOUT_ADMIN</strong> on Tab 1 additionally grants app-wide User/Security Administration (Page 80) and New Project Creation.</p>
                <script>
                document.addEventListener('DOMContentLoaded', function() {
                  var p = document.getElementById('P80_ACC_PROJECT_ID');
                  var u = document.getElementById('P80_ACC_USERNAME');
                  function reloadAcc() {
                    if (p && u && p.value && u.value) {
                      apex.submit({ request: 'LOAD_PROJ_ACC', showWait: true });
                    }
                  }
                  if (p && !p.dataset.xxcrBound) { p.dataset.xxcrBound = 'Y'; p.addEventListener('change', reloadAcc); }
                  if (u && !u.dataset.xxcrBound) { u.dataset.xxcrBound = 'Y'; u.addEventListener('change', reloadAcc); }
                });
                </script>
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tab-proj-access
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region proj-access-ig (
        name: Per-Project Role Assignments & Overrides (XXCR_PROJECT_ACCESS)
        title: Per-Project Role Assignments & Overrides
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pa.access_id,
                       pa.project_id,
                       p.project_code,
                       p.src_ou_name || ' (' || p.src_org_id || ')' as source_ou,
                       pa.user_name,
                       xxcr_security_pkg.role_label(pa.project_role_code) as project_role_display,
                       pa.enabled_yn,
                       pa.notes,
                       pa.updated_by,
                       to_char(pa.updated_at, 'YYYY-MM-DD HH24:MI') as updated_at_fmt
                  from xxcr_project_access pa
                  join xxcr_projects p on p.project_id = pa.project_id
                 order by p.project_id, pa.user_name
                ```
        }
        layout {
            sequence: 20
            parentRegion: @tab-proj-access
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
