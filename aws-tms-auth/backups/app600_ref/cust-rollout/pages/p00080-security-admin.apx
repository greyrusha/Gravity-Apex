    region sod-matrix-html (
        name: Segregation of Duties (Maker-Checker) Governance Matrix
        title: Segregation of Duties (Maker-Checker) Governance Matrix
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                  .sod-tbl { width:100%; border-collapse:collapse; font-size:13.5px; }
                  .sod-tbl th { background:#1b365d; color:#fff; padding:9px 12px; text-align:left; border:1px solid #1b365d; }
                  .sod-tbl td { padding:8px 12px; border:1px solid #dfe3e8; vertical-align:middle; }
                  .sod-tbl tr:nth-child(even) td { background:#f9fafb; }
                  .sod-yes { display:inline-block; padding:2px 8px; border-radius:10px; background:#e6f4ea; color:#137333; font-weight:700; font-size:12px; }
                  .sod-no  { display:inline-block; padding:2px 8px; border-radius:10px; background:#fce8e6; color:#a50e0e; font-weight:700; font-size:12px; }
                </style>
                <table class="sod-tbl">
                  <thead>
                    <tr>
                      <th style="width:34%">Workbench Capability / Control Point</th>
                      <th style="width:16%">ROLLOUT_ADMIN<br><small>(IT / Conv Lead)</small></th>
                      <th style="width:17%">DATA_STEWARD<br><small>(Maker — AR / OM)</small></th>
                      <th style="width:17%">FINANCE_APPROVER<br><small>(Checker — Finance)</small></th>
                      <th style="width:16%">VIEWER<br><small>(Audit / Business)</small></th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><strong>Switch &amp; View Authorized Conversion Projects</strong> (Page 0 / All Pages)</td>
                      <td><span class="sod-yes">ALLOWED (All)</span></td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                    </tr>
                    <tr>
                      <td><strong>Download Connected 8-Tab Excel Workbook (.xlsx)</strong> (Pages 1, 10, 90)</td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                    </tr>
                    <tr>
                      <td><strong>Create New Conversion Project (Another Source OU)</strong> (Page 1)</td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                    </tr>
                    <tr>
                      <td><strong>Execute Fresh @ADG Extract (Rebuilds Project Staging)</strong> (Page 1)</td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                    </tr>
                    <tr>
                      <td><strong>Edit Customers, Credit Limits, Addresses, Site Uses &amp; Contacts Inline</strong> (Page 10)</td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                      <td><span class="sod-yes">ALLOWED (Maker)</span></td>
                      <td><span class="sod-no">BLOCKED (SoD)</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                    </tr>
                    <tr>
                      <td><strong>Upload Modified Connected 8-Tab Excel Workbook (.xlsx)</strong> (Page 10 Tab 8)</td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                      <td><span class="sod-yes">ALLOWED (Maker)</span></td>
                      <td><span class="sod-no">BLOCKED (SoD)</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                    </tr>
                    <tr>
                      <td><strong>Run Duplicate Scan, Auto-Exclude Dormant Dups &amp; Resolve Duplicates</strong> (Page 40)</td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                      <td><span class="sod-yes">ALLOWED (Maker)</span></td>
                      <td><span class="sod-no">BLOCKED (SoD)</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                    </tr>
                    <tr>
                      <td><strong>Set / Bind Target OU &amp; Target BSV Scope &amp; Bulk GL Remap</strong> (Page 1)</td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                      <td><span class="sod-no">BLOCKED (SoD)</span></td>
                      <td><span class="sod-yes">ALLOWED (Checker)</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                    </tr>
                    <tr>
                      <td><strong>Sign Off / Acknowledge Amber Validation Warnings (ACK_YN = Y)</strong> (Page 50)</td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                      <td><span class="sod-no">BLOCKED (SoD)</span></td>
                      <td><span class="sod-yes">ALLOWED (Checker)</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                    </tr>
                    <tr>
                      <td><strong>Provision EBS Users, Assign SoD Roles &amp; Configure EBS Origin</strong> (Page 80)</td>
                      <td><span class="sod-yes">ALLOWED</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                      <td><span class="sod-no">BLOCKED</span></td>
                    </tr>
                  </tbody>
                </table>
                ```
        }
        layout {
            sequence: 20
            parentRegion: @tab-sod-matrix
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

