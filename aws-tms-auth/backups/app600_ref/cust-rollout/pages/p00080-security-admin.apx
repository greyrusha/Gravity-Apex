    pageItem P80_ACC_PROJECT_ID (
        type: selectList
        label {
            label: Conversion Project (Source OU)
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.project_code || ' — ' || nvl(p.src_ou_name, 'OU ' || p.src_org_id) || ' (' || p.src_org_id || ')' as d,
                       p.project_id as r
                  from xxcr_projects p
                 order by p.project_id
                ```
            displayExtraValues: false
            nullDisplayValue: — Select Project —
        }
        layout {
            sequence: 10
            region: @proj-acc-form-reg
            slot: regionBody
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P80_ACC_ROLE_CODE (
        type: selectList
