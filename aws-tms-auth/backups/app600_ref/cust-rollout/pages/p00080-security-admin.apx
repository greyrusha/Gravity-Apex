    process load-origin-defaults (
        name: Load EBS Authentication Origin Config
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  for r in (
                    select ebs_origin, enabled_yn
                      from xxcr_sec_config
                     where application_id = 600
                  ) loop
                    :P80_EBS_ORIGIN   := r.ebs_origin;
                    :P80_AUTH_ENABLED := r.enabled_yn;
                  end loop;
                
                  if trim(:P80_USERNAME) is not null then
                    for u in (
                      select user_name, role_code, all_projects_yn, enabled_yn, full_name, email_address, notes
                        from xxcr_app_users
                       where user_name = upper(trim(:P80_USERNAME))
                    ) loop
                      :P80_USERNAME        := u.user_name;
                      :P80_ROLE_CODE       := u.role_code;
                      :P80_ALL_PROJECTS_YN := u.all_projects_yn;
                      :P80_ENABLED_YN      := u.enabled_yn;
                      :P80_FULL_NAME       := u.full_name;
                      :P80_EMAIL           := u.email_address;
                      :P80_NOTES           := u.notes;
                    end loop;
                  end if;
                
                  if trim(:P80_ACC_PROJECT_ID) is null then
                    :P80_ACC_PROJECT_ID := xxcr_security_pkg.resolve_active_project(
                      to_number(:P0_PROJECT_ID default null on conversion error)
                    );
                  end if;
                
                  if trim(:P80_ACC_PROJECT_ID) is not null and trim(:P80_ACC_USERNAME) is not null then
                    declare
                      l_found boolean := false;
                    begin
                      for pa in (
                        select project_role_code, enabled_yn, notes
                          from xxcr_project_access
                         where project_id = to_number(:P80_ACC_PROJECT_ID default null on conversion error)
                           and user_name  = upper(trim(:P80_ACC_USERNAME))
                      ) loop
                        :P80_ACC_ROLE_CODE  := pa.project_role_code;
                        :P80_ACC_ENABLED_YN := pa.enabled_yn;
                        :P80_ACC_NOTES      := pa.notes;
                        l_found := true;
                      end loop;
                      if not l_found then
                        for u in (
                          select role_code
                            from xxcr_app_users
                           where user_name = upper(trim(:P80_ACC_USERNAME))
                        ) loop
                          :P80_ACC_ROLE_CODE  := u.role_code;
                          :P80_ACC_ENABLED_YN := 'Y';
                          :P80_ACC_NOTES      := null;
                        end loop;
                      end if;
                    end;
                  end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 60008010
        }
    )

    process save-ebs-origin-proc (
        name: Save EBS HTTPS Authentication Origin
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  xxcr_security_pkg.save_ebs_origin(
                    p_ebs_origin => :P80_EBS_ORIGIN,
                    p_enabled_yn => :P80_AUTH_ENABLED
                  );
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Oracle EBS HTTPS authentication origin updated!
        }
        advanced {
            executionMappingIdentifier: 60008013
        }
        serverSideCondition {
            whenButtonPressed: @btn-save-origin
        }
        security {
            authorizationScheme: @rollout-admin
        }
    )

    process save-ebs-user-proc (
        name: Provision or Update EBS User
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  xxcr_security_pkg.save_user(
                    p_username        => :P80_USERNAME,
                    p_role_code       => :P80_ROLE_CODE,
                    p_all_projects_yn => :P80_ALL_PROJECTS_YN,
                    p_enabled_yn      => :P80_ENABLED_YN,
                    p_full_name       => :P80_FULL_NAME,
                    p_email_address   => :P80_EMAIL,
                    p_notes           => :P80_NOTES
                  );
                  :P80_USERNAME  := null;
                  :P80_FULL_NAME := null;
                  :P80_EMAIL     := null;
                  :P80_NOTES     := null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Oracle EBS user and Global Segregation of Duties role saved!
        }
        advanced {
            executionMappingIdentifier: 60008011
        }
        serverSideCondition {
            whenButtonPressed: @btn-save-user
        }
        security {
            authorizationScheme: @rollout-admin
        }
    )

    process save-proj-access-proc (
        name: Save Per-Project Role Override
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  xxcr_security_pkg.save_project_access(
                    p_project_id        => :P80_ACC_PROJECT_ID,
                    p_username          => :P80_ACC_USERNAME,
                    p_project_role_code => :P80_ACC_ROLE_CODE,
                    p_enabled_yn        => :P80_ACC_ENABLED_YN,
                    p_notes             => :P80_ACC_NOTES
                  );
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Per-project role assignment saved!
        }
        advanced {
            executionMappingIdentifier: 60008012
        }
        serverSideCondition {
            whenButtonPressed: @btn-save-proj-acc
        }
        security {
            authorizationScheme: @rollout-admin
        }
    )

)

