    region sec-hero (
        name: EBS Authentication & Segregation of Duties Administration
        title: 5. EBS Credentials, Multi-Project Access & Segregation of Duties (SoD)
        type: staticContent
        source {
            htmlCode: Manage Oracle EBS user provisioning, Maker-Checker Segregation of Duties roles (ROLLOUT_ADMIN, FINANCE_APPROVER, DATA_STEWARD, VIEWER), per-project Source OU access overrides, EBS HTTPS authentication origin, and login/audit history.
        }
