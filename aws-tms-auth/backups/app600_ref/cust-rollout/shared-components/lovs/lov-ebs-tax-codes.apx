lov lov-ebs-tax-codes (
    name: EBS_TAX_CODES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select display_value, return_value
              from xxcr_ebs_ref_lovs
             where domain_code = 'TAX_CODE'
               and active_yn = 'Y'
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
        defaultSort: DISPLAY_VALUE
    }
)

