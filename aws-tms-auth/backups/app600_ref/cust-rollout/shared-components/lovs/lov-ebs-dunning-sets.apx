lov lov-ebs-dunning-sets (
    name: EBS_DUNNING_SETS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select display_value, return_value
              from xxcr_ebs_ref_lovs
             where domain_code = 'DUNNING_SET'
               and active_yn = 'Y'
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
        defaultSort: DISPLAY_VALUE
    }
)

