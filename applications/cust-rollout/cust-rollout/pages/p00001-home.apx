    process create-new-project-proc (
        name: Create Concurrent Conversion Project & Switch Context
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_new_id number;
                begin
                  xxcr_rollout_pkg.create_project(
                    p_project_code   => :P1_NEW_PROJ_CODE,
                    p_project_name   => :P1_NEW_PROJ_NAME,
                    p_src_org_id     => :P1_NEW_SRC_ORG_ID,
                    p_tgt_org_id     => :P1_NEW_TGT_ORG_ID,
                    p_tgt_bsv        => :P1_NEW_TGT_BSV,
                    p_awp_seg7_re    => nvl(trim(:P1_NEW_SEG7_RE), '^1[0-9]{3}$'),
                    p_active_months  => 24,
                    p_new_project_id => l_new_id
                  );
                  :P0_PROJECT_ID   := l_new_id;
                  :P1_PROJECT_ID   := l_new_id;
                  :P1_NEW_PROJ_CODE := null;
                  :P1_NEW_PROJ_NAME := null;
                  :P1_NEW_TGT_BSV   := null;
                end;
                ```
        }
        execution {
            sequence: 3
        }
        successMessage {
            successMessage: New concurrent Conversion Project created and selected as your Active Project! Click "Extract Customers from @ADG" whenever you are ready to stage its Source OU data.
        }
        advanced {
            executionMappingIdentifier: 60000115
        }
        serverSideCondition {
            whenButtonPressed: @btn-create-project
        }
        security {
            authorizationScheme: @rollout-admin
        }
    )

    process init-project-defaults (
        name: Initialize Active Project Context & Form Values
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_seed_id   number;
                  l_active_id number;
                begin
                  xxcr_rollout_pkg.seed_default_project(l_seed_id);
                  l_active_id := xxcr_security_pkg.resolve_active_project(
                    to_number(:P0_PROJECT_ID default null on conversion error)
                  );
                  :P0_PROJECT_ID := l_active_id;
                  :P1_PROJECT_ID := l_active_id;
                
                  for r in (
                    select src_org_id, tgt_org_id, tgt_bsv, filter_awp_seg7_re,
                           filter_active_months, filter_cust_name_like, max_customers
                      from xxcr_projects
                     where project_id = l_active_id
                  ) loop
                    :P1_SRC_ORG_ID    := r.src_org_id;
                    :P1_TGT_ORG_ID    := r.tgt_org_id;
                    :P1_TGT_BSV       := r.tgt_bsv;
                    :P1_AWP_SEG7_RE   := nvl(r.filter_awp_seg7_re, '^1[0-9]{3}$');
                    :P1_ACTIVE_MONTHS := r.filter_active_months;
                    :P1_NAME_FILTER   := r.filter_cust_name_like;
                    :P1_MAX_CUSTOMERS := r.max_customers;
                  end loop;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 60000111
        }
    )

    process run-adg-extract (
        name: Save Scope & Extract Customers from @ADG
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_proj_id number := xxcr_security_pkg.resolve_active_project(
                    to_number(:P0_PROJECT_ID default null on conversion error)
                  );
                begin
                  update xxcr_projects
                     set src_org_id            = :P1_SRC_ORG_ID,
                         tgt_org_id            = :P1_TGT_ORG_ID,
                         tgt_bsv               = trim(:P1_TGT_BSV),
                         filter_awp_seg7_re    = nvl(trim(:P1_AWP_SEG7_RE), '^1[0-9]{3}$'),
                         filter_active_months  = nvl(:P1_ACTIVE_MONTHS, 24),
                         filter_cust_name_like = trim(:P1_NAME_FILTER),
                         max_customers         = :P1_MAX_CUSTOMERS
                   where project_id = l_proj_id;
                
                  xxcr_rollout_pkg.refresh_ebs_ref_lovs;
                  xxcr_rollout_pkg.extract_project_data(l_proj_id);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Customers, Addresses, Site Uses, GL Accounts, and Contacts extracted from @ADG (using DRIVING_SITE) for active project, deduplicated, and validated!
        }
        advanced {
            executionMappingIdentifier: 60000112
        }
        serverSideCondition {
            whenButtonPressed: @btn-extract-adg
        }
        security {
            authorizationScheme: @can-admin-project
        }
    )

    process run-bulk-manipulation (
        name: Apply Bulk Manipulation to Staging Rows
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_proj_id number := xxcr_security_pkg.resolve_active_project(
                    to_number(:P0_PROJECT_ID default null on conversion error)
                  );
                begin
                  xxcr_rollout_pkg.bulk_manipulate_data(
                    p_project_id     => l_proj_id,
                    p_new_bsv        => :P1_BULK_BSV,
                    p_payment_term   => :P1_BULK_PAYMENT_TERM,
                    p_warehouse_code => :P1_BULK_WAREHOUSE,
                    p_order_type     => :P1_BULK_ORDER_TYPE,
                    p_only_included  => 'Y'
                  );
                  if trim(:P1_BULK_BSV) is not null then
                    :P1_TGT_BSV := trim(:P1_BULK_BSV);
                  end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Bulk data manipulation applied to active project staging tables, deltas recorded, and validation refreshed!
        }
        advanced {
            executionMappingIdentifier: 60000113
        }
        serverSideCondition {
            whenButtonPressed: @btn-apply-bulk
        }
        security {
            authorizationScheme: @can-approve-finance
        }
    )

    process save-target-scope-only (
        name: Update Target OU & Target BSV Without Re-Extracting
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_proj_id number := xxcr_security_pkg.resolve_active_project(
                    to_number(:P0_PROJECT_ID default null on conversion error)
                  );
                begin
                  xxcr_rollout_pkg.update_target_scope(
                    p_project_id => l_proj_id,
                    p_tgt_org_id => :P1_TGT_ORG_ID,
                    p_tgt_bsv    => :P1_TGT_BSV
                  );
                end;
                ```
        }
        execution {
            sequence: 5
        }
        successMessage {
            successMessage: Target OU and Target BSV scope updated (empty/TBD values allowed) and staged GL accounts & validation refreshed without re-extracting!
        }
        advanced {
            executionMappingIdentifier: 60000114
        }
        serverSideCondition {
            whenButtonPressed: @btn-save-target-scope
        }
        security {
            authorizationScheme: @can-approve-finance
        }
    )

)

