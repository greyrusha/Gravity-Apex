page 1 (
    name: Scope, Extract & Remap
    alias: HOME
    title: 1. Scope, Extract & Remap — EBS Customer OU Rollout Workbench
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region app-hero (
        name: EBS Customer OU Rollout Workbench
        title: EBS Customer OU Rollout Workbench (@ADG -> Target LE / Ledger / OU)
        type: staticContent
        source {
            htmlCode: Extract Customer Accounts, Addresses/Sites, Site Uses, GL Accounts, and Contacts over @ADG (using DRIVING_SITE), manipulate in APEX or Excel, deduplicate, and validate for the new Operating Unit.
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region bulk-manipulate (
        name: Step 2: Bulk Data Manipulation & Target OU Remapping
        title: Step 2: Bulk Data Manipulation Across Extracted Staging Records
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region create-project-reg (
        name: Create Concurrent Conversion Project (Add Another Source OU)
        title: + Add Concurrent Conversion Project (Extract Another Source Operating Unit)
        type: staticContent
        source {
            htmlCode: <p style="margin:0 0 .75rem;color:var(--ut-component-text-muted-color);font-size:.9rem;">Run multiple Customer OU conversions simultaneously (e.g., keep <strong>AU_AWP_17001_ROLLOUT</strong> active while adding another Source OU). Each project maintains isolated staging tables, duplicate clusters, validation queues, Connected 8-Tab Excel workbooks, and per-project SoD access.</p>
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
            icon: fa-plus-circle
        }
        security {
            authorizationScheme: @rollout-admin
        }
    )

    region extract-config (
        name: Step 1: Extract Scope & Target OU Configuration (@ADG DRIVING_SITE)
        title: Step 1: Configure Source/Target OU & Extract Customers from @ADG
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region kpi-summary (
        name: Concurrent Conversion Projects & Staging KPI Summary
        title: All Authorized Conversion Projects & Local Staging Summary (Active Project Marked ★)
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.project_id,
                       case when p.project_id = :P0_PROJECT_ID then '★ ' || p.project_code || ' (ACTIVE)' else p.project_code end as project_code,
                       p.src_ou_name || ' (' || p.src_org_id || ')' as source_operating_unit,
                       nvl(p.tgt_legal_entity_name, 'TBD (Not Set)') as target_legal_entity,
                       case when p.tgt_ledger_name is not null then p.tgt_ledger_name || ' (' || p.tgt_currency_code || ')' else 'TBD (Not Set)' end as target_ledger,
                       case when p.tgt_org_id is not null then p.tgt_ou_name || ' (' || p.tgt_org_id || ')' else 'TBD (Not Yet Set Up in EBS)' end as target_operating_unit,
                       nvl(p.tgt_bsv, 'TBD (Unmapped)') as target_bsv,
                       (select count(*) from xxcr_stg_customers c where c.project_id = p.project_id and c.include_yn = 'Y') as included_customers,
                       (select count(*) from xxcr_stg_sites s where s.project_id = p.project_id and s.include_yn = 'Y') as included_sites,
                       (select count(*) from xxcr_stg_site_uses su where su.project_id = p.project_id and su.include_yn = 'Y') as included_site_uses,
                       (select count(*) from xxcr_stg_contacts ct where ct.project_id = p.project_id and ct.include_yn = 'Y') as included_contacts,
                       (select count(*) from xxcr_stg_sites s where s.project_id = p.project_id and s.modified_yn = 'Y') +
                       (select count(*) from xxcr_stg_site_uses su where su.project_id = p.project_id and su.modified_yn = 'Y') as modified_records,
                       (select count(*) from xxcr_duplicates d where d.project_id = p.project_id and d.resolution_action = 'OPEN') as open_duplicates,
                       (select count(*) from xxcr_val_errors e where e.project_id = p.project_id and e.severity = 'ERROR') as val_errors,
                       (select count(*) from xxcr_val_errors e where e.project_id = p.project_id and e.severity = 'WARNING' and e.ack_yn = 'N') as val_warnings
                  from xxcr_projects p
                 where xxcr_security_pkg.effective_role(p.project_id, :APP_USER) is not null
                 order by case when p.project_id = :P0_PROJECT_ID then 0 else 1 end, p.project_id
                ```
            pageItemsToSubmit: P0_PROJECT_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchField
                actionsMenu
                resetButton
            ]
        }
        enableUsersTo {
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 60000101
        }

