lov lov-ebs-receipt-methods (
    name: EBS_RECEIPT_METHODS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select display_value, return_value
              from xxcr_ebs_ref_lovs
             where domain_code = 'RECEIPT_METHOD'
               and active_yn = 'Y'
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
        defaultSort: DISPLAY_VALUE
    }
)

