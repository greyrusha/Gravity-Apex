lov lov-ebs-customer-classes (
    name: EBS_CUSTOMER_CLASSES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select display_value, return_value
              from xxcr_ebs_ref_lovs
             where domain_code = 'CUSTOMER_CLASS'
               and active_yn = 'Y'
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
        defaultSort: DISPLAY_VALUE
    }
)

